@using crudcomdb.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar fixed-top shadow-sm navbar-custom">
    <div class="container-fluid px-2 d-flex align-items-center justify-content-between" style="height: 60px;">
        
        <!-- LOGO À ESQUERDA -->
        <a class="navbar-brand d-flex align-items-center m-0 p-0" href="/">
            <img src="/logo-match-pet.png" alt="Match-Pet SP" style="height: 36px; object-fit: contain;" />
        </a>

        <!-- BOTÃO "ENTRAR" OU PERFIL (CENTRALIZADO NO MOBILE) -->
        <div class="d-lg-none d-flex align-items-center justify-content-center flex-grow-1 px-1">
            @if (AuthService.EstaLogado)
            {
                <a href="/perfil" class="btn btn-light btn-sm rounded-pill px-2 py-1 border d-flex align-items-center shadow-sm text-decoration-none" style="max-width: 140px;">
                    @if (!string.IsNullOrEmpty(AuthService.UsuarioLogado?.FotoPerfilBase64))
                    {
                        <img src="@AuthService.UsuarioLogado.FotoPerfilBase64" class="rounded-circle me-1" style="width: 22px; height: 22px; object-fit: cover; flex-shrink: 0;" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle text-primary me-1 fs-6 flex-shrink-0"></i>
                    }
                    <span class="small fw-bold text-dark text-truncate" style="font-size: 0.8rem;">@AuthService.UsuarioLogado?.Nome</span>
                </a>
            }
            else
            {
                <button class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm" @onclick='() => Nav.NavigateTo("/login")' style="font-size: 0.8rem;">
                    Entrar
                </button>
            }
        </div>

        <!-- MENU DESKTOP -->
        <div class="d-none d-lg-flex align-items-center gap-4">
            <ul class="navbar-nav d-flex flex-row align-items-center m-0 p-0" style="gap: 1.5rem;">
                <li class="nav-item"><NavLink class="nav-link nav-link-custom" href="/" Match="NavLinkMatch.All">Início</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link nav-link-custom" href="/pets">Catálogo</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link nav-link-custom text-success fw-bold" href="/ongs">ONGs</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link nav-link-custom text-warning fw-bold" href="/final-feliz">Final Feliz</NavLink></li>
                @if (AuthService.EstaLogado)
                {
                    <li class="nav-item"><NavLink class="nav-link nav-link-custom" href="/meus-pets">Meus Animais</NavLink></li>
                }
            </ul>

            <div class="d-flex align-items-center gap-2">
                <NavLink class="btn btn-outline-primary btn-sm px-3 fw-bold d-flex align-items-center btn-nav-rounded shadow-sm" href="/pets/novo">
                    <i class="bi bi-plus-lg me-1"></i> Cadastrar
                </NavLink>

                @if (AuthService.EstaLogado)
                {
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm rounded-pill px-2 py-1 border d-flex align-items-center dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" style="max-width: 210px;">
                            @if (!string.IsNullOrEmpty(AuthService.UsuarioLogado?.FotoPerfilBase64))
                            {
                                <img src="@AuthService.UsuarioLogado.FotoPerfilBase64" class="rounded-circle me-1" style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle text-primary me-1 fs-5 flex-shrink-0"></i>
                            }
                            <span class="small fw-bold text-dark text-truncate" style="max-width: 130px;" title="@AuthService.UsuarioLogado?.Nome">
                                @AuthService.UsuarioLogado?.Nome
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-4 p-2">
                            <li><a class="dropdown-item rounded-3 fw-bold py-2" href="/perfil"><i class="bi bi-person-gear me-2"></i>Meu Perfil</a></li>
                            <li><a class="dropdown-item rounded-3 fw-bold py-2" href="/meus-pets"><i class="bi bi-collection me-2"></i>Meus Animais</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button class="dropdown-item rounded-3 text-danger fw-bold py-2" @onclick="ExecutarSair"><i class="bi bi-power me-2"></i>Sair</button></li>
                        </ul>
                    </div>
                }
                else
                {
                    <button class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" @onclick='() => Nav.NavigateTo("/login")'>Entrar</button>
                }
            </div>
        </div>

        <!-- BOTÃO HAMBÚRGUER MOBILE (FORÇADO NA BARRA BRANCA, SEM FLUTUAR) -->
        <button class="btn btn-primary rounded-circle d-lg-none d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 38px; height: 38px; border: none;" @onclick="ToggleMenu" type="button" aria-label="Menu">
            <i class="bi @(menuAberto ? "bi-x-lg" : "bi-list") fs-5 text-white"></i>
        </button>

    </div>
</nav>

<!-- MENU LATERAL / OVERLAY MOBILE -->
<div class="menu-overlay @(menuAberto ? "active" : "")" @onclick="ToggleMenu">
    <div class="menu-content shadow-lg" @onclick:stopPropagation="true">
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h5 class="fw-bold text-primary m-0">Menu</h5>
            <button class="btn btn-sm btn-light rounded-circle" @onclick="ToggleMenu"><i class="bi bi-x-lg"></i></button>
        </div>
        <ul class="list-unstyled m-0">
            <li class="mb-3"><a href="/" class="menu-item-overlay" @onclick="ToggleMenu"><i class="bi bi-house-door me-2 text-primary"></i> Início</a></li>
            <li class="mb-3"><a href="/pets" class="menu-item-overlay" @onclick="ToggleMenu"><i class="bi bi-search me-2 text-primary"></i> Catálogo Geral</a></li>
            <li class="mb-3"><a href="/ongs" class="menu-item-overlay text-success fw-bold" @onclick="ToggleMenu"><i class="bi bi-building-check me-2"></i> Área de ONGs</a></li>
            <li class="mb-3"><a href="/final-feliz" class="menu-item-overlay text-warning fw-bold" @onclick="ToggleMenu"><i class="bi bi-stars me-2"></i> Final Feliz</a></li>
            <hr class="my-2">
            @if (AuthService.EstaLogado)
            {
                <li class="mb-2 text-muted small fw-bold px-1">Logado como: @AuthService.UsuarioLogado?.Nome</li>
                <li class="mb-3"><a href="/meus-pets" class="menu-item-overlay fw-bold" @onclick="ToggleMenu"><i class="bi bi-collection me-2 text-primary"></i> Meus Animais</a></li>
                <li class="mb-3"><a href="/perfil" class="menu-item-overlay" @onclick="ToggleMenu"><i class="bi bi-person-vcard me-2 text-primary"></i> Meu Perfil</a></li>
                <li class="mt-3"><button class="btn btn-outline-danger w-100 rounded-pill fw-bold" @onclick="ExecutarSair"><i class="bi bi-power me-1"></i> Sair</button></li>
            }
            else
            {
                <li class="mt-3"><button class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm" @onclick='() => { ToggleMenu(); Nav.NavigateTo("/login"); }'><i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login</button></li>
            }
        </ul>
    </div>
</div>

<style>
    .navbar-custom { background: #ffffff; height: 60px; }

    .nav-link-custom { 
        color: #444746 !important; 
        font-weight: 500; 
        font-size: 0.95rem;
        padding: 0 5px !important;
        text-decoration: none !important;
        white-space: nowrap;
        transition: color 0.2s;
    }

    .nav-link-custom.active { color: #1a73e8 !important; font-weight: 700 !important; }
    .nav-link-custom:hover { color: #1a73e8 !important; }

    .btn-nav-rounded { border-radius: 20px; border-width: 2px; }
    
    /* Overlay do menu lateral deslizante */
    .menu-overlay { 
        position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
        background: rgba(0,0,0,0.5); backdrop-filter: blur(3px); 
        z-index: 2000; opacity: 0; visibility: hidden; transition: all 0.3s ease; 
    }
    .menu-overlay.active { opacity: 1; visibility: visible; }
    
    .menu-content { 
        position: absolute; top: 0; right: 0; width: 280px; height: 100%;
        background: white; padding: 20px; box-shadow: -5px 0 25px rgba(0,0,0,0.15);
        transform: translateX(100%); transition: transform 0.3s ease;
        display: flex; flex-direction: column;
    }
    .menu-overlay.active .menu-content { transform: translateX(0); }
    
    .menu-item-overlay { text-decoration: none; color: #202124; font-weight: 500; display: block; padding: 8px 10px; border-radius: 8px; transition: background 0.2s; }
    .menu-item-overlay:hover { background-color: #f8f9fa; color: #1a73e8; }
</style>

@code {
    private bool menuAberto = false;

    protected override void OnInitialized() => AuthService.OnChage += StateHasChanged;

    private void ToggleMenu() => menuAberto = !menuAberto;
    
    private void ExecutarSair() 
    { 
        menuAberto = false; 
        AuthService.Logout(); 
        Nav.NavigateTo("/", forceLoad: true); 
    }

    public void Dispose() => AuthService.OnChage -= StateHasChanged;
}