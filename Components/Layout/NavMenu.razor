@inject AuthService AuthService
@inject ChatService Chat
@inject SocialService Social
@inject NotificacoesService Avisos
@inject NotificacaoService Notificacoes
@inject NavigationManager Nav
@inject ModeracaoService Moderacao
@inject IJSRuntime JS
@inject ToastService Toast
@implements IDisposable

@* ===== BARRA SUPERIOR ===== *@
<header class="topo">
    <div class="container-xl d-flex align-items-center gap-2 gap-md-3 h-100">
        <a class="marca" href="/" aria-label="Match-Pet SP - Início">
            <img src="/logo-match-pet.png" alt="" />
            <span class="nome-marca">Match-Pet <b>SP</b></span>
        </a>

        <nav class="links d-none d-lg-flex" aria-label="Principal">
            <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="/pets">Adotar</NavLink>
            <NavLink href="/bazar">Bazar</NavLink>
            <NavLink href="/comunidade">Comunidade</NavLink>
            <NavLink href="/ongs" class="d-none d-xl-inline">ONGs</NavLink>
            <NavLink href="/final-feliz" class="d-none d-xl-inline">Final Feliz</NavLink>
            <NavLink href="/estatisticas" class="d-none d-xxl-inline">Estatísticas</NavLink>
        </nav>

        <div class="ms-auto d-flex align-items-center gap-1 gap-md-2">
            <a href="/pets/novo" class="btn btn-accent btn-sm px-3 d-none d-md-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Anunciar
            </a>

            @if (AuthService.UsuarioLogado is { } u)
            {
                @if (u.EhAdmin)
                {
                    <a href="/admin" class="icone-topo d-none d-xl-inline-flex" title="Painel do administrador" aria-label="Painel do administrador @(pendenciasAdmin > 0 ? $"({pendenciasAdmin} pendências)" : "")">
                        <i class="bi bi-shield-check"></i>
                        @if (pendenciasAdmin > 0) { <span class="contador">@pendenciasAdmin</span> }
                    </a>
                }
                <a href="/amigos" class="icone-topo d-none d-md-inline-flex" title="Amigos" aria-label="Amigos @(pedidos > 0 ? $"({pedidos} pedidos)" : "")">
                    <i class="bi bi-people"></i>
                    @if (pedidos > 0) { <span class="contador">@pedidos</span> }
                </a>
                <a href="/mensagens" class="icone-topo" title="Mensagens" aria-label="Mensagens @(naoLidas > 0 ? $"({naoLidas} não lidas)" : "")">
                    <i class="bi bi-chat-dots"></i>
                    @if (naoLidas > 0) { <span class="contador">@(naoLidas > 99 ? "99+" : naoLidas)</span> }
                </a>

                @* Sininho: no celular abre a página, no computador abre um painel *@
                <a href="/notificacoes" class="icone-topo d-lg-none" title="Notificações" aria-label="Notificações @(notificacoes > 0 ? $"({notificacoes} novas)" : "")">
                    <i class="bi bi-bell"></i>
                    @if (notificacoes > 0) { <span class="contador">@(notificacoes > 99 ? "99+" : notificacoes)</span> }
                </a>
                <div class="position-relative d-none d-lg-block">
                    <button type="button" class="icone-topo border-0 bg-transparent @(painelAberto ? "ativo" : "")" title="Notificações" @onclick="AlternarPainel"
                            aria-label="Notificações @(notificacoes > 0 ? $"({notificacoes} novas)" : "")" aria-expanded="@painelAberto">
                        <i class="bi @(painelAberto ? "bi-bell-fill" : "bi-bell")"></i>
                        @if (notificacoes > 0) { <span class="contador">@(notificacoes > 99 ? "99+" : notificacoes)</span> }
                    </button>
                    @if (painelAberto)
                    {
                        <div class="painel-fundo" @onclick="() => painelAberto = false"></div>
                        <div class="painel-notif" role="dialog" aria-label="Notificações">
                            <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
                                <b class="text-dark">Notificações</b>
                                <button class="btn btn-ghost btn-sm py-1" @onclick="MarcarTodasLidas">Marcar como lidas</button>
                            </div>
                            <div class="painel-lista"><ListaNotificacoes Quantidade="12" AoAbrir="() => painelAberto = false" /></div>
                            <a href="/notificacoes" class="d-block text-center small fw-bold py-2 border-top" @onclick="() => painelAberto = false">Ver todas</a>
                        </div>
                    }
                </div>
                <button class="usuario" type="button" @onclick="ToggleMenu" aria-label="Abrir menu da conta" aria-expanded="@menuAberto">
                    <Avatar Usuario="u" Tamanho="34" />
                    <span class="d-none d-xl-inline text-truncate" style="max-width:140px">@PrimeiroNome(u.Nome)</span>
                    <i class="bi bi-chevron-down small d-none d-xl-inline"></i>
                </button>
            }
            else
            {
                <a href="/login" class="btn btn-outline-primary btn-sm px-3"><i class="bi bi-box-arrow-in-right me-1 d-none d-sm-inline"></i>Entrar</a>
                <a href="/cadastro" class="btn btn-primary btn-sm px-3"><span class="d-none d-sm-inline">Criar conta</span><span class="d-sm-none">Cadastrar</span></a>
                @* Em notebooks parte dos links fica no menu lateral *@
                <button type="button" class="icone-topo border-0 bg-transparent d-none d-lg-inline-flex d-xxl-none" @onclick="ToggleMenu" aria-label="Abrir menu"><i class="bi bi-list"></i></button>
            }
        </div>
    </div>
</header>

@* ===== BARRA INFERIOR (CELULAR) ===== *@
<nav class="barra-inferior d-lg-none" aria-label="Navegação rápida">
    <NavLink href="/" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i><span>Início</span></NavLink>
    <NavLink href="/pets"><i class="bi bi-search-heart"></i><span>Adotar</span></NavLink>
    <a href="/pets/novo" class="central" aria-label="Anunciar"><span class="mais"><i class="bi bi-plus-lg"></i></span></a>
    <NavLink href="/comunidade"><i class="bi bi-people"></i><span>Comunidade</span></NavLink>
    <button type="button" @onclick="ToggleMenu" class="@(menuAberto ? "active" : "") position-relative">
        <i class="bi bi-list"></i><span>Menu</span>
        @if (pedidos > 0) { <span class="ponto" aria-label="Novos pedidos de amizade"></span> }
    </button>
</nav>

@* ===== MENU LATERAL (conta e demais páginas) ===== *@
<div class="menu-overlay @(menuAberto ? "active" : "")" @onclick="FecharMenu">
    <aside class="menu-content" @onclick:stopPropagation="true" aria-label="Menu">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="fw-bold text-dark fs-5">Menu</span>
            <button class="btn btn-light btn-icon" @onclick="FecharMenu" aria-label="Fechar menu"><i class="bi bi-x-lg"></i></button>
        </div>

        @if (AuthService.UsuarioLogado is { } usuarioMenu)
        {
            <a href="/u/@usuarioMenu.Id" class="cartao-usuario" @onclick="FecharMenu">
                <Avatar Usuario="usuarioMenu" Tamanho="48" />
                <div class="min-w-0">
                    <div class="fw-bold text-dark text-truncate">@usuarioMenu.Nome</div>
                    <div class="small text-muted">Ver meu perfil público</div>
                </div>
            </a>
        }

        <div class="grupo">Navegar</div>
        <a href="/" class="item" @onclick="FecharMenu"><i class="bi bi-house-door"></i> Início</a>
        <a href="/pets" class="item" @onclick="FecharMenu"><i class="bi bi-search-heart"></i> Adotar um pet</a>
        <a href="/bazar" class="item" @onclick="FecharMenu"><i class="bi bi-gift"></i> Bazar Solidário</a>
        <a href="/comunidade" class="item" @onclick="FecharMenu"><i class="bi bi-people"></i> Comunidade</a>
        <a href="/ongs" class="item" @onclick="FecharMenu"><i class="bi bi-building-check"></i> ONGs parceiras</a>
        <a href="/final-feliz" class="item" @onclick="FecharMenu"><i class="bi bi-stars"></i> Final Feliz</a>
        <a href="/estatisticas" class="item" @onclick="FecharMenu"><i class="bi bi-bar-chart-line"></i> Estatísticas</a>
        <a href="/sobre" class="item" @onclick="FecharMenu"><i class="bi bi-info-circle"></i> Sobre o projeto</a>

        @if (AuthService.UsuarioLogado is { } eu)
        {
            <div class="grupo">Minha conta</div>
            <a href="/mensagens" class="item" @onclick="FecharMenu"><i class="bi bi-chat-dots"></i> Mensagens @if (naoLidas > 0) { <span class="badge bg-primary ms-auto">@naoLidas</span> }</a>
            <a href="/notificacoes" class="item" @onclick="FecharMenu"><i class="bi bi-bell"></i> Notificações @if (notificacoes > 0) { <span class="badge bg-danger ms-auto">@notificacoes</span> }</a>
            <a href="/amigos" class="item" @onclick="FecharMenu"><i class="bi bi-person-heart"></i> Amigos @if (pedidos > 0) { <span class="badge bg-danger ms-auto">@pedidos</span> }</a>
            <a href="/meus-pets" class="item" @onclick="FecharMenu"><i class="bi bi-collection"></i> Meus anúncios</a>
            <a href="/favoritos" class="item" @onclick="FecharMenu"><i class="bi bi-heart"></i> Favoritos</a>
            <a href="/questionario-adocao" class="item" @onclick="FecharMenu"><i class="bi bi-clipboard-heart"></i> Questionário de adoção</a>
            @if (eu.EhAdmin)
            {
                <a href="/admin" class="item item-admin" @onclick="FecharMenu"><i class="bi bi-shield-check"></i> Painel do administrador @if (pendenciasAdmin > 0) { <span class="badge bg-danger ms-auto">@pendenciasAdmin</span> }</a>
            }
            <a href="/perfil" class="item" @onclick="FecharMenu">
                <i class="bi bi-person-gear"></i> Configurações da conta
                @if (eu.StatusValidacaoDocumento != "Aprovado") { <span class="badge bg-warning text-dark ms-auto">verificar</span> }
            </a>
            <div class="grupo">Preferências</div>
            @Preferencias
            <button class="item text-danger mt-2" @onclick="ExecutarSair"><i class="bi bi-box-arrow-right"></i> Sair</button>
        }
        else
        {
            <div class="mt-4 d-grid gap-2">
                <a href="/login" class="btn btn-primary" @onclick="FecharMenu">Entrar</a>
                <a href="/cadastro" class="btn btn-outline-primary" @onclick="FecharMenu">Criar conta grátis</a>
            </div>
            <div class="grupo">Preferências</div>
            @Preferencias
        }
    </aside>
</div>

@code {
    private bool menuAberto = false;
    private int naoLidas, pedidos, notificacoes, pendenciasAdmin;
    private bool painelAberto;
    private int? usuarioContado;
    private bool escuro, podeInstalar, ehIos;

    // Preferências do menu lateral (tema e aplicativo)
    private RenderFragment Preferencias => __builder =>
    {
        <button class="item" @onclick="AlternarTema" role="switch" aria-checked="@escuro">
            <i class="bi @(escuro ? "bi-moon-stars-fill" : "bi-moon-stars")"></i> Modo escuro
            <span class="interruptor ms-auto @(escuro ? "ligado" : "")" aria-hidden="true"><span></span></span>
        </button>
        @if (podeInstalar)
        {
            <button class="item" @onclick="Instalar"><i class="bi bi-phone"></i> Instalar o aplicativo</button>
        }
        else if (ehIos)
        {
            <div class="item small text-muted" style="cursor:default"><i class="bi bi-phone"></i> No iPhone: toque em <i class="bi bi-box-arrow-up"></i> e em "Adicionar à Tela de Início"</div>
        }
        <a href="/avaliar" class="item" @onclick="FecharMenu"><i class="bi bi-clipboard-data"></i> Avaliar o site</a>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            escuro = await JS.InvokeAsync<string>("mpTema", (object?)null) == "escuro";
            ehIos = await JS.InvokeAsync<bool>("mpEhIos");
            StateHasChanged();
        }
        catch { }
    }

    private async Task AlternarTema()
    {
        try { escuro = await JS.InvokeAsync<string>("mpTema", escuro ? "claro" : "escuro") == "escuro"; } catch { }
    }

    private async Task Instalar()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("mpInstalar")) Toast.Sucesso("Match-Pet instalado! Procure o ícone na tela inicial. 📱");
        }
        catch { }
        podeInstalar = false;
        menuAberto = false;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnChage += AoMudarLogin;
        Nav.LocationChanged += AoNavegar;
        Avisos.OnAviso += AoReceberAviso;
        await AtualizarContadores();
    }

    // Contadores de mensagens não lidas e pedidos de amizade
    private async Task AtualizarContadores()
    {
        if (AuthService.UsuarioLogado is { } u)
        {
            try
            {
                naoLidas = await Chat.ContarNaoLidasAsync(u.Id);
                pedidos = await Social.ContarPedidosAsync(u.Id);
                notificacoes = await Notificacoes.ContarNaoLidasAsync(u.Id);
                pendenciasAdmin = u.EhAdmin ? await Moderacao.PendenciasAsync() : 0;
            }
            catch { /* banco indisponível: só não mostra os números */ }
            usuarioContado = u.Id;
        }
        else
        {
            naoLidas = pedidos = notificacoes = pendenciasAdmin = 0;
            usuarioContado = null;
        }
    }

    private void AoMudarLogin() => InvokeAsync(async () =>
    {
        if (usuarioContado != AuthService.UsuarioLogado?.Id) await AtualizarContadores();
        StateHasChanged();
    });

    // Mensagem ou pedido novo chegando em tempo real
    private void AoReceberAviso(NotificacoesService.Aviso aviso)
    {
        if (aviso.UsuarioId != AuthService.UsuarioLogado?.Id) return;
        _ = InvokeAsync(async () => { await AtualizarContadores(); StateHasChanged(); });
    }

    // Fecha o menu e atualiza os contadores a cada troca de página
    private void AoNavegar(object? sender, LocationChangedEventArgs e)
    {
        menuAberto = false;
        painelAberto = false;
        _ = InvokeAsync(async () => { await AtualizarContadores(); StateHasChanged(); });
    }

    private async Task ToggleMenu()
    {
        menuAberto = !menuAberto;
        if (menuAberto) { try { podeInstalar = await JS.InvokeAsync<bool>("mpPodeInstalar"); } catch { } }
    }

    private void AlternarPainel() => painelAberto = !painelAberto;

    private async Task MarcarTodasLidas()
    {
        await Notificacoes.MarcarTodasLidasAsync(AuthService.UsuarioLogado!.Id);
        painelAberto = false;
        await AtualizarContadores();
    }
    private void FecharMenu() => menuAberto = false;

    private static string PrimeiroNome(string nome) => nome.Trim().Split(' ')[0];

    private async Task ExecutarSair()
    {
        menuAberto = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthService.OnChage -= AoMudarLogin;
        Nav.LocationChanged -= AoNavegar;
        Avisos.OnAviso -= AoReceberAviso;
    }
}
