@inject AuthService AuthService
@inject NavigationManager Nav
@implements IDisposable

@* ===== BARRA SUPERIOR ===== *@
<header class="topo">
    <div class="container-xl d-flex align-items-center gap-3 h-100">
        <a class="marca" href="/" aria-label="Match-Pet SP - Início">
            <img src="/logo-match-pet.png" alt="" />
            <span class="d-none d-sm-inline">Match-Pet <b>SP</b></span>
        </a>

        <nav class="links d-none d-lg-flex" aria-label="Principal">
            <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="/pets">Adotar</NavLink>
            <NavLink href="/bazar">Bazar Solidário</NavLink>
            <NavLink href="/ongs">ONGs</NavLink>
            <NavLink href="/final-feliz">Final Feliz</NavLink>
        </nav>

        <div class="ms-auto d-flex align-items-center gap-2">
            <a href="/pets/novo" class="btn btn-accent btn-sm px-3 d-none d-md-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Anunciar
            </a>

            @if (AuthService.UsuarioLogado is { } u)
            {
                <button class="usuario" type="button" @onclick="ToggleMenu" aria-label="Abrir menu da conta" aria-expanded="@menuAberto">
                    <Avatar Usuario="u" Tamanho="34" />
                    <span class="d-none d-md-inline text-truncate" style="max-width:140px">@PrimeiroNome(u.Nome)</span>
                    <i class="bi bi-chevron-down small d-none d-md-inline"></i>
                </button>
            }
            else
            {
                <a href="/login" class="btn btn-ghost btn-sm px-3 d-none d-md-inline-flex">Entrar</a>
                <a href="/cadastro" class="btn btn-primary btn-sm px-3">Criar conta</a>
            }
        </div>
    </div>
</header>

@* ===== BARRA INFERIOR (CELULAR) ===== *@
<nav class="barra-inferior d-lg-none" aria-label="Navegação rápida">
    <NavLink href="/" Match="NavLinkMatch.All"><i class="bi bi-house-door"></i><span>Início</span></NavLink>
    <NavLink href="/pets"><i class="bi bi-search-heart"></i><span>Adotar</span></NavLink>
    <a href="/pets/novo" class="central" aria-label="Anunciar"><span class="mais"><i class="bi bi-plus-lg"></i></span></a>
    <NavLink href="/bazar"><i class="bi bi-gift"></i><span>Bazar</span></NavLink>
    <button type="button" @onclick="ToggleMenu" class="@(menuAberto ? "active" : "")"><i class="bi bi-list"></i><span>Menu</span></button>
</nav>

@* ===== MENU LATERAL (conta e demais páginas) ===== *@
<div class="menu-overlay @(menuAberto ? "active" : "")" @onclick="FecharMenu">
    <aside class="menu-content" @onclick:stopPropagation="true" aria-label="Menu">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="fw-bold text-dark fs-5">Menu</span>
            <button class="btn btn-light btn-icon" @onclick="FecharMenu" aria-label="Fechar menu"><i class="bi bi-x-lg"></i></button>
        </div>

        @if (AuthService.UsuarioLogado is { } usuarioMenu)
        {
            <a href="/perfil" class="cartao-usuario" @onclick="FecharMenu">
                <Avatar Usuario="usuarioMenu" Tamanho="48" />
                <div class="min-w-0">
                    <div class="fw-bold text-dark text-truncate">@usuarioMenu.Nome</div>
                    <div class="small @(usuarioMenu.StatusValidacaoDocumento == "Aprovado" ? "text-success" : "text-warning") fw-semibold">
                        <i class="bi @(usuarioMenu.StatusValidacaoDocumento == "Aprovado" ? "bi-patch-check-fill" : "bi-exclamation-circle-fill")"></i>
                        @(usuarioMenu.StatusValidacaoDocumento == "Aprovado" ? "Identidade verificada" : "Verificação pendente")
                    </div>
                </div>
            </a>
        }

        <div class="grupo">Navegar</div>
        <a href="/" class="item" @onclick="FecharMenu"><i class="bi bi-house-door"></i> Início</a>
        <a href="/pets" class="item" @onclick="FecharMenu"><i class="bi bi-search-heart"></i> Adotar um pet</a>
        <a href="/bazar" class="item" @onclick="FecharMenu"><i class="bi bi-gift"></i> Bazar Solidário</a>
        <a href="/ongs" class="item" @onclick="FecharMenu"><i class="bi bi-building-check"></i> ONGs parceiras</a>
        <a href="/final-feliz" class="item" @onclick="FecharMenu"><i class="bi bi-stars"></i> Final Feliz</a>

        @if (AuthService.EstaLogado)
        {
            <div class="grupo">Minha conta</div>
            <a href="/pets/novo" class="item" @onclick="FecharMenu"><i class="bi bi-plus-circle"></i> Novo anúncio</a>
            <a href="/meus-pets" class="item" @onclick="FecharMenu"><i class="bi bi-collection"></i> Meus anúncios</a>
            <a href="/perfil" class="item" @onclick="FecharMenu"><i class="bi bi-person-gear"></i> Meu perfil</a>
            <button class="item text-danger mt-2" @onclick="ExecutarSair"><i class="bi bi-box-arrow-right"></i> Sair</button>
        }
        else
        {
            <div class="mt-4 d-grid gap-2">
                <a href="/login" class="btn btn-primary" @onclick="FecharMenu">Entrar</a>
                <a href="/cadastro" class="btn btn-outline-primary" @onclick="FecharMenu">Criar conta grátis</a>
            </div>
        }
    </aside>
</div>

@code {
    private bool menuAberto = false;

    protected override void OnInitialized()
    {
        AuthService.OnChage += AtualizarTela;
        Nav.LocationChanged += AoNavegar;
    }

    private void AtualizarTela() => InvokeAsync(StateHasChanged);

    // Fecha o menu sempre que o usuário muda de página
    private void AoNavegar(object? sender, LocationChangedEventArgs e)
    {
        if (!menuAberto) return;
        menuAberto = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => menuAberto = !menuAberto;
    private void FecharMenu() => menuAberto = false;

    private static string PrimeiroNome(string nome) => nome.Trim().Split(' ')[0];

    private async Task ExecutarSair()
    {
        menuAberto = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthService.OnChage -= AtualizarTela;
        Nav.LocationChanged -= AoNavegar;
    }
}
