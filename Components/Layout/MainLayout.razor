@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="page">
    <NavMenu />
    <Avisos />
    <AvisoAnalise />

    <main id="conteudo" tabindex="-1">
        @if (!sessaoPronta)
        {
            @* Enquanto recupera o login salvo no navegador *@
            <div class="d-flex justify-content-center py-5 my-5"><div class="spinner-border text-primary"></div></div>
        }
        else
        {
            @Body
        }
    </main>

    <footer class="rodape-site">
        <div class="container-xl">
            @if (!AuthService.EstaLogado)
            {
                <div class="rodape-cta">
                    <div>
                        <h2>Pronto para encontrar seu match?</h2>
                        <p>Crie sua conta grátis em 2 minutos e converse direto com ONGs e tutores.</p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/cadastro" class="btn btn-light btn-lg fw-bold">Criar conta grátis</a>
                        <a href="/pets" class="btn btn-glass btn-lg">Ver pets</a>
                    </div>
                </div>
            }
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="/logo-match-pet.png" alt="" style="height:40px" />
                        <span class="fw-bold text-white fs-5">Match-Pet <span style="color:#fb923c">SP</span></span>
                    </div>
                    <p class="small mb-3" style="max-width:360px">
                        Adoção responsável e doações solidárias em Franca e região. Cada cadastro é verificado para proteger pessoas e animais.
                    </p>
                    <div class="selos">
                        <span><i class="bi bi-shield-check"></i> Documentos verificados</span>
                        <span><i class="bi bi-file-earmark-lock2"></i> Termo digital</span>
                        <span><i class="bi bi-incognito"></i> LGPD</span>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="titulo">Adotar</div>
                    <a href="/pets">Catálogo</a>
                    <a href="/ongs">ONGs</a>
                    <a href="/final-feliz">Final Feliz</a>
                    <a href="/questionario-adocao">Questionário de adoção</a>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="titulo">Comunidade</div>
                    <a href="/comunidade">Feed</a>
                    <a href="/reels">Vídeos</a>
                    <a href="/estatisticas">Estatísticas e rankings</a>
                    <a href="/verificar-termo">Verificar um termo</a>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="titulo">Ajudar</div>
                    <a href="/pets/novo">Anunciar pet</a>
                    <a href="/bazar">Bazar Solidário</a>
                    <a href="/avaliar">Avaliar o site</a>
                    <a href="/sobre">Sobre o projeto</a>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <div class="titulo">Conta</div>
                    @if (AuthService.EstaLogado)
                    {
                        <a href="/perfil">Meu perfil</a>
                        <a href="/notificacoes">Notificações</a>
                        <a href="/mensagens">Mensagens</a>
                        <a href="/favoritos">Favoritos</a>
                    }
                    else
                    {
                        <a href="/login">Entrar</a>
                        <a href="/cadastro">Criar conta</a>
                        <a href="/esqueci-senha">Esqueci a senha</a>
                    }
                </div>
            </div>
            <div class="rodape-base">
                <span>&copy; 2026 Match-Pet SP · TCC de Otávio M. S. Francelino e Pedro H. P. Grace · Franca/SP</span>
                <span><a href="/privacidade" class="d-inline p-0">Privacidade</a> · <a href="/privacidade#termos" class="d-inline p-0">Termos de uso</a> · Feito com 🐾 para quem ama animais</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui">
    Algo deu errado. <a href="" class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sessaoPronta;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += AoNavegar;
        await AuthService.RestaurarSessaoAsync();
        sessaoPronta = true;
    }

    // Cada página nova começa do topo
    private async void AoNavegar(object? sender, LocationChangedEventArgs e)
    {
        if (!e.Location.Contains('#'))
        {
            try { await JS.InvokeVoidAsync("mpRolarTopo"); } catch { }
        }
    }

    public void Dispose() => Nav.LocationChanged -= AoNavegar;
}
