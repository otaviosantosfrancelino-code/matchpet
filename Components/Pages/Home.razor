@page "/"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject IPetRepository PetRepository
@inject IItemRepository ItemRepository
@inject IUsuarioRepository UsuarioRepository
@inject SocialService Social
@inject RankingService Ranking
@inject EstatisticasService Estatisticas
@inject AchadosPerdidosService Achados

<PageTitle>Match-Pet SP | Adoção responsável em Franca e região</PageTitle>

@* ================= CAPA ================= *@
<section class="hero">
    <div class="hero-bolhas" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container-xl position-relative">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6 order-2 order-lg-1">
                <span class="eyebrow mb-3"><span class="ponto-vivo"></span> @(numeros?.Disponiveis ?? 0) pets esperando um lar agora</span>
                <h1 class="hero-titulo">Encontre o <span class="texto-gradiente">amigo certo</span> para a sua vida.</h1>
                <p class="hero-texto">Adoção responsável com ONGs e tutores verificados, conversa direta pelo chat e termo digital assinado em minutos. Tudo em um só lugar.</p>

                <div class="busca mp-card">
                    <div class="chips">
                        @foreach (var (valor, rotulo) in Especies)
                        {
                            <button class="chip @(especie == valor ? "ativo" : "")" @onclick="() => especie = valor">@rotulo</button>
                        }
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-2 mt-3">
                        <div class="campo-icone flex-grow-1">
                            <i class="bi bi-geo-alt"></i>
                            <input class="form-control" placeholder="Sua cidade (ex.: Franca)" @bind="cidade" @onkeydown="Enter" aria-label="Cidade" />
                        </div>
                        <button class="btn btn-primary px-4" @onclick="Buscar"><i class="bi bi-search me-1"></i> Buscar pets</button>
                    </div>
                </div>

                <div class="prova-social">
                    <div class="avatares">
                        @foreach (var p in rostos)
                        {
                            <Avatar Usuario="p" Tamanho="36" />
                        }
                    </div>
                    <span><b>@(numeros?.Usuarios ?? 0)+ pessoas</b> e <b>@(numeros?.Ongs ?? 0) ONGs</b> já fazem parte</span>
                </div>
            </div>

            @* Mascote da marca: aparece também no celular *@
            <div class="col-lg-6 order-1 order-lg-2">
                <div class="hero-imagem">
                    <div class="aro"></div>
                    <img src="/home-match-pet.png" alt="Mascote do Match-Pet: um cachorrinho de moletom amarelo" />
                    <div class="flutuante f1"><span>🛡️</span><div><b>Perfis verificados</b><small>Documento conferido</small></div></div>
                    <div class="flutuante f2"><span>📝</span><div><b>Termo digital</b><small>Assinado no chat</small></div></div>
                    <div class="flutuante f3 d-none d-md-flex"><span>💛</span><div><b>@(numeros?.Adotados ?? 0) adoções</b><small>e contando</small></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ================= NÚMEROS ================= *@
@if (numeros != null)
{
    <section class="container-xl numeros-faixa" data-revelar>
        <div class="mp-card p-3 p-md-4">
            <div class="row g-3 text-center">
                <div class="col-6 col-md-2"><b data-contar="@numeros.Adotados">@numeros.Adotados</b><span>adoções</span></div>
                <div class="col-6 col-md-2"><b data-contar="@numeros.Disponiveis">@numeros.Disponiveis</b><span>pets disponíveis</span></div>
                <div class="col-6 col-md-2"><b data-contar="@numeros.Ongs">@numeros.Ongs</b><span>ONGs parceiras</span></div>
                <div class="col-6 col-md-2"><b data-contar="@numeros.Usuarios">@numeros.Usuarios</b><span>pessoas</span></div>
                <div class="col-6 col-md-2"><b data-contar="@(numeros.ItensDoados + numeros.ItensDisponiveis)">@(numeros.ItensDoados + numeros.ItensDisponiveis)</b><span>itens no Bazar</span></div>
                <div class="col-6 col-md-2"><b data-contar="@numeros.Depoimentos">@numeros.Depoimentos</b><span>histórias felizes</span></div>
            </div>
        </div>
    </section>
}

@* ================= RECÉM-CHEGADOS ================= *@
<section class="container-xl secao pb-4">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-4 flex-wrap" data-revelar>
        <div>
            <span class="eyebrow">Novidades</span>
            <h2 class="secao-titulo mb-0 mt-2">Recém-chegados</h2>
        </div>
        <a href="/pets" class="btn btn-light">Ver todos <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    @if (recentes == null) { <CardsCarregando Quantidade="4" /> }
    else
    {
        <div class="row g-3 g-md-4">
            @{ var i = 0; }
            @foreach (var pet in recentes)
            {
                i++;
                <div class="col-12 col-sm-6 col-md-4 col-lg-3" data-revelar="@((i - 1) % 4 + 1)"><PetCard Pet="pet" /></div>
            }
        </div>
    }
</section>

@* ================= ESPERANDO HÁ MAIS TEMPO ================= *@
@if (esperando?.Any() == true)
{
    <section class="container-xl pb-5">
        <div class="cartao-destaque" data-revelar>
            <div class="d-flex align-items-end justify-content-between gap-3 mb-3 flex-wrap">
                <div>
                    <span class="eyebrow" style="background:var(--mp-accent-soft);color:#ea580c">❤️‍🩹 Adoção especial</span>
                    <h2 class="h3 mb-1 mt-2">Esperando há mais tempo</h2>
                    <p class="text-muted mb-0">Adultos e idosos costumam esperar mais. Eles têm muito amor para dar.</p>
                </div>
                <a href="/pets" class="btn btn-accent">Conhecer todos</a>
            </div>
            <div class="carrossel">
                @foreach (var pet in esperando)
                {
                    <PetCard Pet="pet" MostrarBotao="false" />
                }
            </div>
        </div>
    </section>
}

@* ================= ACHADOS E PERDIDOS ================= *@
@if (perdidos?.Any() == true)
{
    <section class="container-xl pb-5">
        <div class="cartao-achados" data-revelar>
            <div class="d-flex align-items-end justify-content-between gap-3 mb-3 flex-wrap">
                <div>
                    <span class="eyebrow" style="background:rgba(220,38,38,.1);color:#dc2626">🔎 Achados e Perdidos</span>
                    <h2 class="h3 mb-1 mt-2">Ajude estes pets a voltarem para casa</h2>
                    <p class="text-muted mb-0">Viu algum deles pela rua? Toque no anúncio e avise quem está procurando.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/achados-e-perdidos/novo" class="btn btn-light">Perdi ou encontrei um pet</a>
                    <a href="/achados-e-perdidos" class="btn btn-danger">Ver todos</a>
                </div>
            </div>
            <div class="carrossel">
                @foreach (var a in perdidos)
                {
                    <CardAchado Anuncio="a" />
                }
            </div>
        </div>
    </section>
}

@* ================= COMO FUNCIONA ================= *@
<section class="secao secao-escura">
    <div class="container-xl">
        <div class="text-center mb-5" data-revelar>
            <span class="eyebrow">Passo a passo</span>
            <h2 class="secao-titulo mt-2">Da primeira mensagem ao final feliz</h2>
            <p class="mx-auto" style="max-width:560px">Uma jornada simples, segura e registrada de ponta a ponta.</p>
        </div>
        <div class="row g-3 g-md-4 linha-passos">
            @{ var n = 0; }
            @foreach (var passo in Passos)
            {
                n++;
                <div class="col-sm-6 col-lg-3" data-revelar="@n">
                    <div class="cartao-vidro p-4 h-100">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="numero-passo">0@(passo.Numero)</span>
                            <span class="fs-2">@passo.Emoji</span>
                        </div>
                        <h5 class="mb-2">@passo.Titulo</h5>
                        <p class="small mb-0">@passo.Descricao</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* ================= ONGs PARCEIRAS ================= *@
@if (ongs?.Any() == true)
{
    <section class="container-xl pt-5">
        <p class="text-center text-muted small fw-bold text-uppercase mb-3" style="letter-spacing:.08em" data-revelar>Instituições que confiam no Match-Pet</p>
        <div class="letreiro" data-revelar>
            <div class="letreiro-trilho">
                @foreach (var o in ongs.Concat(ongs))
                {
                    <a href="/u/@o.Id" class="ong-chip"><Avatar Usuario="o" Tamanho="34" /> <span>@o.Nome</span> <i class="bi bi-patch-check-fill text-success"></i></a>
                }
            </div>
        </div>
    </section>
}

@* ================= POR QUE ADOTAR ================= *@
<section class="container-xl secao">
    <div class="row align-items-center g-4 g-lg-5">
        <div class="col-lg-5" data-revelar>
            <span class="eyebrow">Por que adotar?</span>
            <h2 class="secao-titulo mt-2">Adotar muda <span class="texto-gradiente">duas vidas</span>.</h2>
            <p class="text-muted fs-5">A sua e a de quem estava esperando por você. No Match-Pet cada etapa foi pensada para dar segurança aos dois lados.</p>
            <a href="/pets" class="btn btn-primary btn-lg mt-2">Quero adotar</a>
        </div>
        <div class="col-lg-7">
            <div class="row g-3">
                @{ var b = 0; }
                @foreach (var beneficio in Beneficios)
                {
                    b++;
                    <div class="col-sm-6" data-revelar="@b">
                        <div class="mp-card mp-card-hover p-4 h-100 beneficio">
                            <div class="icone-bolha @beneficio.Cor mb-3"><i class="bi @beneficio.Icone"></i></div>
                            <h5 class="mb-1">@beneficio.Titulo</h5>
                            <p class="small text-muted mb-0">@beneficio.Texto</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ================= HISTÓRIAS ================= *@
@if (historias?.Any() == true)
{
    <section class="container-xl pb-5">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-4 flex-wrap" data-revelar>
            <div>
                <span class="eyebrow">Final feliz</span>
                <h2 class="secao-titulo mb-0 mt-2">Histórias que inspiram</h2>
            </div>
            <a href="/final-feliz" class="btn btn-light">Ler todas <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3 g-md-4">
            @{ var h = 0; }
            @foreach (var d in historias)
            {
                h++;
                <div class="col-md-4" data-revelar="@h">
                    <article class="mp-card historia-card h-100">
                        @if (d.FotoUrl != null || d.PetFotoId != null)
                        {
                            <img src="@(d.FotoUrl ?? $"/imagens/pet/{d.PetFotoId}")" alt="" loading="lazy" />
                        }
                        <div class="p-4">
                            <div class="aspas">“</div>
                            <h3 class="h6 fw-bold">@d.Titulo</h3>
                            <p class="small text-muted texto-3-linhas">@d.Texto</p>
                            <a href="/u/@d.Autor.Id" class="d-flex align-items-center gap-2 text-decoration-none">
                                <Avatar Usuario="d.Autor" Tamanho="30" />
                                <span class="small"><b class="text-dark">@d.Autor.Nome</b> <span class="text-muted">· @d.Autor.Cidade</span></span>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}

@* ================= COMUNIDADE ================= *@
@if (destaquesComunidade?.Any() == true)
{
    <section class="secao" style="background:linear-gradient(180deg, transparent, #eef4ff 30%, #eef4ff 70%, transparent)">
        <div class="container-xl">
            <div class="d-flex align-items-end justify-content-between gap-3 mb-4 flex-wrap" data-revelar>
                <div>
                    <span class="eyebrow">Comunidade</span>
                    <h2 class="secao-titulo mb-0 mt-2">O que está rolando</h2>
                </div>
                <div class="d-flex gap-2">
                    <a href="/reels" class="btn btn-dark"><i class="bi bi-play-btn-fill me-1"></i>Vídeos</a>
                    <a href="/comunidade" class="btn btn-light">Ver feed</a>
                </div>
            </div>
            <div class="mosaico">
                @foreach (var p in destaquesComunidade)
                {
                    <a href="@(p.TipoMidia == "video" ? $"/reels?inicio={p.Id}" : $"/comunidade?post={p.Id}")" class="mosaico-item" data-revelar>
                        @if (p.TipoMidia == "video")
                        {
                            <video src="@p.MidiaUrl" muted playsinline preload="metadata"></video>
                            <span class="selo-video"><i class="bi bi-play-fill"></i></span>
                        }
                        else
                        {
                            <img src="@p.MidiaUrl" alt="Publicação de @p.Autor.Nome" loading="lazy" />
                        }
                        <span class="mosaico-info">
                            <Avatar Usuario="p.Autor" Tamanho="26" />
                            <span class="text-truncate">@p.Autor.Nome</span>
                            <span class="ms-auto d-flex align-items-center gap-1"><IconePata Cheia="true" Tamanho="16" /> @p.Curtidas</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@* ================= RANKING + BAZAR ================= *@
<section class="container-xl secao pt-4">
    <div class="row g-4">
        @if (topAdotantes?.Any() == true)
        {
            <div class="col-lg-5" data-revelar>
                <div class="mp-card p-4 h-100 ranking-mini">
                    <span class="eyebrow"><i class="bi bi-trophy"></i> Ranking</span>
                    <h3 class="h4 mt-2">Quem mais adotou</h3>
                    <ol class="list-unstyled mb-3 mt-3">
                        @foreach (var p in topAdotantes)
                        {
                            <li>
                                <a href="/u/@p.Usuario.Id" class="d-flex align-items-center gap-3 py-2 text-decoration-none">
                                    <span class="fs-4">@(p.Lugar switch { 1 => "🥇", 2 => "🥈", _ => "🥉" })</span>
                                    <Avatar Usuario="p.Usuario" Tamanho="42" />
                                    <span class="min-w-0"><b class="d-block text-dark text-truncate">@p.Usuario.Nome</b><small class="text-muted">@p.Detalhe</small></span>
                                </a>
                            </li>
                        }
                    </ol>
                    <a href="/estatisticas#rankings" class="btn btn-light w-100">Ver rankings completos</a>
                </div>
            </div>
        }
        <div class="@(topAdotantes?.Any() == true ? "col-lg-7" : "col-12")" data-revelar="2">
            <div class="chamada laranja h-100 flex-column align-items-start">
                <div class="d-flex justify-content-between w-100 gap-3">
                    <div>
                        <h3>Bazar Solidário</h3>
                        <p>Ração, caminhas, gaiolas e acessórios doados por quem quer ajudar.</p>
                    </div>
                    <span class="emoji d-none d-sm-block">🎁</span>
                </div>
                @if (itensBazar?.Any() == true)
                {
                    <div class="row g-2 w-100 my-2">
                        @foreach (var item in itensBazar)
                        {
                            <div class="col-6 col-md-3">
                                <a href="/bazar" class="mini-item">
                                    @if (item.Imagens.Any()) { <img src="@Url.Item(item.Imagens[0])" alt="" loading="lazy" /> }
                                    <span class="text-truncate">@item.Nome</span>
                                </a>
                            </div>
                        }
                    </div>
                }
                <a href="/bazar" class="btn btn-light mt-auto">Ver todos os itens</a>
            </div>
        </div>
    </div>
</section>

@* ================= CONFIANÇA ================= *@
<section class="container-xl pb-5">
    <div class="text-center mb-4" data-revelar>
        <span class="eyebrow">Confiança</span>
        <h2 class="secao-titulo mt-2">Amparo legal e intermediação segura</h2>
    </div>
    <div class="row g-3 g-md-4">
        <div class="col-md-4" data-revelar="1"><div class="mp-card p-4 h-100"><div class="icone-bolha azul mb-3"><i class="bi bi-file-earmark-lock2"></i></div><h5>Termo digital no chat</h5><p class="small text-muted mb-0">Doador e adotante conversam e assinam o termo na própria conversa, com data, hora e IP registrados.</p></div></div>
        <div class="col-md-4" data-revelar="2"><div class="mp-card p-4 h-100"><div class="icone-bolha vermelho mb-3"><i class="bi bi-bookmark-star"></i></div><h5>Lei Sansão (14.064/20)</h5><p class="small text-muted mb-0">O termo traz ciência expressa sobre a responsabilidade criminal por maus-tratos ou abandono.</p></div></div>
        <div class="col-md-4" data-revelar="3"><div class="mp-card p-4 h-100"><div class="icone-bolha verde mb-3"><i class="bi bi-shield-check"></i></div><h5>Identidade verificada</h5><p class="small text-muted mb-0">CPF/CNPJ conferido, CNPJ consultado na Receita e foto do documento comparada com o cadastro.</p></div></div>
    </div>
</section>

@* ================= DÚVIDAS ================= *@
<section class="container-xl pb-5" style="max-width: 860px;">
    <div class="text-center mb-4" data-revelar>
        <span class="eyebrow">Dúvidas</span>
        <h2 class="secao-titulo mt-2">Perguntas frequentes</h2>
    </div>
    <div class="accordion" id="faq" data-revelar>
        @for (var f = 0; f < Faq.Length; f++)
        {
            var indice = f;
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button @(faqAberta == indice ? "" : "collapsed")" type="button" @onclick="() => faqAberta = faqAberta == indice ? -1 : indice">
                        @Faq[indice].Pergunta
                    </button>
                </h3>
                @if (faqAberta == indice)
                {
                    <div class="accordion-collapse"><div class="accordion-body text-muted">@Faq[indice].Resposta</div></div>
                }
            </div>
        }
    </div>
</section>

<style>
    .hero { position: relative; overflow: hidden; padding: 2.5rem 0 3.5rem; }
    .hero-bolhas span { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; }
    .hero-bolhas span:nth-child(1) { width: 420px; height: 420px; background: #bfdbfe; top: -120px; right: -80px; }
    .hero-bolhas span:nth-child(2) { width: 320px; height: 320px; background: #fed7aa; bottom: -120px; left: -100px; }
    .hero-bolhas span:nth-child(3) { width: 260px; height: 260px; background: #ddd6fe; top: 40%; left: 45%; }
    .hero-titulo { font-size: clamp(2.3rem, 5.4vw, 4rem); line-height: 1.03; margin: 1rem 0 1.25rem; letter-spacing: -.035em; }
    .hero-texto { font-size: clamp(1rem, 1.6vw, 1.15rem); color: var(--mp-muted); max-width: 540px; margin-bottom: 1.75rem; }
    .ponto-vivo { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,.6); animation: pulsoVivo 1.8s infinite; display: inline-block; }
    @@keyframes pulsoVivo { 70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
    .busca { padding: 1rem; border-radius: 22px; box-shadow: var(--mp-shadow); max-width: 560px; background: rgba(255,255,255,.9); backdrop-filter: blur(10px); }
    .prova-social { display: flex; align-items: center; gap: .8rem; margin-top: 1.5rem; font-size: .9rem; color: var(--mp-muted); flex-wrap: wrap; }
    .prova-social b { color: var(--mp-ink); }
    .avatares { display: flex; }
    .avatares > * { margin-left: -10px; border: 3px solid #fff; border-radius: 50%; box-shadow: var(--mp-shadow-sm); }
    .avatares > *:first-child { margin-left: 0; }
    .hero-imagem { position: relative; max-width: 520px; margin: 0 auto; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; }
    .hero-imagem .aro { position: absolute; inset: 6%; border-radius: 50%; background: conic-gradient(from 180deg, #2563eb, #7c3aed, #f97316, #2563eb); opacity: .16; filter: blur(2px); animation: girar 18s linear infinite; }
    .hero-imagem img { position: relative; width: 82%; border-radius: 36px; object-fit: cover; box-shadow: 0 40px 80px -30px rgba(37, 99, 235, .55); animation: flutuar 6s ease-in-out infinite; }
    @@keyframes girar { to { transform: rotate(360deg); } }
    @@keyframes flutuar { 50% { transform: translateY(-12px); } }
    .flutuante { position: absolute; display: flex; align-items: center; gap: .7rem; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); padding: .7rem .95rem; border-radius: 16px; box-shadow: var(--mp-shadow); z-index: 2; }
    .flutuante span { font-size: 1.4rem; }
    .flutuante b { display: block; color: var(--mp-ink); font-size: .85rem; }
    .flutuante small { color: var(--mp-muted); font-size: .74rem; }
    .flutuante.f1 { top: 10%; left: -2%; animation: flutuar 7s ease-in-out infinite; }
    .flutuante.f2 { bottom: 12%; right: -2%; animation: flutuar 8s ease-in-out infinite reverse; }
    .flutuante.f3 { bottom: 2%; left: 8%; animation: flutuar 9s ease-in-out infinite; }
    @@media (max-width: 991.98px) {
        .hero { padding-top: 1.25rem; }
        .hero-imagem { max-width: 300px; }
        .flutuante { padding: .5rem .7rem; }
        .flutuante span { font-size: 1.1rem; }
        .flutuante b { font-size: .75rem; } .flutuante small { font-size: .68rem; }
    }
    .numeros-faixa { margin-top: -1.5rem; position: relative; z-index: 2; }
    .numeros-faixa b { display: block; font-size: clamp(1.6rem, 3.5vw, 2.3rem); font-weight: 800; color: var(--mp-ink); line-height: 1.1; }
    .numeros-faixa span { font-size: .8rem; color: var(--mp-muted); font-weight: 600; }
    .cartao-destaque { border-radius: 28px; padding: clamp(1.25rem, 3vw, 2rem); background: linear-gradient(135deg, #fff7ed, #fff 60%); border: 1px solid #fed7aa; }
    .cartao-achados { border-radius: 28px; padding: clamp(1.25rem, 3vw, 2rem); background: linear-gradient(135deg, #fef2f2, var(--mp-surface) 60%); border: 1px solid #fecaca; }
