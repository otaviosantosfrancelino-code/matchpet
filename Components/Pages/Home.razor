@page "/"
@inject NavigationManager Nav
@inject AuthService AuthService
@inject IPetRepository PetRepository
@inject IItemRepository ItemRepository
@inject IUsuarioRepository UsuarioRepository

<PageTitle>Match-Pet SP | Adoção responsável em Franca</PageTitle>

@* ===== CAPA ===== *@
<section class="hero">
    <div class="container-xl position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="eyebrow mb-3"><i class="bi bi-heart-fill"></i> Adoção responsável em Franca/SP</span>
                <h1 class="hero-titulo">Encontre o <span class="destaque">amigo certo</span> para a sua vida.</h1>
                <p class="hero-texto">Pets de ONGs e tutores verificados, filtrados pelo seu estilo de vida. Contrato digital e contato direto com quem está doando.</p>

                <div class="busca mp-card">
                    <div class="chips">
                        @foreach (var (valor, rotulo) in Especies)
                        {
                            <button class="chip @(especie == valor ? "ativo" : "")" @onclick="() => especie = valor">@rotulo</button>
                        }
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-2 mt-3">
                        <div class="campo-icone flex-grow-1">
                            <i class="bi bi-geo-alt"></i>
                            <input class="form-control" placeholder="Sua cidade (ex.: Franca)" @bind="cidade" @onkeydown="Enter" aria-label="Cidade" />
                        </div>
                        <button class="btn btn-primary px-4" @onclick="Buscar"><i class="bi bi-search me-1"></i> Buscar pets</button>
                    </div>
                </div>

                <div class="numeros">
                    <div><strong>@(disponiveis?.ToString() ?? "–")</strong><span>pets esperando</span></div>
                    <div><strong>@(adotados?.ToString() ?? "–")</strong><span>finais felizes</span></div>
                    <div><strong>@(ongs?.ToString() ?? "–")</strong><span>ONGs parceiras</span></div>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-imagem">
                    <img src="/home-match-pet.png" alt="Mascotes do Match-Pet" />
                    <div class="flutuante f1"><span>🛡️</span><div><b>Cadastro verificado</b><small>Documento conferido</small></div></div>
                    <div class="flutuante f2"><span>📝</span><div><b>Contrato digital</b><small>Adoção com segurança</small></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ===== RECÉM-CHEGADOS ===== *@
<section class="container-xl py-5">
    <div class="d-flex align-items-end justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <span class="eyebrow">Novidades</span>
            <h2 class="secao-titulo mb-0">Recém-chegados</h2>
        </div>
        <a href="/pets" class="btn btn-light">Ver todos <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    @if (recentes == null)
    {
        <CardsCarregando Quantidade="4" />
    }
    else if (!recentes.Any())
    {
        <div class="estado-vazio"><div class="emoji">🐾</div><p class="text-muted mb-3">Ainda não há pets anunciados.</p><a href="/pets/novo" class="btn btn-primary">Anunciar o primeiro</a></div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var pet in recentes)
            {
                <div class="col-6 col-md-4 col-lg-3"><PetCard Pet="pet" /></div>
            }
        </div>
    }
</section>

@* ===== COMO FUNCIONA ===== *@
<section class="container-xl py-5">
    <div class="text-center mb-5">
        <span class="eyebrow">Passo a passo</span>
        <h2 class="secao-titulo">Como funciona</h2>
        <p class="text-muted mx-auto" style="max-width:560px">Do primeiro clique até o pet chegar em casa, em quatro etapas simples.</p>
    </div>
    <div class="row g-3 g-md-4">
        @foreach (var passo in Passos)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="mp-card mp-card-hover p-4 h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icone-bolha @passo.Cor"><i class="bi @passo.Icone"></i></div>
                        <span class="numero-passo">0@(passo.Numero)</span>
                    </div>
                    <h5 class="mb-2">@passo.Titulo</h5>
                    <p class="text-muted small mb-0">@passo.Descricao</p>
                </div>
            </div>
        }
    </div>
</section>

@* ===== CHAMADAS ===== *@
<section class="container-xl py-4">
    <div class="row g-3 g-md-4">
        <div class="col-lg-6">
            <div class="chamada azul h-100">
                <div>
                    <h3>Precisa doar um pet?</h3>
                    <p>Anuncie grátis. Os interessados assinam um termo de responsabilidade antes de receber o seu contato.</p>
                    <a href="/pets/novo" class="btn btn-light">Anunciar agora</a>
                </div>
                <span class="emoji">🐶</span>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="chamada laranja h-100">
                <div>
                    <h3>Bazar Solidário</h3>
                    <p>Ração, caminhas, gaiolas e acessórios doados por quem quer ajudar. @(itens is > 0 ? $"{itens} itens disponíveis agora." : "")</p>
                    <a href="/bazar" class="btn btn-light">Ver itens</a>
                </div>
                <span class="emoji">🎁</span>
            </div>
        </div>
    </div>
</section>

@* ===== SEGURANÇA JURÍDICA ===== *@
<section class="container-xl py-5">
    <div class="text-center mb-5">
        <span class="eyebrow">Confiança</span>
        <h2 class="secao-titulo">Amparo legal e intermediação segura</h2>
    </div>
    <div class="row g-3 g-md-4">
        <div class="col-md-4">
            <div class="mp-card p-4 h-100">
                <div class="icone-bolha azul mb-3"><i class="bi bi-file-earmark-lock2"></i></div>
                <h5>Contrato digital</h5>
                <p class="small text-muted mb-0">Cada interesse gera uma minuta vinculando adotante e doador, registrada com data, hora e IP do dispositivo.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mp-card p-4 h-100">
                <div class="icone-bolha vermelho mb-3"><i class="bi bi-bookmark-star"></i></div>
                <h5>Lei Sansão (14.064/20)</h5>
                <p class="small text-muted mb-0">Os termos exigem ciência expressa sobre a responsabilidade criminal por maus-tratos ou abandono.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mp-card p-4 h-100">
                <div class="icone-bolha verde mb-3"><i class="bi bi-tree"></i></div>
                <h5>Fauna silvestre protegida</h5>
                <p class="small text-muted mb-0">Seguindo a Lei de Crimes Ambientais (9.605/98), é proibido anunciar animais silvestres sem autorização.</p>
            </div>
        </div>
    </div>
</section>

@* ===== PERGUNTAS FREQUENTES ===== *@
<section class="container-xl py-4" style="max-width: 860px;">
    <div class="text-center mb-4">
        <span class="eyebrow">Dúvidas</span>
        <h2 class="secao-titulo">Perguntas frequentes</h2>
    </div>
    <div class="accordion" id="faq">
        @for (var i = 0; i < Faq.Length; i++)
        {
            var indice = i;
            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button @(faqAberta == indice ? "" : "collapsed")" type="button" @onclick="() => faqAberta = faqAberta == indice ? -1 : indice">
                        @Faq[indice].Pergunta
                    </button>
                </h3>
                @if (faqAberta == indice)
                {
                    <div class="accordion-collapse"><div class="accordion-body text-muted">@Faq[indice].Resposta</div></div>
                }
            </div>
        }
    </div>
</section>

<style>
    .hero { position: relative; overflow: hidden; padding: 3.5rem 0 4rem; background: radial-gradient(1200px 500px at 85% -10%, #dbeafe 0%, transparent 60%), radial-gradient(800px 400px at -10% 110%, #ffedd5 0%, transparent 60%), #f8fbff; }
    .hero-titulo { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.05; margin: 1rem 0 1.25rem; }
    .hero-titulo .destaque { background: linear-gradient(120deg, var(--mp-primary), #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero-texto { font-size: 1.12rem; color: var(--mp-muted); max-width: 540px; margin-bottom: 1.75rem; }
    .busca { padding: 1rem; border-radius: 22px; box-shadow: var(--mp-shadow); max-width: 560px; }
    .numeros { display: flex; gap: 2rem; margin-top: 2rem; flex-wrap: wrap; }
    .numeros strong { display: block; font-size: 1.9rem; font-weight: 800; color: var(--mp-ink); line-height: 1; }
    .numeros span { font-size: .85rem; color: var(--mp-muted); font-weight: 600; }
    .hero-imagem { position: relative; padding: 1.5rem; }
    .hero-imagem img { width: 100%; max-height: 480px; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(37, 99, 235, .25)); animation: flutuar 5s ease-in-out infinite; }
    .flutuante { position: absolute; display: flex; align-items: center; gap: .7rem; background: #fff; padding: .75rem 1rem; border-radius: 16px; box-shadow: var(--mp-shadow); }
    .flutuante span { font-size: 1.5rem; }
    .flutuante b { display: block; color: var(--mp-ink); font-size: .9rem; }
    .flutuante small { color: var(--mp-muted); font-size: .78rem; }
    .flutuante.f1 { top: 12%; left: -2%; animation: flutuar 6s ease-in-out infinite; }
    .flutuante.f2 { bottom: 10%; right: 0; animation: flutuar 7s ease-in-out infinite reverse; }
    @@keyframes flutuar { 50% { transform: translateY(-10px); } }
    .numero-passo { font-size: 2rem; font-weight: 800; color: #e2e8f0; margin-left: auto; }
    .chamada { position: relative; overflow: hidden; border-radius: 24px; padding: 2rem; color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .chamada h3 { color: #fff; font-size: 1.5rem; }
    .chamada p { opacity: .9; max-width: 380px; }
    .chamada .emoji { font-size: 5rem; line-height: 1; opacity: .9; }
    .chamada.azul { background: linear-gradient(135deg, #2563eb, #7c3aed); }
    .chamada.laranja { background: linear-gradient(135deg, #f97316, #e11d48); }
    @@media (max-width: 576px) { .chamada .emoji { display: none; } .hero { padding-top: 2rem; } }
</style>

@code {
    private string especie = "";
    private string cidade = "";
    private int faqAberta = 0;
    private IEnumerable<Pet>? recentes;
    private int? disponiveis, adotados, ongs, itens;

    private static readonly (string, string)[] Especies =
        { ("", "🐾 Todos"), ("Cão", "🐶 Cães"), ("Gato", "🐱 Gatos"), ("Pássaro", "🐦 Aves"), ("Outros", "🐹 Outros") };

    protected override async Task OnInitializedAsync()
    {
        // Consultas uma de cada vez (o banco do Blazor não aceita duas ao mesmo tempo)
        recentes = await PetRepository.GetRecentesAsync(8);
        (disponiveis, adotados) = await PetRepository.GetEstatisticasAsync();
        ongs = await UsuarioRepository.ContarOngsAsync();
        itens = await ItemRepository.ContarDisponiveisAsync();
    }

    private void Buscar()
    {
        var parametros = new Dictionary<string, object?> { ["especie"] = string.IsNullOrEmpty(especie) ? null : especie, ["cidade"] = string.IsNullOrWhiteSpace(cidade) ? null : cidade.Trim() };
        Nav.NavigateTo(Nav.GetUriWithQueryParameters("/pets", parametros));
    }

    private void Enter(KeyboardEventArgs e) { if (e.Key == "Enter") Buscar(); }

    private record Passo(int Numero, string Titulo, string Descricao, string Icone, string Cor);
    private static readonly Passo[] Passos =
    {
        new(1, "Crie sua conta", "Cadastro rápido com CPF ou CNPJ e verificação do documento.", "bi-person-check", "azul"),
        new(2, "Encontre o match", "Filtre por espécie, porte, cidade e pelo seu estilo de vida.", "bi-search-heart", "laranja"),
        new(3, "Assine o termo", "Contrato digital de responsabilidade em um clique.", "bi-pen", "verde"),
        new(4, "Conheça o pet", "Fale com o doador pelo WhatsApp e combine a visita.", "bi-house-heart", "vermelho"),
    };

    private record ItemFaq(string Pergunta, string Resposta);
    private static readonly ItemFaq[] Faq =
    {
        new("Como funciona o match?", "Você informa o que combina com a sua rotina (crianças em casa, apartamento, espécie, porte) e o sistema mostra apenas os pets compatíveis, com base no que o doador declarou."),
        new("Por que preciso enviar um documento?", "Para evitar perfis falsos e dar segurança jurídica às adoções. O documento é conferido automaticamente: o nome e o CPF/CNPJ precisam bater com o cadastro, e a mesma foto não pode ser usada em duas contas."),
        new("O termo assinado digitalmente tem validade?", "Sim. O documento registra IP, data, hora e os dados civis das partes, caracterizando uma manifestação expressa de vontade que serve como início de prova documental."),
        new("Esqueci minha senha. E agora?", "Na tela de login, clique em \"Esqueci minha senha\". Enviaremos um link para o seu e-mail para você criar uma nova senha."),
    };
}
