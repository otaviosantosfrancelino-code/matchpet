@page "/u/{Id:int}"
@inject SocialService Social
@inject ChatService Chat
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>@(perfil?.Usuario.Nome ?? "Perfil") | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5" style="max-width: 980px;">
    @if (carregando)
    {
        <div class="skeleton mb-3" style="height:260px;border-radius:22px"></div>
        <div class="skeleton" style="height:300px;border-radius:22px"></div>
    }
    else if (perfil == null)
    {
        <div class="estado-vazio"><div class="emoji">🙈</div><h5>Perfil não encontrado</h5><a href="/comunidade" class="btn btn-primary">Ir para a Comunidade</a></div>
    }
    else
    {
        var u = perfil.Usuario;
        <section class="mp-card overflow-hidden mb-4">
            <div class="capa @(u.EhOng ? "ong" : "")"></div>
            <div class="px-3 px-md-4 pb-4">
                <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end gap-3 topo-perfil">
                    <div class="foto-perfil"><Avatar Usuario="u" Tamanho="132" /></div>
                    <div class="flex-grow-1 text-center text-md-start min-w-0">
                        <h1 class="h3 mb-1">@u.Nome @if (u.EhOng) { <i class="bi bi-patch-check-fill text-success" title="ONG"></i> }</h1>
                        <div class="text-muted small">
                            @(u.EhOng ? "ONG / Instituição" : "Pessoa") · <i class="bi bi-geo-alt"></i> @u.Cidade/@u.Estado · no Match-Pet desde @Consultas.HoraBrasil(u.DataCadastro).ToString("MM/yyyy")
                        </div>
                        @if (u.StatusValidacaoDocumento == "Aprovado")
                        {
                            <span class="tag verde mt-2"><i class="bi bi-shield-check"></i> Identidade verificada</span>
                        }
                    </div>
                    <div class="d-flex gap-2 flex-wrap justify-content-center">
                        @switch (relacao)
                        {
                            case SocialService.Relacao.EuMesmo:
                                <a href="/perfil" class="btn btn-light"><i class="bi bi-pencil me-1"></i>Editar perfil</a>
                                break;
                            case SocialService.Relacao.Nenhuma:
                                <button class="btn btn-primary" @onclick="Adicionar" disabled="@ocupado"><i class="bi bi-person-plus me-1"></i>Adicionar amigo</button>
                                break;
                            case SocialService.Relacao.PedidoEnviado:
                                <button class="btn btn-light" @onclick="Remover" disabled="@ocupado"><i class="bi bi-hourglass-split me-1"></i>Pedido enviado</button>
                                break;
                            case SocialService.Relacao.PedidoRecebido:
                                <button class="btn btn-success" @onclick="Adicionar" disabled="@ocupado"><i class="bi bi-person-check me-1"></i>Aceitar pedido</button>
                                break;
                            case SocialService.Relacao.Amigos:
                                <button class="btn btn-light" @onclick="Remover" disabled="@ocupado" title="Desfazer amizade"><i class="bi bi-people-fill me-1 text-success"></i>Amigos</button>
                                break;
                        }
                        @if (relacao != SocialService.Relacao.EuMesmo)
                        {
                            <button class="btn btn-outline-primary" @onclick="MandarMensagem"><i class="bi bi-chat-dots me-1"></i>Mensagem</button>
                            <BotaoDenunciar Tipo="usuario" AlvoId="u.Id" NomeAlvo="@u.Nome" Classe="btn btn-light text-muted" />
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(u.Bio))
                {
                    <p class="mt-3 mb-0" style="white-space:pre-line">@u.Bio</p>
                }

                <div class="numeros-perfil mt-4">
                    <button @onclick='() => aba = "amigos"'><b>@perfil.Amigos</b><span>amigos</span></button>
                    <button @onclick='() => aba = "posts"'><b>@perfil.Postagens</b><span>publicações</span></button>
                    <button @onclick='() => aba = "pets"'><b>@perfil.PetsDoados</b><span>pets doados</span></button>
                    <button @onclick='() => aba = "pets"'><b>@perfil.PetsAdotados</b><span>adotados</span></button>
                </div>
            </div>
        </section>

        <div class="segmentos w-100 mb-3">
            <button class="@(aba == "posts" ? "ativo" : "")" @onclick='() => aba = "posts"'><i class="bi bi-grid-3x3"></i> Publicações</button>
            <button class="@(aba == "pets" ? "ativo" : "")" @onclick='() => aba = "pets"'><i class="bi bi-heart"></i> Pets</button>
            <button class="@(aba == "amigos" ? "ativo" : "")" @onclick="AbrirAmigos"><i class="bi bi-people"></i> Amigos</button>
        </div>

        @if (aba == "posts")
        {
            @if (posts == null) { <div class="skeleton" style="height:300px"></div> }
            else if (!posts.Any()) { <div class="estado-vazio"><div class="emoji">📷</div><p class="text-muted mb-0">Nenhuma publicação ainda.</p></div> }
            else
            {
                <div class="mx-auto" style="max-width:640px">
                    @foreach (var p in posts) { <PostCard @key="p.Id" Post="p" OnExcluido="id => posts.RemoveAll(x => x.Id == id)" /> }
                </div>
            }
        }
        else if (aba == "pets")
        {
            @if (pets == null) { <CardsCarregando Quantidade="4" /> }
            else
            {
                <SecaoPets Titulo="Para adoção agora" Emoji="🐾" Pets="pets.Value.anunciados" Vazio="Nenhum pet anunciado no momento." />
                <SecaoPets Titulo="Já doados (final feliz)" Emoji="💛" Pets="pets.Value.doados" Vazio="Ainda não doou nenhum pet." />
                <SecaoPets Titulo="Adotados por esta pessoa" Emoji="🏡" Pets="pets.Value.adotados" Vazio="Ainda não adotou pelo Match-Pet." />
            }
        }
        else
        {
            @if (amigos == null) { <div class="skeleton" style="height:200px"></div> }
            else if (!amigos.Any()) { <div class="estado-vazio"><div class="emoji">👋</div><p class="text-muted mb-0">Ainda não tem amigos na plataforma.</p></div> }
            else
            {
                <div class="row g-2">
                    @foreach (var a in amigos) { <div class="col-md-6"><CartaoPessoa Usuario="a" /></div> }
                </div>
            }
        }
    }
</div>

<style>
    .capa { height: 170px; background: radial-gradient(600px 200px at 20% 0%, rgba(255,255,255,.35), transparent), linear-gradient(135deg, #2563eb, #7c3aed); }
    .capa.ong { background: radial-gradient(600px 200px at 20% 0%, rgba(255,255,255,.35), transparent), linear-gradient(135deg, #16a34a, #0e7490); }
    .topo-perfil { }
    .foto-perfil { margin-top: -66px; border: 5px solid var(--mp-surface); border-radius: 50%; box-shadow: var(--mp-shadow); background: var(--mp-surface); flex-shrink: 0; }
    .numeros-perfil { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--mp-line); border-radius: 16px; overflow: hidden; }
    .numeros-perfil button { background: var(--mp-surface); border: none; border-right: 1px solid var(--mp-line); padding: .8rem .25rem; display: flex; flex-direction: column; align-items: center; }
    .numeros-perfil button:last-child { border-right: none; }
    .numeros-perfil button:hover { background: #f8fafc; }
    .numeros-perfil b { font-size: 1.3rem; color: var(--mp-ink); line-height: 1.1; }
    .numeros-perfil span { font-size: .75rem; color: var(--mp-muted); font-weight: 600; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private SocialService.Perfil? perfil;
    private SocialService.Relacao relacao = SocialService.Relacao.Nenhuma;
    private List<SocialService.PostagemView>? posts;
    private (List<Pet> anunciados, List<Pet> doados, List<Pet> adotados)? pets;
    private List<Usuario>? amigos;
    private string aba = "posts";
    private bool carregando = true, ocupado;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        aba = "posts";
        posts = null; pets = null; amigos = null;
        perfil = await Social.PerfilAsync(Id);
        carregando = false;
        if (perfil == null) return;

        if (AuthService.UsuarioLogado != null) (relacao, _) = await Social.RelacaoAsync(AuthService.UsuarioLogado.Id, Id);
        else relacao = SocialService.Relacao.Nenhuma;

        posts = await Social.FeedAsync(AuthService.UsuarioLogado?.Id, "todos", 0, autorId: Id);
        pets = await Social.PetsDoPerfilAsync(Id);
    }

    private async Task AbrirAmigos()
    {
        aba = "amigos";
        amigos ??= await Social.AmigosAsync(Id);
    }

    private bool PrecisaEntrar()
    {
        if (AuthService.EstaLogado) return false;
        Toast.Info("Entre na sua conta para interagir.");
        Nav.NavigateTo($"/login?voltar=/u/{Id}");
        return true;
    }

    private async Task Adicionar()
    {
        if (PrecisaEntrar()) return;
        ocupado = true;
        await Social.SolicitarAmizadeAsync(AuthService.UsuarioLogado!.Id, Id);
        await Atualizar();
        Toast.Sucesso(relacao == SocialService.Relacao.Amigos ? "Agora vocês são amigos! 🎉" : "Pedido de amizade enviado.");
    }

    private async Task Remover()
    {
        ocupado = true;
        await Social.RemoverAmizadeAsync(AuthService.UsuarioLogado!.Id, Id);
        await Atualizar();
    }

    private async Task Atualizar()
    {
        (relacao, _) = await Social.RelacaoAsync(AuthService.UsuarioLogado!.Id, Id);
        perfil = await Social.PerfilAsync(Id);
        amigos = null;
        ocupado = false;
    }

    private async Task MandarMensagem()
    {
        if (PrecisaEntrar()) return;
        try
        {
            var conversa = await Chat.ObterOuCriarAsync(AuthService.UsuarioLogado!.Id, Id);
            Nav.NavigateTo($"/mensagens/{conversa}");
        }
        catch (Exception ex) { Toast.Erro(ex.Message); }
    }
}
