@page "/itens/editar/{Id:int}"
@using crudcomdb.Data
@inject IItemRepository ItemRepository
@inject AppDbContext Db
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@inject AvisoAnaliseService Analise
@implements IDisposable

<PageTitle>Editar item | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 820px;">
    <button class="btn btn-ghost px-2 mb-3" @onclick="Voltar"><i class="bi bi-arrow-left me-1"></i> Meus anúncios</button>
    <h1 class="h2 mb-4">Editar doação</h1>

    @if (item == null)
    {
        <div class="skeleton" style="height: 420px; border-radius: 18px;"></div>
    }
    else
    {
        <div class="mp-card p-3 p-sm-4 p-md-5">
            <EditForm Model="@item" OnValidSubmit="SalvarAlteracoes">
                <DataAnnotationsValidator />

                <div class="secao-form mt-0">Fotos</div>
                <div class="upload-area">
                    <InputFile OnChange="AdicionarNovasFotos" multiple accept="image/jpeg,image/png,image/webp" disabled="@estaCarregando" />
                    @if (estaCarregando) { <span class="spinner-border text-warning"></span> }
                    else { <i class="bi bi-camera fs-2 text-warning"></i><div class="fw-bold text-dark">Adicionar fotos</div> }
                </div>
                <div class="miniaturas">
                    @foreach (var img in item.Imagens)
                    {
                        <div class="miniatura"><img src="@Url.Item(img)" alt="" /><button type="button" aria-label="Remover foto" @onclick="() => item.Imagens.Remove(img)">&times;</button></div>
                    }
                </div>

                <div class="secao-form">Informações</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nome do item</label>
                        <InputText class="form-control" @bind-Value="item.Nome" />
                        <ValidationMessage For="@(() => item.Nome)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        @if (statusOriginal == EspeciesPermitidas.StatusModeracao || statusOriginal == ModeracaoService.StatusRemovido)
                        {
                            <input class="form-control" value="@(statusOriginal == ModeracaoService.StatusRemovido ? "Removido pela moderação" : "Aguardando aprovação")" disabled />
                        }
                        else
                        {
                            <InputSelect class="form-select" @bind-Value="item.Status">
                                <option value="Disponível">Disponível</option>
                                <option value="Doado">Doado</option>
                            </InputSelect>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Categoria</label>
                        <InputText class="form-control" @bind-Value="item.Categoria" list="categorias" />
                        <datalist id="categorias"><option value="Ração/Alimento" /><option value="Casinha/Cama" /><option value="Gaiola/Aquário" /><option value="Remédio/Higiene" /><option value="Brinquedo/Acessório" /></datalist>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Serve para</label>
                        <InputText class="form-control" @bind-Value="item.EspecieDestino" list="destinos" />
                        <datalist id="destinos"><option value="Todos" /><option value="Cão" /><option value="Gato" /><option value="Pássaro" /><option value="Peixe" /></datalist>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descrição / conservação</label>
                        <InputTextArea class="form-control" @bind-Value="item.Descricao" rows="3" />
                        <ValidationMessage For="@(() => item.Descricao)" />
                    </div>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row gap-2 justify-content-end mt-5">
                    <button type="button" class="btn btn-light px-4" @onclick="Voltar">Cancelar</button>
                    <button type="submit" class="btn btn-accent btn-lg px-5" disabled="@(estaCarregando || salvando)">@(salvando ? "Salvando..." : "Salvar alterações")</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private ItemDoacao? item;
    private bool estaCarregando, salvando, salvo;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaLogado) { Nav.NavigateTo("/login"); return; }

        var encontrado = await ItemRepository.GetParaEdicaoAsync(Id);
        if (encontrado == null || encontrado.UsuarioDoadorId != AuthService.UsuarioLogado!.Id)
        {
            Toast.Erro("Item não encontrado.");
            Nav.NavigateTo("/meus-pets?aba=itens");
            return;
        }
        item = encontrado;
        statusOriginal = encontrado.Status;
    }

    // Sai sem salvar: descarta o que foi alterado na memória
    private string statusOriginal = "";

    private void DescartarAlteracoes() { if (!salvo && item != null) Db.ChangeTracker.Clear(); }

    private void Voltar()
    {
        DescartarAlteracoes();
        Nav.NavigateTo("/meus-pets?aba=itens");
    }

    public void Dispose() => DescartarAlteracoes();

    private async Task AdicionarNovasFotos(InputFileChangeEventArgs e)
    {
        var vagas = 8 - item!.Imagens.Count;
        if (vagas <= 0) { Toast.Aviso("Limite de 8 fotos."); return; }
        estaCarregando = true;
        try
        {
            foreach (var arquivo in e.GetMultipleFiles(50).Take(vagas))
            {
                var reduzida = await arquivo.RequestImageFileAsync("image/jpeg", 1000, 1000);
                using var stream = reduzida.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                item.Imagens.Add(new ItemImagem { Base64Data = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}", ItemDoacaoId = item.Id });
            }
        }
        catch { Toast.Erro("Não foi possível carregar uma das fotos (máx. 10 MB cada)."); }
        finally { estaCarregando = false; }
    }

    private async Task SalvarAlteracoes()
    {
        if (salvando) return;
        salvando = true;
        try
        {
            item!.FotoUrl = ""; // a capa é a 1ª imagem (não duplicamos a foto no banco)
            // Moderação e remoção não podem ser desfeitas pelo dono; mudanças voltam para a aprovação
            if (statusOriginal == EspeciesPermitidas.StatusModeracao || statusOriginal == ModeracaoService.StatusRemovido) item.Status = statusOriginal;
            else if (item.Status == "Disponível" && !Consultas.PublicaDireto(AuthService.UsuarioLogado)) item.Status = EspeciesPermitidas.StatusModeracao;
            await ItemRepository.UpdateAsync(item);
            salvo = true;
            if (item.Status == EspeciesPermitidas.StatusModeracao) Analise.Mostrar("Item enviado para análise", "A edição do seu item", "no Bazar Solidário");
            else Toast.Sucesso("Item atualizado!");
            Nav.NavigateTo("/meus-pets?aba=itens");
        }
        catch (Exception ex) { Toast.Erro("Erro ao salvar: " + (ex.InnerException?.Message ?? ex.Message)); }
        finally { salvando = false; }
    }
}
