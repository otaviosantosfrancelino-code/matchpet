@page "/pets/detalhes/{Id:int}"
@inject IPetRepository PetRepository
@inject IInteresseRepository InteresseRepository
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>@(pet?.Nome ?? "Detalhes do pet") | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    @if (carregando)
    {
        <div class="row g-4">
            <div class="col-lg-7"><div class="skeleton" style="aspect-ratio:4/3;border-radius:22px"></div></div>
            <div class="col-lg-5"><div class="skeleton mb-3" style="height:48px;width:60%"></div><div class="skeleton" style="height:320px;border-radius:22px"></div></div>
        </div>
    }
    else if (pet == null)
    {
        <div class="estado-vazio mx-auto" style="max-width:560px">
            <div class="emoji">🐾</div>
            <h4>Pet não encontrado</h4>
            <p class="text-muted">Este anúncio pode ter sido removido pelo doador.</p>
            <a href="/pets" class="btn btn-primary">Voltar ao catálogo</a>
        </div>
    }
    else
    {
        <button class="btn btn-ghost px-2 mb-3" @onclick='() => Nav.NavigateTo("/pets")'>
            <i class="bi bi-arrow-left me-1"></i> Voltar ao catálogo
        </button>

        <div class="row g-4 g-lg-5">
            @* ===== FOTOS ===== *@
            <div class="col-lg-7">
                <div class="galeria mp-card overflow-hidden">
                    @if (pet.Imagens.Any())
                    {
                        <img src="@pet.Imagens[fotoAtual].Base64Data" class="img-cover" alt="Foto de @pet.Nome" />
                        @if (pet.Imagens.Count > 1)
                        {
                            <button class="seta esq" @onclick="() => MudarFoto(-1)" aria-label="Foto anterior"><i class="bi bi-chevron-left"></i></button>
                            <button class="seta dir" @onclick="() => MudarFoto(1)" aria-label="Próxima foto"><i class="bi bi-chevron-right"></i></button>
                            <span class="contador">@(fotoAtual + 1) / @pet.Imagens.Count</span>
                        }
                    }
                    else
                    {
                        <div class="foto-vazia"><span style="font-size:4rem">@PetCard.Emoji(pet.Especie)</span><span>Sem fotos</span></div>
                    }
                </div>
                @if (pet.Imagens.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3 overflow-auto pb-1">
                        @for (var i = 0; i < pet.Imagens.Count; i++)
                        {
                            var indice = i;
                            <button class="mini @(indice == fotoAtual ? "ativa" : "")" @onclick="() => fotoAtual = indice" aria-label="Ver foto @(indice + 1)">
                                <img src="@pet.Imagens[indice].Base64Data" alt="" />
                            </button>
                        }
                    </div>
                }
            </div>

            @* ===== INFORMAÇÕES ===== *@
            <div class="col-lg-5">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <h1 class="m-0 text-break" style="font-size:clamp(2rem,4vw,2.6rem)">@pet.Nome</h1>
                    @if (!string.IsNullOrEmpty(pet.Sexo))
                    {
                        <span class="tag @(pet.Sexo == "Macho" ? "azul" : "rosa") fs-6 px-3 py-2 flex-shrink-0">
                            <i class="bi @(pet.Sexo == "Macho" ? "bi-gender-male" : "bi-gender-female")"></i> @pet.Sexo
                        </span>
                    }
                </div>
                <p class="text-muted fw-semibold mb-4"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(pet.UsuarioDoador?.Cidade ?? "Franca"), @(pet.UsuarioDoador?.Estado ?? "SP")</p>

                <div class="row g-2 mb-4">
                    <div class="col-6"><div class="dado"><small>Espécie</small><b>@PetCard.Emoji(pet.Especie) @pet.Especie</b></div></div>
                    <div class="col-6"><div class="dado"><small>Raça</small><b>@pet.Raca</b></div></div>
                    <div class="col-6"><div class="dado"><small>Porte</small><b>@(string.IsNullOrEmpty(pet.Porte) ? "—" : pet.Porte)</b></div></div>
                    <div class="col-6"><div class="dado"><small>Idade</small><b>@PetCard.Idade(pet.Idade)</b></div></div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="tag @(pet.Castrado ? "verde" : "")">@(pet.Castrado ? "✂️ Castrado" : "Não castrado")</span>
                    <span class="tag @(pet.RecomendadoParaCriancas ? "verde" : "")">@(pet.RecomendadoParaCriancas ? "🍼 Gosta de crianças" : "Prefere adultos")</span>
                    <span class="tag @(!pet.PrecisaDeQuintal ? "verde" : "laranja")">@(pet.PrecisaDeQuintal ? "🌳 Precisa de quintal" : "🏢 Vive bem em apto.")</span>
                </div>

                <h6 class="fw-bold">Sobre @pet.Nome</h6>
                <p class="text-muted" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(pet.Descricao) ? "O doador ainda não escreveu uma descrição." : pet.Descricao)</p>

                @if (pet.UsuarioDoador != null)
                {
                    <div class="mp-card p-3 d-flex align-items-center gap-3 mb-4">
                        <Avatar Usuario="pet.UsuarioDoador" Tamanho="48" />
                        <div class="min-w-0">
                            <small class="text-muted">Anunciado por</small>
                            <div class="fw-bold text-dark text-truncate">@pet.UsuarioDoador.Nome</div>
                        </div>
                        @if (pet.UsuarioDoador.EhOng)
                        {
                            <span class="tag verde ms-auto"><i class="bi bi-patch-check-fill"></i>ONG</span>
                        }
                    </div>
                }

                <div class="acao-adotar">
                    @if (AuthService.UsuarioLogado != null && pet.UsuarioDoadorId == AuthService.UsuarioLogado.Id)
                    {
                        <div class="alert alert-info mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill"></i> Este anúncio é seu.
                            <a href="/pets/editar/@pet.Id" class="ms-auto fw-bold">Editar</a>
                        </div>
                    }
                    else if (pet.Status != "Disponível")
                    {
                        <div class="alert @(pet.Status == "Adotado" ? "alert-warning" : "alert-info") mb-0">
                            <i class="bi @(pet.Status == "Adotado" ? "bi-stars" : "bi-hourglass-split") me-2"></i>
                            @(pet.Status == "Adotado" ? "Este pet já encontrou um lar! 💛" : "Este pet já está em processo de adoção.")
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg w-100" @onclick="ValidarEAbrirModal">
                            <i class="bi bi-heart-fill me-2"></i>Quero adotar @pet.Nome
                        </button>
                        <p class="text-center text-muted small mt-2 mb-0"><i class="bi bi-shield-lock me-1"></i>Você assina um termo digital antes de receber o contato.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (exibirModal && pet != null)
{
    <div class="modal fade show d-block modal-blazor" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
            <div class="modal-content overflow-hidden">
                <div class="modal-header border-0 px-4 pt-4">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <span class="icone-bolha @(interesseRegistrado ? "verde" : "azul")" style="width:40px;height:40px;font-size:1.1rem"><i class="bi @(interesseRegistrado ? "bi-check2-circle" : "bi-file-earmark-text")"></i></span>
                        @(interesseRegistrado ? "Termo assinado!" : "Termo de responsabilidade")
                    </h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body px-4 pb-4" style="max-height: 72vh; overflow-y: auto;">
                    @if (!interesseRegistrado)
                    {
                        <div class="p-3 rounded-4 mb-3" style="background:#f8fafc;border:1px solid var(--mp-line);font-family:'Courier New',monospace;font-size:.85rem">
                            <pre class="mb-0" style="white-space: pre-wrap;">@textoContratoTemporario</pre>
                        </div>

                        <div class="alert alert-warning small">
                            <strong>Ao assinar, você declara que:</strong>
                            <ul class="mb-0 mt-1 ps-3">
                                <li>vai oferecer abrigo, alimentação e cuidados veterinários;</li>
                                <li>está ciente da Lei Sansão contra maus-tratos;</li>
                                <li>o animal não pertence à fauna silvestre ilícita (Lei 9.605/98).</li>
                            </ul>
                        </div>

                        <label class="opcao-card mb-3 @(leuClausulas ? "marcada" : "")">
                            <input type="checkbox" @bind="leuClausulas" />
                            <i class="bi @(leuClausulas ? "bi-check-square-fill text-primary" : "bi-square") fs-5"></i>
                            <span class="fw-semibold small">Li e concordo com o termo e as declarações acima.</span>
                        </label>

                        <button class="btn btn-primary btn-lg w-100" @onclick="AceitarERegistrar" disabled="@(!leuClausulas || registrando)">
                            @if (registrando) { <span class="spinner-border spinner-border-sm me-2"></span><span>Registrando...</span> }
                            else { <span><i class="bi bi-pen me-1"></i> Assinar e ver contato</span> }
                        </button>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <div class="display-3 mb-2">🎉</div>
                            <p class="fs-5 fw-bold text-dark mb-1">Pronto! O doador foi avisado.</p>
                            <p class="text-muted">Agora é só combinar a visita com <strong>@pet.UsuarioDoador?.Nome</strong>.</p>
                            <button class="btn btn-success btn-lg w-100 mt-2" @onclick="AbrirWhatsApp">
                                <i class="bi bi-whatsapp me-2"></i>Conversar no WhatsApp
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .galeria { position: relative; aspect-ratio: 4 / 3; border-radius: 22px; }
    .galeria .seta { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: none; background: rgba(255,255,255,.92); box-shadow: var(--mp-shadow); color: var(--mp-ink); font-size: 1.2rem; }
    .galeria .seta.esq { left: 14px; } .galeria .seta.dir { right: 14px; }
    .galeria .contador { position: absolute; bottom: 14px; right: 14px; background: rgba(15,23,42,.7); color: #fff; font-size: .8rem; font-weight: 700; padding: .25rem .6rem; border-radius: 999px; }
    .mini { width: 76px; height: 76px; border-radius: 14px; overflow: hidden; border: 3px solid transparent; padding: 0; flex-shrink: 0; background: none; opacity: .7; }
    .mini.ativa { border-color: var(--mp-primary); opacity: 1; }
    .mini img { width: 100%; height: 100%; object-fit: cover; }
    .dado { background: #fff; border: 1px solid var(--mp-line); border-radius: 14px; padding: .7rem .9rem; }
    .dado small { display: block; color: var(--mp-muted); font-size: .75rem; font-weight: 600; }
    .dado b { color: var(--mp-ink); }
    @@media (max-width: 991.98px) {
        /* No celular o botão de adotar fica sempre visível acima da barra inferior */
        .acao-adotar { position: sticky; bottom: calc(76px + env(safe-area-inset-bottom)); background: var(--mp-bg); padding: .75rem 0; z-index: 10; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private Pet? pet;
    private bool carregando = true;
    private int fotoAtual;
    private bool exibirModal, interesseRegistrado, registrando, leuClausulas;
    private string userIp = "";
    private string textoContratoTemporario = "";

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        fotoAtual = 0;
        pet = await PetRepository.GetByIdAsync(Id);
        userIp = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "IP Remoto";
        carregando = false;
    }

    private void MudarFoto(int passo)
    {
        if (pet == null || pet.Imagens.Count == 0) return;
        fotoAtual = (fotoAtual + passo + pet.Imagens.Count) % pet.Imagens.Count;
    }

    private void ValidarEAbrirModal()
    {
        if (AuthService.UsuarioLogado == null)
        {
            Toast.Info("Entre na sua conta para iniciar uma adoção.");
            Nav.NavigateTo("/login");
            return;
        }

        // Só quem teve o documento aprovado pode assinar o termo
        if (!AuthService.DocumentoAprovado)
        {
            Toast.Aviso("Por questões jurídicas, verifique seu documento no Perfil antes de adotar.");
            Nav.NavigateTo("/perfil");
            return;
        }

        textoContratoTemporario = GerarTextoContrato();
        leuClausulas = false;
        exibirModal = true;
    }

    private string GerarTextoContrato()
    {
        var adotante = AuthService.UsuarioLogado;
        var doador = pet?.UsuarioDoador;
        return $@"CONTRATO DE DOAÇÃO E ADOÇÃO DE ANIMAL DOMÉSTICO

DOADOR: {doador?.Nome} (Doc: {DocumentoUtil.Formatar(doador?.Documento)})
ADOTANTE: {adotante?.Nome} (Doc: {DocumentoUtil.Formatar(adotante?.Documento)})
LOCAL: {adotante?.Cidade}/{adotante?.Estado}

OBJETO: O animal de nome {pet?.Nome}, espécie {pet?.Especie}, raça {pet?.Raca}.

Pelo presente instrumento, o ADOTANTE assume a guarda do animal acima descrito, responsabilizando-se civil e criminalmente por seu bem-estar, saúde e integridade, em conformidade com a legislação vigente.

Assinado via IP: {userIp} em {DateTime.Now:dd/MM/yyyy HH:mm}";
    }

    private void FecharModal() { exibirModal = false; interesseRegistrado = false; }

    private async Task AceitarERegistrar()
    {
        if (registrando || pet == null || AuthService.UsuarioLogado == null) return;
        registrando = true;
        try
        {
            await InteresseRepository.AddAsync(new InteresseAdocao
            {
                PetId = pet.Id,
                UsuarioInteressadoId = AuthService.UsuarioLogado.Id,
                DataInteresse = DateTime.UtcNow,
                TermoAceito = true,
                IpUsuario = userIp,
                ContratoGerado = textoContratoTemporario
            });

            // O pet sai do catálogo até o doador finalizar ou reabrir o anúncio
            await PetRepository.AtualizarStatusAsync(pet.Id, "Em Processo");
            pet.Status = "Em Processo";
            interesseRegistrado = true;
        }
        catch (Exception ex)
        {
            Toast.Erro("Não foi possível registrar o termo: " + (ex.InnerException?.Message ?? ex.Message));
        }
        finally { registrando = false; }
    }

    private async Task AbrirWhatsApp()
    {
        if (pet?.UsuarioDoador == null) return;
        var fone = new string(pet.UsuarioDoador.Telefone.Where(char.IsDigit).ToArray());
        var texto = $"Olá! Acabei de assinar o termo no *Match-Pet SP* para adotar o(a) *{pet.Nome}*! Podemos combinar a visita?";
        await JS.InvokeVoidAsync("open", $"https://wa.me/55{fone}?text={Uri.EscapeDataString(texto)}", "_blank");
        FecharModal();
    }
}
