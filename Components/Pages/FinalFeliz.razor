@page "/final-feliz"
@using crudcomdb.Interfaces
@using crudcomdb.Models
@inject IPetRepository PetRepository

<div class="container py-4 text-center">
    <div class="mb-5">
        <h1 class="fw-bold text-warning display-4"><i class="bi bi-stars"></i> Galeria Final Feliz</h1>
        <p class="text-muted">Estes amiguinhos já encontraram um lar e agora são muito amados.</p>
    </div>

    @if (petsAdotados == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-warning"></div></div>
    }
    else if (!petsAdotados.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">Nossa galeria está começando. Que tal ser o próximo a adotar?</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var pet in petsAdotados)
            {
                <div class="col-md-3">
                    <div class="card-portal p-2 bg-white shadow-sm border-0 transform-hover">
                        <div class="rounded-4 overflow-hidden" style="height: 250px;">
                            <img src="@(pet.Imagens.FirstOrDefault()?.Base64Data)" class="w-100 h-100" style="object-fit: cover; filter: sepia(0.2);">
                        </div>
                        <h6 class="mt-3 fw-bold text-dark mb-1">@pet.Nome</h6>
                        <span class="badge bg-warning text-dark rounded-pill px-3">ADOTADO</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Pet>? petsAdotados;
    protected override async Task OnInitializedAsync() => petsAdotados = await PetRepository.GetAdoptedPetsAsync();
}

<style>
    .transform-hover { transition: transform 0.3s ease; }
    .transform-hover:hover { transform: translateY(-10px) rotate(2deg); }
</style>