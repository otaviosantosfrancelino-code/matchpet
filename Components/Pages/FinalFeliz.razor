@page "/final-feliz"
@inject IPetRepository PetRepository

<PageTitle>Final Feliz | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="text-center mb-5">
        <div class="display-4 mb-2">💛</div>
        <h1 style="font-size:clamp(2rem,4vw,2.8rem)">Galeria Final Feliz</h1>
        <p class="text-muted mx-auto" style="max-width:520px">Estes amigos já encontraram um lar e hoje são muito amados.</p>
        @if (petsAdotados?.Any() == true)
        {
            <span class="tag laranja fs-6 px-3 py-2">🎉 @petsAdotados.Count() @(petsAdotados.Count() == 1 ? "adoção concluída" : "adoções concluídas")</span>
        }
    </div>

    @if (petsAdotados == null)
    {
        <CardsCarregando />
    }
    else if (!petsAdotados.Any())
    {
        <div class="estado-vazio mx-auto" style="max-width:560px">
            <div class="emoji">🏡</div>
            <p class="text-muted">Nossa galeria está começando. Que tal ser o próximo a adotar?</p>
            <a href="/pets" class="btn btn-primary">Ver pets disponíveis</a>
        </div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var pet in petsAdotados)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="polaroid">
                        <div class="foto">
                            @if (pet.Imagens.Any()) { <img src="@pet.Imagens.First().Base64Data" class="img-cover" alt="Foto de @pet.Nome" loading="lazy" /> }
                            else { <div class="foto-vazia"><span style="font-size:2.5rem">💛</span></div> }
                        </div>
                        <div class="legenda">
                            <b>@pet.Nome</b>
                            <span>adotado 🏡</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="/pets" class="btn btn-primary btn-lg">Quero escrever a próxima história</a>
        </div>
    }
</div>

<style>
    .polaroid { background: #fff; padding: 10px 10px 0; border-radius: 6px; box-shadow: var(--mp-shadow); transition: transform .3s ease; }
    .polaroid:hover { transform: translateY(-8px) rotate(-1.5deg); }
    .col-6:nth-child(even) .polaroid:hover { transform: translateY(-8px) rotate(1.5deg); }
    .polaroid .foto { aspect-ratio: 1; overflow: hidden; border-radius: 3px; }
    .polaroid .foto img { filter: saturate(1.05) contrast(1.02); }
    .polaroid .legenda { display: flex; justify-content: space-between; align-items: center; padding: .7rem .2rem .85rem; gap: .5rem; }
    .polaroid .legenda b { color: var(--mp-ink); font-size: 1.05rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .polaroid .legenda span { font-size: .8rem; color: var(--mp-muted); font-weight: 600; white-space: nowrap; }
</style>

@code {
    private IEnumerable<Pet>? petsAdotados;
    protected override async Task OnInitializedAsync() => petsAdotados = await PetRepository.GetAdoptedPetsAsync();
}
