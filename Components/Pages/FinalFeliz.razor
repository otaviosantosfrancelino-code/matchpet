@page "/final-feliz"
@using crudcomdb.Interfaces
@using crudcomdb.Models
@inject IPetRepository PetRepository

<PageTitle>Final Feliz | Match-Pet SP</PageTitle>

<div class="container py-4 text-center">
    <div class="mb-5">
        <h1 class="fw-bold text-warning display-4"><i class="bi bi-stars"></i> Galeria Final Feliz</h1>
        <p class="text-muted">Estes amiguinhos já encontraram um lar e agora são muito amados.</p>
        @if (petsAdotados != null && petsAdotados.Any())
        {
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6">💛 @petsAdotados.Count() @(petsAdotados.Count() == 1 ? "adoção concluída" : "adoções concluídas")</span>
        }
    </div>

    @if (petsAdotados == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-warning"></div></div>
    }
    else if (!petsAdotados.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm p-4 mx-auto" style="max-width: 600px;">
            <i class="bi bi-house-heart fs-1 text-warning"></i>
            <p class="text-muted mt-3">Nossa galeria está começando. Que tal ser o próximo a adotar?</p>
            <a href="/pets" class="btn btn-primary rounded-pill px-4 fw-bold">Ver pets disponíveis</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var pet in petsAdotados)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card-portal p-2 bg-white shadow-sm border-0 transform-hover h-100">
                        <div class="rounded-4 overflow-hidden foto-final-feliz">
                            @if (pet.Imagens.Any())
                            {
                                <img src="@pet.Imagens.First().Base64Data" class="img-cover" style="filter: sepia(0.2);" alt="Foto de @pet.Nome" loading="lazy">
                            }
                            else
                            {
                                <div class="foto-vazia"><i class="bi bi-heart-fill fs-1 text-warning"></i></div>
                            }
                        </div>
                        <h6 class="mt-3 fw-bold text-dark mb-1 text-truncate">@pet.Nome</h6>
                        <span class="badge bg-warning text-dark rounded-pill px-3">ADOTADO</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Pet>? petsAdotados;
    protected override async Task OnInitializedAsync() => petsAdotados = await PetRepository.GetAdoptedPetsAsync();
}

<style>
    .foto-final-feliz { height: 250px; }
    @@media (max-width: 576px) { .foto-final-feliz { height: 170px; } }
    .transform-hover { transition: transform 0.3s ease; }
    .transform-hover:hover { transform: translateY(-10px) rotate(2deg); }
</style>
