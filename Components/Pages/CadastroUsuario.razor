@page "/cadastro"
@inject IUsuarioRepository UsuarioRepository
@inject AuthService AuthService
@inject CnpjService CnpjService
@inject EmailService EmailService
@inject NavigationManager Nav
@inject ToastService Toast
@inject IHttpClientFactory HttpFactory

<PageTitle>Criar conta | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 760px;">
    <div class="text-center mb-4">
        <div class="icone-bolha azul mx-auto mb-3"><i class="bi bi-person-plus"></i></div>
        <h1 class="h2 mb-1">Crie sua conta</h1>
        <p class="text-muted">Leva 1 minuto. Sua identificação protege você e os animais.</p>
    </div>

    <div class="mp-card p-3 p-sm-4 p-md-5">
        @if (!string.IsNullOrEmpty(mensagemErroGeral))
        {
            <div class="alert alert-danger small"><i class="bi bi-exclamation-triangle-fill me-1"></i> @mensagemErroGeral</div>
        }

        <EditForm Model="@novoUsuario" OnValidSubmit="RealizarCadastro">
            <DataAnnotationsValidator />

            <div class="segmentos w-100 mb-4">
                <button type="button" class="flex-fill @(!ehOng ? "ativo" : "")" @onclick="() => MudarTipo(false)"><i class="bi bi-person"></i> Pessoa física</button>
                <button type="button" class="flex-fill @(ehOng ? "ativo" : "")" @onclick="() => MudarTipo(true)"><i class="bi bi-building"></i> <span class="d-none d-sm-inline">ONG / Instituição</span><span class="d-sm-none">ONG</span></button>
            </div>

            <div class="secao-form mt-0">@(ehOng ? "Dados da instituição" : "Seus dados")</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@(ehOng ? "CNPJ" : "CPF")</label>
                    <div class="position-relative">
                        <InputText class="form-control" inputmode="numeric" placeholder="@(ehOng ? "00.000.000/0000-00" : "000.000.000-00")"
                                   @bind-Value="novoUsuario.Documento" @onblur="ValidarDocumento" />
                        @if (consultandoCnpj) { <span class="spinner-border spinner-border-sm text-primary position-absolute" style="right:12px;top:14px"></span> }
                    </div>
                    @if (!string.IsNullOrEmpty(avisoDocumento))
                    {
                        <div class="small fw-semibold mt-1 @(documentoOk ? "text-success" : "text-danger")">
                            <i class="bi @(documentoOk ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>@avisoDocumento
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">Telefone / WhatsApp</label>
                    <InputText class="form-control" inputmode="tel" placeholder="(16) 99999-9999" @bind-Value="novoUsuario.Telefone" />
                    <ValidationMessage For="@(() => novoUsuario.Telefone)" />
                </div>
                <div class="col-12">
                    <label class="form-label">@(ehOng ? "Razão social ou nome da ONG" : "Nome completo")</label>
                    <InputText class="form-control" placeholder="@(ehOng ? "Preenchido automaticamente pelo CNPJ" : "Como está no seu documento")" @bind-Value="novoUsuario.Nome" />
                    <div class="form-text">Use o nome igual ao do documento: ele será conferido na verificação.</div>
                    <ValidationMessage For="@(() => novoUsuario.Nome)" />
                </div>

                @if (ehOng)
                {
                    <div class="col-12">
                        <label class="form-label">Chave Pix para doações <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputText class="form-control" placeholder="CNPJ, e-mail, telefone ou chave aleatória" @bind-Value="novoUsuario.ChavePix" />
                    </div>
                }
            </div>

            <div class="secao-form">Endereço</div>
            <div class="row g-3">
                <div class="col-sm-5 col-md-4">
                    <label class="form-label">CEP</label>
                    <div class="input-group">
                        <InputText class="form-control" inputmode="numeric" placeholder="14400-000" @bind-Value="novoUsuario.CEP" @onblur="ConsultarCEP" />
                        <button class="btn btn-light border" type="button" @onclick="ConsultarCEP" aria-label="Buscar CEP" disabled="@buscandoCep">
                            @if (buscandoCep) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-search"></i> }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(mensagemCep)) { <div class="small text-danger mt-1">@mensagemCep</div> }
                </div>
                <div class="col-sm-7 col-md-8">
                    <label class="form-label">Rua</label>
                    <InputText class="form-control" @bind-Value="novoUsuario.Logradouro" />
                </div>
                <div class="col-4 col-md-3">
                    <label class="form-label">Nº</label>
                    <InputText class="form-control" @bind-Value="novoUsuario.Numero" />
                </div>
                <div class="col-8 col-md-4">
                    <label class="form-label">Bairro</label>
                    <InputText class="form-control" @bind-Value="novoUsuario.Bairro" />
                </div>
                <div class="col-8 col-md-3">
                    <label class="form-label">Cidade</label>
                    <InputText class="form-control" @bind-Value="novoUsuario.Cidade" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label">UF</label>
                    <InputText class="form-control text-uppercase" maxlength="2" @bind-Value="novoUsuario.Estado" />
                </div>
            </div>

            <div class="secao-form">Acesso</div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">E-mail</label>
                    <InputText type="email" class="form-control" autocomplete="email" placeholder="voce@email.com" @bind-Value="novoUsuario.Email" />
                    <div class="form-text">Usado para entrar e para recuperar a senha.</div>
                    <ValidationMessage For="@(() => novoUsuario.Email)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Senha</label>
                    <input type="password" class="form-control" autocomplete="new-password" @bind="senha" @bind:event="oninput" />
                    <ForcaSenha Senha="@senha" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Confirme a senha</label>
                    <input type="password" class="form-control" autocomplete="new-password" @bind="confirmarSenha" />
                </div>
            </div>

            <label class="opcao-card mt-4 @(novoUsuario.AceitouTermos ? "marcada" : "")">
                <input type="checkbox" @bind="novoUsuario.AceitouTermos" />
                <i class="bi @(novoUsuario.AceitouTermos ? "bi-check-square-fill text-primary" : "bi-square") fs-5"></i>
                <span class="small">Li e concordo com os <strong>Termos de Uso</strong> e com o tratamento dos meus dados conforme a <strong>LGPD</strong> para formalização de adoções.</span>
            </label>

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-4" disabled="@processando">
                @if (processando) { <span class="spinner-border spinner-border-sm me-2"></span><span>Criando conta...</span> }
                else { <span>Criar minha conta</span> }
            </button>

            <p class="text-center text-muted mt-3 mb-0">Já tem conta? <a href="/login" class="fw-bold">Entrar</a></p>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter(Name = "IpCliente")] public string IpCliente { get; set; } = "";
    private Usuario novoUsuario = new();
    private string senha = "", confirmarSenha = "";
    private bool ehOng, processando, buscandoCep, consultandoCnpj, documentoOk;
    private string mensagemErroGeral = "", mensagemCep = "", avisoDocumento = "";
    private CnpjService.DadosCnpj? dadosCnpj;

    private void MudarTipo(bool ong)
    {
        ehOng = ong;
        novoUsuario.Documento = "";
        avisoDocumento = "";
        dadosCnpj = null;
    }

    // Confere os dígitos verificadores do CPF/CNPJ e, se for CNPJ, consulta a Receita Federal
    private async Task ValidarDocumento()
    {
        avisoDocumento = "";
        documentoOk = false;
        var doc = novoUsuario.Documento ?? "";
        if (string.IsNullOrWhiteSpace(doc)) return;

        if (ehOng ? !DocumentoUtil.CnpjValido(doc) : !DocumentoUtil.CpfValido(doc))
        {
            avisoDocumento = ehOng ? "CNPJ inválido. Confira os números." : "CPF inválido. Confira os números.";
            return;
        }
        novoUsuario.Documento = DocumentoUtil.Formatar(doc);

        if (await UsuarioRepository.GetByDocumentoAsync(doc) != null)
        {
            avisoDocumento = "Este documento já tem uma conta. Use \"Esqueci minha senha\" se não lembrar o acesso.";
            return;
        }

        documentoOk = true;
        avisoDocumento = ehOng ? "CNPJ válido." : "CPF válido.";

        if (ehOng)
        {
            consultandoCnpj = true;
            StateHasChanged();
            try
            {
                dadosCnpj = await CnpjService.ConsultarAsync(doc);
                if (dadosCnpj == null)
                {
                    documentoOk = false;
                    avisoDocumento = "CNPJ não encontrado na Receita Federal.";
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(novoUsuario.Nome)) novoUsuario.Nome = dadosCnpj.RazaoSocial;
                    if (!string.IsNullOrWhiteSpace(dadosCnpj.Cidade)) { novoUsuario.Cidade = dadosCnpj.Cidade; novoUsuario.Estado = dadosCnpj.Uf; }
                    documentoOk = dadosCnpj.Ativo;
                    avisoDocumento = !dadosCnpj.Ativo
                        ? $"CNPJ com situação \"{dadosCnpj.Situacao}\" na Receita. Só CNPJs ativos podem ser cadastrados como ONG."
                        : $"CNPJ ativo: {dadosCnpj.RazaoSocial}" + (dadosCnpj.SemFinsLucrativos ? " (entidade sem fins lucrativos)" : "");
                }
            }
            catch
            {
                avisoDocumento = "CNPJ válido. Não foi possível consultar a Receita agora; a conferência será feita depois.";
                dadosCnpj = null;
            }
            finally { consultandoCnpj = false; }
        }
    }

    private async Task ConsultarCEP()
    {
        mensagemCep = "";
        var cep = new string((novoUsuario.CEP ?? "").Where(char.IsDigit).ToArray());
        if (cep.Length == 0 || buscandoCep) return;
        if (cep.Length != 8) { mensagemCep = "O CEP deve ter 8 números."; return; }

        buscandoCep = true;
        try
        {
            var http = HttpFactory.CreateClient();
            http.Timeout = TimeSpan.FromSeconds(8);
            var dados = await http.GetFromJsonAsync<ViaCEPResponse>($"https://viacep.com.br/ws/{cep}/json/");
            if (dados != null && dados.Erro == null)
            {
                novoUsuario.CEP = $"{cep[..5]}-{cep[5..]}";
                novoUsuario.Logradouro = dados.Logradouro;
                novoUsuario.Bairro = dados.Bairro;
                novoUsuario.Cidade = dados.Localidade;
                novoUsuario.Estado = dados.Uf;
            }
            else mensagemCep = "CEP não encontrado. Preencha o endereço manualmente.";
        }
        catch { mensagemCep = "Não foi possível consultar o CEP agora. Preencha manualmente."; }
        finally { buscandoCep = false; }
    }

    private async Task RealizarCadastro()
    {
        if (processando) return;
        mensagemErroGeral = "";

        // Validações antes de ir ao banco
        var doc = novoUsuario.Documento ?? "";
        if (ehOng ? !DocumentoUtil.CnpjValido(doc) : !DocumentoUtil.CpfValido(doc)) { mensagemErroGeral = ehOng ? "Informe um CNPJ válido." : "Informe um CPF válido."; return; }
        if (ehOng && dadosCnpj is { Ativo: false }) { mensagemErroGeral = "O CNPJ informado não está ativo na Receita Federal."; return; }
        if (novoUsuario.Nome.Trim().Length < 3 || (!ehOng && !novoUsuario.Nome.Trim().Contains(' '))) { mensagemErroGeral = "Informe o nome completo."; return; }
        if (new string(novoUsuario.Telefone.Where(char.IsDigit).ToArray()).Length < 10) { mensagemErroGeral = "Informe um telefone com DDD."; return; }
        if (!ForcaSenha.SenhaAceitavel(senha)) { mensagemErroGeral = "A senha precisa ter pelo menos 8 caracteres, com letras e números."; return; }
        if (senha != confirmarSenha) { mensagemErroGeral = "As senhas não coincidem."; return; }
        if (!novoUsuario.AceitouTermos) { mensagemErroGeral = "Você precisa aceitar os Termos e a LGPD para criar a conta."; return; }

        processando = true;
        try
        {
            // Duplicidade (e-mail ignora maiúsculas; documento ignora pontuação)
            if (await UsuarioRepository.GetByEmailAsync(novoUsuario.Email) != null) { mensagemErroGeral = "Este e-mail já está cadastrado."; return; }
            if (await UsuarioRepository.GetByDocumentoAsync(doc) != null) { mensagemErroGeral = "Este CPF/CNPJ já possui uma conta."; return; }

            novoUsuario.Nome = novoUsuario.Nome.Trim();
            novoUsuario.Email = novoUsuario.Email.Trim().ToLower();
            novoUsuario.Documento = DocumentoUtil.Formatar(doc);
            novoUsuario.Estado = (novoUsuario.Estado ?? "SP").Trim().ToUpper();
            novoUsuario.Senha = SenhaService.GerarHash(senha);
            novoUsuario.EhOng = ehOng;
            if (ehOng && dadosCnpj != null)
                novoUsuario.DescricaoOng = string.IsNullOrWhiteSpace(dadosCnpj.NomeFantasia) ? null : $"Nome fantasia: {dadosCnpj.NomeFantasia}";
            novoUsuario.IpAceite = IpCliente;
            novoUsuario.DataAceiteTermos = DateTime.UtcNow;
            novoUsuario.DataCadastro = DateTime.UtcNow;
            novoUsuario.EmailConfirmado = true;
            novoUsuario.CodigoConfirmacao = "ISENTO";
            novoUsuario.StatusValidacaoDocumento = "Pendente";

            await UsuarioRepository.AddAsync(novoUsuario);
            await AuthService.LoginAsync(novoUsuario);

            // E-mail de boas-vindas (se o envio não estiver configurado, só fica registrado no log)
            var nome = novoUsuario.Nome.Split(' ')[0];
            _ = EmailService.EnviarAsync(novoUsuario.Email, novoUsuario.Nome, "Bem-vindo(a) ao Match-Pet SP! 🐾",
                EmailService.Modelo($"Olá, {System.Net.WebUtility.HtmlEncode(nome)}!",
                    "<p>Sua conta foi criada. Agora falta só um passo: <b>verificar seu documento</b> no Perfil para poder adotar, anunciar e assinar termos.</p><p>Qualquer dúvida, é só responder este e-mail.</p>",
                    "Verificar meu documento", Nav.ToAbsoluteUri("/perfil").ToString()));

            Toast.Sucesso("Conta criada! Último passo: verifique seu documento para poder adotar.");
            Nav.NavigateTo("/perfil");
        }
        catch (Exception ex)
        {
            mensagemErroGeral = "Erro ao salvar: " + (ex.InnerException?.Message ?? ex.Message);
        }
        finally { processando = false; }
    }

    public class ViaCEPResponse
    {
        public string Logradouro { get; set; } = "";
        public string Bairro { get; set; } = "";
        public string Localidade { get; set; } = "";
        public string Uf { get; set; } = "";
        public object? Erro { get; set; } // a ViaCEP manda "erro": true (ou "true") quando o CEP não existe
    }
}
