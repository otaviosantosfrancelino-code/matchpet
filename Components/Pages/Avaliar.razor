@page "/avaliar"
@inject AuthService AuthService
@inject QuestionariosService Questionarios
@inject LimiteTentativasService Limite
@inject ToastService Toast

<PageTitle>Avalie o Match-Pet | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 820px;">
    <div class="text-center mb-4">
        <span class="eyebrow"><i class="bi bi-clipboard-data"></i> Pesquisa de usabilidade</span>
        <h1 class="secao-titulo mt-2">O que você achou do Match-Pet?</h1>
        <p class="text-muted mb-0">São 10 afirmações rápidas (1 minuto). Usamos o questionário padronizado <b>SUS – System Usability Scale</b>, e as respostas ajudam a melhorar o site e fazem parte da avaliação do nosso TCC. 💛</p>
    </div>

    @if (pontuacao != null)
    {
        <div class="mp-card p-4 p-md-5 text-center">
            <div class="display-4 mb-2">🎉</div>
            <h2 class="h4">Obrigado pela avaliação!</h2>
            <p class="text-muted">Sua nota para o Match-Pet foi <b class="text-dark">@pontuacao.Value.ToString("0.0")</b> de 100 (<b>@Sus.Classificar(pontuacao.Value)</b>).</p>
            <a href="/pets" class="btn btn-primary">Continuar navegando</a>
        </div>
    }
    else if (jaAvaliou)
    {
        <div class="estado-vazio"><div class="emoji">✅</div><h5>Você já avaliou o Match-Pet</h5><p class="text-muted mb-0">Muito obrigado por participar da pesquisa!</p></div>
    }
    else
    {
        <form class="mp-card p-3 p-md-5" @onsubmit="Enviar" @onsubmit:preventDefault>
            @if (AuthService.UsuarioLogado?.EhOng != true)
            {
                <fieldset class="mb-4">
                    <legend class="form-label fw-bold">Como você usa o Match-Pet?</legend>
                    <div class="row g-2">
                        @foreach (var (v, emoji) in new[] { ("Adotante", "🏡"), ("Doador", "🎁"), ("ONG", "🏢"), ("Visitante", "👀") })
                        {
                            <div class="col-6 col-md-3">
                                <label class="opcao-card flex-column text-center justify-content-center @(perfil == v ? "marcada" : "")">
                                    <input type="radio" name="perfil" checked="@(perfil == v)" @onchange="() => perfil = v" />
                                    <span class="emoji">@emoji</span><span class="small fw-semibold">@(v == "Doador" ? "Doador(a)" : v)</span>
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            }

            <div class="legenda-sus small text-muted mb-2" aria-hidden="true"><span>Discordo totalmente</span><span>Concordo totalmente</span></div>
            <ol class="lista-perguntas">
                @for (var i = 0; i < 10; i++)
                {
                    var indice = i;
                    <li>
                        <fieldset>
                            <legend class="pergunta">@Sus.Perguntas[indice]</legend>
                            <div class="escala" role="radiogroup">
                                @for (var n = 1; n <= 5; n++)
                                {
                                    var nota = n;
                                    <label class="nota @(notas[indice] == nota ? "marcada" : "")" title="@Rotulo(nota)">
                                        <input type="radio" name="p@(indice)" checked="@(notas[indice] == nota)" @onchange="() => notas[indice] = nota" aria-label="@Rotulo(nota)" />
                                        @nota
                                    </label>
                                }
                            </div>
                        </fieldset>
                    </li>
                }
            </ol>

            <label class="form-label mt-3" for="comentario">Quer deixar um comentário ou sugestão? (opcional)</label>
            <textarea id="comentario" class="form-control" rows="3" maxlength="800" @bind="comentario" placeholder="O que mais gostou? O que podemos melhorar?"></textarea>

            <div class="d-flex align-items-center gap-3 mt-4 flex-wrap">
                <button type="submit" class="btn btn-primary btn-lg" disabled="@(enviando || notas.Any(n => n == 0))">
                    @if (enviando) { <span class="spinner-border spinner-border-sm me-2"></span> } Enviar avaliação
                </button>
                <span class="small text-muted">@notas.Count(n => n > 0) de 10 respondidas</span>
            </div>
            <p class="small text-muted mt-3 mb-0"><i class="bi bi-incognito me-1"></i>A pesquisa é anônima: guardamos só as notas, o perfil de uso e o comentário.</p>
        </form>
    }
</div>

<style>
    .lista-perguntas { padding-left: 1.3rem; margin: 0; }
    .lista-perguntas li { padding: .9rem 0; border-bottom: 1px solid var(--mp-line); }
    .lista-perguntas .pergunta { font-size: .98rem; font-weight: 600; color: var(--mp-ink); margin-bottom: .6rem; float: none; }
    .escala { display: grid; grid-template-columns: repeat(5, 1fr); gap: .4rem; max-width: 420px; }
    .escala .nota { display: flex; align-items: center; justify-content: center; height: 44px; border: 1.5px solid var(--mp-line); border-radius: 12px; font-weight: 800; cursor: pointer; background: var(--mp-surface); color: var(--mp-text); transition: all .15s; margin: 0; }
    .escala .nota:hover { border-color: #93c5fd; }
    .escala .nota.marcada { background: var(--mp-primary); border-color: var(--mp-primary); color: #fff; }
    .escala input { position: absolute; opacity: 0; pointer-events: none; }
    .legenda-sus { display: flex; justify-content: space-between; max-width: 420px; margin-left: 1.3rem; }
</style>

@code {
    [CascadingParameter(Name = "IpCliente")] public string IpCliente { get; set; } = "";
    private readonly int[] notas = new int[10];
    private string perfil = "Visitante";
    private string? comentario;
    private double? pontuacao;
    private bool enviando, jaAvaliou;

    private static string Rotulo(int n) => n switch { 1 => "1 - Discordo totalmente", 2 => "2 - Discordo", 3 => "3 - Neutro", 4 => "4 - Concordo", _ => "5 - Concordo totalmente" };

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.UsuarioLogado is { } u)
        {
            perfil = u.EhOng ? "ONG" : "Adotante";
            try { jaAvaliou = await Questionarios.JaAvaliouAsync(u.Id); } catch { }
        }
    }

    private async Task Enviar()
    {
        if (enviando || notas.Any(n => n == 0)) return;
        // Evita que alguém encha a pesquisa de respostas falsas: até 3 por conexão por dia
        var chave = "sus:" + IpCliente;
        if (!AuthService.EstaLogado && Limite.Bloqueio(chave, 3, TimeSpan.FromDays(1)) != null)
        {
            Toast.Aviso("Recebemos várias avaliações desta conexão hoje. Obrigado!");
            return;
        }
        enviando = true;
        try
        {
            pontuacao = await Questionarios.RegistrarAvaliacaoAsync(AuthService.UsuarioLogado?.Id, perfil, notas, comentario);
            Limite.Registrar(chave);
        }
        catch { Toast.Erro("Não foi possível enviar agora. Tente novamente."); }
        finally { enviando = false; }
    }
}
