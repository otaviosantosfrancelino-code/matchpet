@page "/ongs"
@inject IPetRepository PetRepository
@inject IUsuarioRepository UsuarioRepository
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>ONGs parceiras | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="banner-ong mb-5">
        <div>
            <span class="eyebrow text-white-50"><i class="bi bi-building-check"></i> Instituições parceiras</span>
            <h1 class="text-white mt-2">Quem cuida, merece apoio</h1>
            <p class="mb-0">Conheça as ONGs de proteção animal da região. Adote, doe pelo Pix ou leve ração e acessórios.</p>
        </div>
        <span class="emoji d-none d-md-block">🏡</span>
    </div>

    <h2 class="h4 mb-3">Instituições cadastradas</h2>
    @if (ongsList == null)
    {
        <CardsCarregando Quantidade="3" Colunas="col-md-6 col-lg-4" />
    }
    else if (!ongsList.Any())
    {
        <div class="estado-vazio"><div class="emoji">🏢</div><p class="text-muted mb-0">Nenhuma ONG cadastrada ainda.</p></div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var ong in ongsList)
            {
                var selecionada = ongSelecionadaId == ong.Id;
                <div class="col-md-6 col-lg-4">
                    <div class="mp-card mp-card-hover p-4 h-100 d-flex flex-column @(selecionada ? "border-success" : "")" style="@(selecionada ? "box-shadow:0 0 0 3px rgba(22,163,74,.25)" : "")">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <Avatar Usuario="ong" Tamanho="58" />
                            <div class="min-w-0">
                                <h3 class="h6 mb-1 text-truncate" title="@ong.Nome">@ong.Nome</h3>
                                @if (ong.StatusValidacaoDocumento == "Aprovado")
                                {
                                    <span class="tag verde"><i class="bi bi-patch-check-fill"></i> Verificada</span>
                                }
                                else
                                {
                                    <span class="tag">ONG</span>
                                }
                            </div>
                        </div>
                        <p class="small text-muted texto-2-linhas mb-3">@(string.IsNullOrWhiteSpace(ong.DescricaoOng) ? "Instituição de proteção e amparo animal." : ong.DescricaoOng)</p>
                        <p class="small text-muted mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@ong.Cidade / @ong.Estado</p>
                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn btn-sm flex-grow-1 @(selecionada ? "btn-success" : "btn-light")" @onclick="() => FiltrarPorOng(ong)">
                                <i class="bi bi-search me-1"></i>@(selecionada ? "Mostrando pets" : "Ver pets")
                            </button>
                            <button class="btn btn-accent btn-sm px-3" @onclick="() => ongModal = ong"><i class="bi bi-heart-fill me-1"></i>Apoiar</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3 flex-wrap gap-2" id="pets-ong">
        <h2 class="h4 m-0">@(ongSelecionadaId == null ? "Pets das instituições" : $"Pets de {nomeOngSelecionada}")</h2>
        @if (ongSelecionadaId != null)
        {
            <button class="btn btn-light btn-sm" @onclick="LimparFiltroOng"><i class="bi bi-x-circle me-1"></i>Ver de todas</button>
        }
    </div>

    @if (petsOng == null)
    {
        <CardsCarregando Quantidade="4" />
    }
    else if (!petsOng.Any())
    {
        <div class="estado-vazio"><div class="emoji">🐾</div><p class="text-muted mb-0">Nenhum pet disponível @(ongSelecionadaId == null ? "nas instituições" : "nesta instituição") no momento.</p></div>
    }
    else
    {
        <div class="row g-3 g-md-4">
            @foreach (var pet in petsOng)
            {
                <div class="col-6 col-md-4 col-lg-3"><PetCard Pet="pet" /></div>
            }
        </div>
    }
</div>

@if (ongModal is { } o)
{
    <div class="modal fade show d-block modal-blazor" tabindex="-1" role="dialog" aria-modal="true" @onclick="() => ongModal = null">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <Avatar Usuario="o" Tamanho="48" />
                    <div class="min-w-0"><small class="text-muted">Apoiar</small><h5 class="mb-0 text-truncate">@o.Nome</h5></div>
                    <button type="button" class="btn-close ms-auto" aria-label="Fechar" @onclick="() => ongModal = null"></button>
                </div>

                @if (!string.IsNullOrWhiteSpace(o.ChavePix))
                {
                    <label class="form-label small"><i class="bi bi-qr-code me-1"></i>Chave Pix para doação em dinheiro</label>
                    <div class="input-group mb-1">
                        <input type="text" class="form-control fw-bold" readonly value="@o.ChavePix" />
                        <button class="btn btn-primary" type="button" @onclick="() => CopiarPix(o.ChavePix!)"><i class="bi bi-clipboard me-1"></i>Copiar</button>
                    </div>
                    <small class="text-muted">Cole no aplicativo do seu banco, na opção Pix.</small>
                }
                else
                {
                    <div class="alert alert-info small mb-0">Esta ONG ainda não cadastrou uma chave Pix. Fale com ela pelo WhatsApp.</div>
                }

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-success" @onclick="() => ContatarWhatsAppOng(o)"><i class="bi bi-whatsapp me-2"></i>Combinar doação de ração / itens</button>
                    <a href="/pets/novo?tipo=item" class="btn btn-light">Anunciar no Bazar Solidário</a>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .banner-ong { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-radius: 26px; padding: clamp(1.75rem, 4vw, 3rem); color: rgba(255,255,255,.9); background: linear-gradient(135deg, #16a34a, #0d9488 60%, #0e7490); }
    .banner-ong h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
    .banner-ong .emoji { font-size: 6rem; line-height: 1; }
</style>

@code {
    private List<Usuario>? ongsList;
    private IEnumerable<Pet>? petsOng;
    private int? ongSelecionadaId;
    private string nomeOngSelecionada = "";
    private Usuario? ongModal;

    protected override async Task OnInitializedAsync()
    {
        ongsList = await UsuarioRepository.GetOngsAsync();
        petsOng = await PetRepository.GetNgoPetsAsync();
    }

    private async Task FiltrarPorOng(Usuario ong)
    {
        if (ongSelecionadaId == ong.Id) { await LimparFiltroOng(); return; }
        ongSelecionadaId = ong.Id;
        nomeOngSelecionada = ong.Nome;
        petsOng = null;
        petsOng = await PetRepository.GetNgoPetsAsync(ong.Id);
    }

    private async Task LimparFiltroOng()
    {
        ongSelecionadaId = null;
        nomeOngSelecionada = "";
        petsOng = await PetRepository.GetNgoPetsAsync();
    }

    private async Task CopiarPix(string chave)
    {
        if (await JS.InvokeAsync<bool>("mpCopiar", chave)) Toast.Sucesso("Chave Pix copiada!");
        else await JS.InvokeVoidAsync("prompt", "Copie a chave Pix abaixo:", chave);
    }

    private async Task ContatarWhatsAppOng(Usuario ong)
    {
        var fone = new string(ong.Telefone.Where(char.IsDigit).ToArray());
        var texto = $"Olá, {ong.Nome}! Vi o perfil de vocês no *Match-Pet SP* e gostaria de doar ração/itens. Como podemos combinar?";
        await JS.InvokeVoidAsync("open", $"https://wa.me/55{fone}?text={Uri.EscapeDataString(texto)}", "_blank");
        ongModal = null;
    }
}
