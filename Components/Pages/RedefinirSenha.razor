@page "/redefinir-senha"
@using System.Security.Cryptography
@inject IUsuarioRepository UsuarioRepository
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Nova senha | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 520px;">
    <div class="mp-card p-4 p-md-5">
        @if (carregando)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (usuario == null)
        {
            <div class="text-center">
                <div class="display-4 mb-2">⏰</div>
                <h1 class="h4">Link inválido ou expirado</h1>
                <p class="text-muted">Os links de recuperação valem por 1 hora e só podem ser usados uma vez.</p>
                <a href="/esqueci-senha" class="btn btn-primary">Pedir um novo link</a>
            </div>
        }
        else
        {
            <div class="icone-bolha verde mb-3"><i class="bi bi-shield-lock"></i></div>
            <h1 class="h3">Crie uma nova senha</h1>
            <p class="text-muted">Conta: <strong>@usuario.Email</strong></p>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="alert alert-danger small py-2">@erro</div>
            }

            <form @onsubmit="Salvar" @onsubmit:preventDefault>
                <label class="form-label" for="novaSenha">Nova senha</label>
                <input id="novaSenha" type="password" autocomplete="new-password" class="form-control" @bind="novaSenha" @bind:event="oninput" />
                <ForcaSenha Senha="@novaSenha" />

                <label class="form-label mt-3" for="confirmaSenha">Confirme a nova senha</label>
                <input id="confirmaSenha" type="password" autocomplete="new-password" class="form-control mb-4" @bind="confirmacao" />

                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar nova senha")
                </button>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private Usuario? usuario;
    private bool carregando = true, salvando;
    private string novaSenha = "", confirmacao = "", erro = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            var hash = Convert.ToHexString(SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Token)));
            var u = await UsuarioRepository.GetByResetTokenHashAsync(hash);
            if (u != null && u.ResetSenhaExpiraEm > DateTime.UtcNow) usuario = u;
        }
        carregando = false;
    }

    private async Task Salvar()
    {
        erro = "";
        if (usuario == null) return;
        if (!ForcaSenha.SenhaAceitavel(novaSenha)) { erro = "A senha precisa ter pelo menos 8 caracteres, com letras e números."; return; }
        if (novaSenha != confirmacao) { erro = "As senhas não coincidem."; return; }

        salvando = true;
        try
        {
            usuario.Senha = SenhaService.GerarHash(novaSenha);
            usuario.ResetSenhaTokenHash = null;   // o link não pode ser usado de novo
            usuario.ResetSenhaExpiraEm = null;
            usuario.DataUltimaAlteracao = DateTime.UtcNow;
            await UsuarioRepository.UpdateAsync(usuario);

            Toast.Sucesso("Senha alterada! Agora é só entrar com a nova senha.");
            Nav.NavigateTo("/login");
        }
        catch
        {
            erro = "Não foi possível salvar. Tente novamente.";
        }
        finally { salvando = false; }
    }
}
