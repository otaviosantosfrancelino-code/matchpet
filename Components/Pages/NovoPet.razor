@page "/pets/novo"
@inject IPetRepository PetRepository
@inject IItemRepository ItemRepository
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@inject AvisoAnaliseService Analise

<PageTitle>Novo anúncio | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 860px;">
    <div class="text-center mb-4">
        <h1 class="h2 mb-1">O que você quer anunciar?</h1>
        <p class="text-muted">É grátis. O contato só é liberado para quem assina o termo de responsabilidade.</p>
        <div class="segmentos mt-2">
            <button type="button" class="@(tipoCadastro == "pet" ? "ativo" : "")" @onclick='() => tipoCadastro = "pet"'><i class="bi bi-heart-fill me-1 text-danger"></i> Um pet para adoção</button>
            <button type="button" class="@(tipoCadastro == "item" ? "ativo" : "")" @onclick='() => tipoCadastro = "item"'><i class="bi bi-gift-fill me-1 text-warning"></i> Um item / ração</button>
        </div>
    </div>

    @if (!AuthService.DocumentoAprovado)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3">
            <i class="bi bi-shield-exclamation fs-4"></i>
            <div class="small">Para publicar, primeiro <strong>verifique seu documento</strong>. Isso garante que todos os anúncios têm um responsável identificado.</div>
            <a href="/perfil" class="btn btn-sm btn-warning ms-auto flex-shrink-0">Verificar agora</a>
        </div>
    }

    @if (tipoCadastro == "pet")
    {
        <div class="mp-card p-3 p-sm-4 p-md-5">
            <EditForm Model="@novoPet" OnValidSubmit="SalvarPet">
                <DataAnnotationsValidator />

                <div class="secao-form mt-0">Fotos (até @MaxFotos)</div>
                <div class="upload-area">
                    <InputFile OnChange="CarregarFotosPet" multiple accept="image/jpeg,image/png,image/webp" disabled="@estaCarregando" />
                    @if (estaCarregando) { <span class="spinner-border text-primary"></span><div class="small mt-2">Processando fotos...</div> }
                    else { <i class="bi bi-images fs-1 text-primary"></i><div class="fw-bold text-dark mt-1">Toque para adicionar fotos</div><small class="text-muted">A primeira foto vira a capa do anúncio</small> }
                </div>
                @if (novoPet.Imagens.Any())
                {
                    <div class="miniaturas">
                        @foreach (var img in novoPet.Imagens)
                        {
                            <div class="miniatura">
                                <img src="@img.Base64Data" alt="" />
                                <button type="button" aria-label="Remover foto" @onclick="() => novoPet.Imagens.Remove(img)">&times;</button>
                                @if (img == novoPet.Imagens[0]) { <span class="capa">CAPA</span> }
                            </div>
                        }
                    </div>
                }

                <div class="secao-form">Sobre o pet</div>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="novoPet.Nome" placeholder="Ex.: Pipoca" />
                        <ValidationMessage For="@(() => novoPet.Nome)" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="especiePet">Espécie</label>
                        <select id="especiePet" class="form-select" @bind="especieSelecionadaPet" @bind:after="MudouEspecie">
                            @foreach (var e in EspeciesPermitidas.Especies)
                            {
                                <option value="@e.Valor">@e.Emoji @e.Rotulo</option>
                            }
                        </select>
                        <div class="form-text"><i class="bi bi-shield-check me-1"></i>Só animais domésticos (Portaria Ibama nº 93/1998).</div>
                    </div>
                    <div class="col-md-6">
                        @if (especieSelecionadaPet == "Pássaro")
                        {
                            <label class="form-label" for="racaAve">Qual ave?</label>
                            <select id="racaAve" class="form-select" @bind="novoPet.Raca">
                                <option value="">Escolha a espécie da ave</option>
                                @foreach (var ave in EspeciesPermitidas.AvesDomesticas) { <option value="@ave">@ave</option> }
                            </select>
                            <div class="form-text text-warning"><i class="bi bi-feather me-1"></i>A moderação confere a espécie antes de publicar.</div>
                        }
                        else
                        {
                            <label class="form-label">Raça</label>
                            <InputText class="form-control" @bind-Value="novoPet.Raca" placeholder="SRD (vira-lata), Poodle, Siamês..." />
                        }
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Idade (anos)</label>
                        <InputNumber class="form-control" min="0" max="40" @bind-Value="novoPet.Idade" />
                        <div class="form-text">0 = filhote</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label">Sexo</label>
                        <InputSelect class="form-select" @bind-Value="novoPet.Sexo">
                            <option value="Macho">Macho</option>
                            <option value="Fêmea">Fêmea</option>
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Porte</label>
                        <div class="d-flex gap-2">
                            @foreach (var porte in new[] { "Pequeno", "Médio", "Grande" })
                            {
                                <button type="button" class="opcao-card flex-fill justify-content-center @(novoPet.Porte == porte ? "marcada" : "")" @onclick="() => novoPet.Porte = porte">
                                    <span class="fw-semibold">@porte</span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">História e personalidade</label>
                        <InputTextArea class="form-control" @bind-Value="novoPet.Descricao" rows="4" placeholder="Como ele é? Gosta de brincar? Convive com outros animais? Por que está para adoção?" />
                    </div>
                </div>

                <div class="secao-form">Características</div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="opcao-card @(novoPet.Castrado ? "marcada" : "")"><input type="checkbox" @bind="novoPet.Castrado" /><span class="emoji">✂️</span><span class="fw-semibold small">Já é castrado</span></label>
                    </div>
                    <div class="col-md-4">
                        <label class="opcao-card @(novoPet.RecomendadoParaCriancas ? "marcada" : "")"><input type="checkbox" @bind="novoPet.RecomendadoParaCriancas" /><span class="emoji">🍼</span><span class="fw-semibold small">Gosta de crianças</span></label>
                    </div>
                    <div class="col-md-4">
                        <label class="opcao-card @(novoPet.PrecisaDeQuintal ? "marcada" : "")"><input type="checkbox" @bind="novoPet.PrecisaDeQuintal" /><span class="emoji">🌳</span><span class="fw-semibold small">Precisa de quintal</span></label>
                    </div>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row gap-2 justify-content-end mt-5">
                    <a href="/pets" class="btn btn-light px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-lg px-5" disabled="@(estaCarregando || salvando)">
                        @(salvando ? "Publicando..." : "Publicar anúncio")
                    </button>
                </div>
            </EditForm>
        </div>
    }
    else
    {
        <div class="mp-card p-3 p-sm-4 p-md-5">
            <EditForm Model="@novoItem" OnValidSubmit="SalvarItem">
                <DataAnnotationsValidator />

                <div class="secao-form mt-0">Fotos (até @MaxFotos)</div>
                <div class="upload-area">
                    <InputFile OnChange="CarregarFotosItem" multiple accept="image/jpeg,image/png,image/webp" disabled="@estaCarregando" />
                    @if (estaCarregando) { <span class="spinner-border text-warning"></span><div class="small mt-2">Processando fotos...</div> }
                    else { <i class="bi bi-camera fs-1 text-warning"></i><div class="fw-bold text-dark mt-1">Toque para adicionar fotos do item</div><small class="text-muted">Mostre o estado de conservação</small> }
                </div>
                @if (novoItem.Imagens.Any())
                {
                    <div class="miniaturas">
                        @foreach (var img in novoItem.Imagens)
                        {
                            <div class="miniatura"><img src="@img.Base64Data" alt="" /><button type="button" aria-label="Remover foto" @onclick="() => novoItem.Imagens.Remove(img)">&times;</button></div>
                        }
                    </div>
                }

                <div class="secao-form">Detalhes do item</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Nome do item</label>
                        <InputText class="form-control" @bind-Value="novoItem.Nome" placeholder="Ex.: Saco de ração 15kg, casinha nº 3, gaiola grande" />
                        <ValidationMessage For="@(() => novoItem.Nome)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Categoria</label>
                        <InputSelect class="form-select" @bind-Value="categoriaSelecionadaItem">
                            <option value="Ração/Alimento">🦴 Ração / Alimento</option>
                            <option value="Casinha/Cama">🏠 Casinha / Cama</option>
                            <option value="Gaiola/Aquário">🐦 Gaiola / Aquário</option>
                            <option value="Remédio/Higiene">💊 Remédio / Higiene</option>
                            <option value="Brinquedo/Acessório">🧶 Brinquedo / Acessório</option>
                            <option value="Outros">Outro...</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Serve para</label>
                        <InputSelect class="form-select" @bind-Value="especieDestinoItem">
                            <option value="Todos">Qualquer pet</option>
                            <option value="Cão">Cachorros</option>
                            <option value="Gato">Gatos</option>
                            <option value="Pássaro">Pássaros</option>
                            <option value="Peixe">Peixes</option>
                            <option value="Outros">Outro...</option>
                        </InputSelect>
                    </div>
                    @if (categoriaSelecionadaItem == "Outros")
                    {
                        <div class="col-md-6"><input type="text" class="form-control" placeholder="Qual a categoria?" @bind="categoriaPersonalizadaItem" /></div>
                    }
                    @if (especieDestinoItem == "Outros")
                    {
                        <div class="col-md-6"><input type="text" class="form-control" placeholder="Para qual animal?" @bind="especieDestinoPersonalizadaItem" /></div>
                    }
                    <div class="col-12">
                        <label class="form-label">Descrição, conservação ou validade</label>
                        <InputTextArea class="form-control" @bind-Value="novoItem.Descricao" rows="3" placeholder="Ex.: casinha de madeira semi-nova / ração lacrada, validade 12/2027" />
                        <ValidationMessage For="@(() => novoItem.Descricao)" />
                    </div>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row gap-2 justify-content-end mt-5">
                    <a href="/bazar" class="btn btn-light px-4">Cancelar</a>
                    <button type="submit" class="btn btn-accent btn-lg px-5" disabled="@(estaCarregando || salvando)">
                        @(salvando ? "Publicando..." : "Publicar doação")
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoQuery { get; set; }

    private string tipoCadastro = "pet";
    // Valores iniciais iguais à 1ª opção (antes ficavam vazios no banco)
    private Pet novoPet = new() { Sexo = "Macho", Porte = "Pequeno" };
    private ItemDoacao novoItem = new();
    private bool estaCarregando, salvando;

    private const int MaxFotos = 5;
    private const long TamanhoMaxFoto = 10 * 1024 * 1024;

    private string especieSelecionadaPet = "Cão";

    // Ao trocar entre ave e outros animais, a raça digitada não serve mais
    private void MudouEspecie() => novoPet.Raca = especieSelecionadaPet == "Pássaro" ? "" : (EspeciesPermitidas.AvesDomesticas.Contains(novoPet.Raca) ? "SRD" : novoPet.Raca);
    private string categoriaSelecionadaItem = "Ração/Alimento", categoriaPersonalizadaItem = "";
    private string especieDestinoItem = "Todos", especieDestinoPersonalizadaItem = "";

    protected override void OnInitialized()
    {
        if (!AuthService.EstaLogado)
        {
            Toast.Info("Entre na sua conta para anunciar.");
            Nav.NavigateTo("/login?voltar=/pets/novo");
            return;
        }
        if (TipoQuery == "item") tipoCadastro = "item";
    }

    // Lê as fotos escolhidas, reduz para 1000px e devolve em Base64
    private async Task<List<string>> LerFotos(InputFileChangeEventArgs e, int jaAdicionadas)
    {
        var resultado = new List<string>();
        var vagas = MaxFotos - jaAdicionadas;
        if (vagas <= 0) { Toast.Aviso($"Limite de {MaxFotos} fotos. Remova alguma para adicionar outra."); return resultado; }

        var arquivos = e.GetMultipleFiles(50).ToList();
        if (arquivos.Count > vagas) Toast.Aviso($"Só {vagas} foto(s) foram adicionadas (limite de {MaxFotos}).");

        estaCarregando = true;
        try
        {
            foreach (var arquivo in arquivos.Take(vagas))
            {
                if (!arquivo.ContentType.StartsWith("image/")) { Toast.Erro($"\"{arquivo.Name}\" não é uma imagem."); continue; }
                if (arquivo.Size > TamanhoMaxFoto) { Toast.Erro($"\"{arquivo.Name}\" passa de 10 MB."); continue; }

                var reduzida = await arquivo.RequestImageFileAsync("image/jpeg", 1000, 1000);
                using var stream = reduzida.OpenReadStream(TamanhoMaxFoto);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                resultado.Add($"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}");
            }
        }
        catch { Toast.Erro("Não foi possível carregar uma das fotos. Tente outra imagem."); }
        finally { estaCarregando = false; }
        return resultado;
    }

    private async Task CarregarFotosPet(InputFileChangeEventArgs e)
    {
        foreach (var b64 in await LerFotos(e, novoPet.Imagens.Count)) novoPet.Imagens.Add(new PetImagem { Base64Data = b64 });
    }

    private async Task CarregarFotosItem(InputFileChangeEventArgs e)
    {
        foreach (var b64 in await LerFotos(e, novoItem.Imagens.Count)) novoItem.Imagens.Add(new ItemImagem { Base64Data = b64 });
    }

    private bool PodePublicar()
    {
        if (AuthService.DocumentoAprovado) return true;
        Toast.Aviso("Verifique seu documento no Perfil para publicar anúncios.");
        Nav.NavigateTo("/perfil");
        return false;
    }

    private async Task SalvarPet()
    {
        if (salvando || !PodePublicar()) return;
        if (!novoPet.Imagens.Any()) { Toast.Aviso("Adicione pelo menos uma foto do pet."); return; }

        novoPet.Especie = especieSelecionadaPet;
        if (string.IsNullOrWhiteSpace(novoPet.Raca) && novoPet.Especie != "Pássaro") novoPet.Raca = "SRD";
        // RN04: só animais domésticos
        if (EspeciesPermitidas.Validar(novoPet.Especie, novoPet.Raca) is string erroEspecie) { Toast.Aviso(erroEspecie); return; }
        // Todo anúncio passa pela aprovação da moderação (menos os de administradores)
        var emModeracao = !Consultas.PublicaDireto(AuthService.UsuarioLogado);
        novoPet.Status = emModeracao ? EspeciesPermitidas.StatusModeracao : "Disponível";
        novoPet.Nome = novoPet.Nome.Trim();
        novoPet.FotoUrl = ""; // a capa é a 1ª imagem (não duplicamos a foto no banco)
        novoPet.UsuarioDoadorId = AuthService.UsuarioLogado!.Id;

        salvando = true;
        try
        {
            await PetRepository.AddAsync(novoPet);
            if (emModeracao) Analise.Mostrar($"Anúncio de {novoPet.Nome} enviado para análise", $"O anúncio de {novoPet.Nome}", "no catálogo");
            else Toast.Sucesso($"{novoPet.Nome} já está no catálogo! 🎉");
            Nav.NavigateTo("/meus-pets");
        }
        catch (Exception ex) { Toast.Erro("Erro ao publicar: " + (ex.InnerException?.Message ?? ex.Message)); }
        finally { salvando = false; }
    }

    private async Task SalvarItem()
    {
        if (salvando || !PodePublicar()) return;

        novoItem.Categoria = categoriaSelecionadaItem == "Outros" && !string.IsNullOrWhiteSpace(categoriaPersonalizadaItem) ? categoriaPersonalizadaItem.Trim() : categoriaSelecionadaItem;
        novoItem.EspecieDestino = especieDestinoItem == "Outros" && !string.IsNullOrWhiteSpace(especieDestinoPersonalizadaItem) ? especieDestinoPersonalizadaItem.Trim() : especieDestinoItem;
        novoItem.FotoUrl = "";
        novoItem.UsuarioDoadorId = AuthService.UsuarioLogado!.Id;
        var itemEmModeracao = !Consultas.PublicaDireto(AuthService.UsuarioLogado);
        novoItem.Status = itemEmModeracao ? EspeciesPermitidas.StatusModeracao : "Disponível";

        salvando = true;
        try
        {
            await ItemRepository.AddAsync(novoItem);
            if (itemEmModeracao) Analise.Mostrar("Doação enviada para análise 🎁", "Sua doação", "no Bazar Solidário");
            else Toast.Sucesso("Doação publicada no Bazar Solidário! 🎁");
            Nav.NavigateTo("/meus-pets?aba=itens");
        }
        catch (Exception ex) { Toast.Erro("Erro ao publicar: " + (ex.InnerException?.Message ?? ex.Message)); }
        finally { salvando = false; }
    }
}
