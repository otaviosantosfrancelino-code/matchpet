@page "/pets"
@inject IPetRepository PetRepository
@inject NavigationManager Nav

<PageTitle>Adotar um pet | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3">
            <div class="icone-bolha azul"><i class="bi bi-search-heart"></i></div>
            <div>
                <h1>Adote um amigo</h1>
                <p>Pets de ONGs e tutores verificados em Franca e região.</p>
            </div>
        </div>
        <a href="/bazar" class="btn btn-light"><i class="bi bi-gift me-1"></i> Bazar Solidário</a>
    </div>

    @* ===== FILTROS ===== *@
    <div class="mp-card p-3 p-md-4 mb-4">
        <div class="row g-2 g-md-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="campo-icone">
                    <i class="bi bi-search"></i>
                    <input type="search" class="form-control" placeholder="Buscar pelo nome..." aria-label="Buscar pelo nome" @bind="filtroNome" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-8 col-md-4">
                <div class="campo-icone">
                    <i class="bi bi-geo-alt"></i>
                    <input type="text" class="form-control" placeholder="Cidade" aria-label="Cidade" @bind="filtroCidade" @onkeydown="FiltrarAoApertarEnter" @onblur="AplicarFiltro" />
                </div>
            </div>
            <div class="col-4 col-md-3 d-grid">
                <button class="btn @(maisFiltros || FiltrosExtrasAtivos > 0 ? "btn-primary" : "btn-light")" @onclick="() => maisFiltros = !maisFiltros" aria-expanded="@maisFiltros">
                    <i class="bi bi-sliders me-1"></i> Filtros @(FiltrosExtrasAtivos > 0 ? $"({FiltrosExtrasAtivos})" : "")
                </button>
            </div>
        </div>

        <div class="chips mt-3">
            @foreach (var (valor, rotulo) in Especies)
            {
                <button class="chip @(filtroEspecie == valor ? "ativo" : "")" @onclick="() => MudarEspecie(valor)">@rotulo</button>
            }
        </div>

        @if (maisFiltros)
        {
            <div class="row g-3 mt-1 pt-3 border-top">
                <div class="col-6 col-md-3">
                    <label class="form-label small">Porte</label>
                    <select class="form-select" @bind="filtroPorte" @bind:after="AplicarFiltro">
                        <option value="">Qualquer</option>
                        <option>Pequeno</option>
                        <option>Médio</option>
                        <option>Grande</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small">Sexo</label>
                    <select class="form-select" @bind="filtroSexo" @bind:after="AplicarFiltro">
                        <option value="">Qualquer</option>
                        <option>Macho</option>
                        <option>Fêmea</option>
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small">Meu estilo de vida</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <label class="opcao-card flex-fill @(temCriancas ? "marcada" : "")">
                            <input type="checkbox" @bind="temCriancas" @bind:after="AplicarFiltro" />
                            <span class="emoji">🍼</span><span class="fw-semibold small">Tenho crianças</span>
                        </label>
                        <label class="opcao-card flex-fill @(moraEmApto ? "marcada" : "")">
                            <input type="checkbox" @bind="moraEmApto" @bind:after="AplicarFiltro" />
                            <span class="emoji">🏢</span><span class="fw-semibold small">Moro em apartamento</span>
                        </label>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ===== RESULTADOS ===== *@
    @if (pets == null)
    {
        <CardsCarregando />
    }
    else if (!PetsVisiveis.Any())
    {
        <div class="estado-vazio">
            <div class="emoji">🔎</div>
            <h5>@(TemFiltroAtivo ? "Nenhum pet com esses filtros" : "Nenhum pet disponível no momento")</h5>
            <p class="text-muted">@(TemFiltroAtivo ? "Tente remover algum filtro para ver mais opções." : "Volte em breve, novos amigos chegam toda semana!")</p>
            @if (TemFiltroAtivo)
            {
                <button class="btn btn-primary" @onclick="LimparFiltros">Limpar filtros</button>
            }
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted small mb-0"><strong class="text-dark">@PetsVisiveis.Count()</strong> @(PetsVisiveis.Count() == 1 ? "pet encontrado" : "pets encontrados")</p>
            @if (TemFiltroAtivo)
            {
                <button class="btn btn-ghost btn-sm" @onclick="LimparFiltros"><i class="bi bi-x-circle me-1"></i>Limpar filtros</button>
            }
        </div>
        <div class="row g-3 g-md-4">
            @foreach (var pet in PetsVisiveis)
            {
                <div class="col-6 col-md-4 col-lg-3"><PetCard Pet="pet" /></div>
            }
        </div>
    }
</div>

@code {
    // Filtros vindos da busca da página inicial (/pets?especie=Gato&cidade=Franca)
    [SupplyParameterFromQuery(Name = "especie")] public string? EspecieQuery { get; set; }
    [SupplyParameterFromQuery(Name = "cidade")] public string? CidadeQuery { get; set; }

    private IEnumerable<Pet>? pets;
    private string filtroNome = "", filtroCidade = "", filtroEspecie = "", filtroPorte = "", filtroSexo = "";
    private bool temCriancas, moraEmApto, maisFiltros;

    // Evita duas consultas ao mesmo tempo no banco (ex.: mudar vários filtros rápido)
    private readonly SemaphoreSlim travaConsulta = new(1, 1);

    private static readonly (string, string)[] Especies =
        { ("", "🐾 Todos"), ("Cão", "🐶 Cães"), ("Gato", "🐱 Gatos"), ("Pássaro", "🐦 Aves"), ("Peixe", "🐟 Peixes"), ("Outros", "🐹 Outros") };

    private int FiltrosExtrasAtivos => (string.IsNullOrEmpty(filtroPorte) ? 0 : 1) + (string.IsNullOrEmpty(filtroSexo) ? 0 : 1) + (temCriancas ? 1 : 0) + (moraEmApto ? 1 : 0);

    private bool TemFiltroAtivo => !string.IsNullOrWhiteSpace(filtroNome) || !string.IsNullOrWhiteSpace(filtroCidade) ||
                                   !string.IsNullOrEmpty(filtroEspecie) || FiltrosExtrasAtivos > 0;

    // Só pets disponíveis; a busca por nome é feita na hora, sem ir ao banco
    private IEnumerable<Pet> PetsVisiveis => (pets ?? Enumerable.Empty<Pet>())
        .Where(p => p.Status == "Disponível")
        .Where(p => string.IsNullOrWhiteSpace(filtroNome) || p.Nome.Contains(filtroNome.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        filtroEspecie = EspecieQuery ?? "";
        filtroCidade = CidadeQuery ?? "";
        await AplicarFiltro();
    }

    private async Task MudarEspecie(string especie)
    {
        filtroEspecie = especie;
        await AplicarFiltro();
    }

    private async Task AplicarFiltro()
    {
        await travaConsulta.WaitAsync();
        try
        {
            pets = await PetRepository.GetPetsParaMatch(temCriancas, moraEmApto, filtroEspecie, filtroPorte, filtroSexo, filtroCidade);
        }
        finally { travaConsulta.Release(); }
    }

    private async Task FiltrarAoApertarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AplicarFiltro();
    }

    private async Task LimparFiltros()
    {
        filtroNome = filtroCidade = filtroEspecie = filtroPorte = filtroSexo = "";
        temCriancas = moraEmApto = false;
        await AplicarFiltro();
    }
}
