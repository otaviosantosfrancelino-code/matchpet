@page "/login"
@inject IUsuarioRepository UsuarioRepository
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@inject LimiteTentativasService Limite

<PageTitle>Entrar | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="tela-auth mp-card">
        <div class="lado-arte d-none d-md-flex">
            <div>
                <span class="display-4">🐾</span>
                <h2 class="text-white mt-3">Que bom te ver de novo!</h2>
                <p>Entre para acompanhar seus anúncios, adotar com segurança e conversar com os doadores.</p>
            </div>
            <ul class="list-unstyled small mb-0">
                <li><i class="bi bi-check-circle-fill me-2"></i>Cadastros verificados</li>
                <li><i class="bi bi-check-circle-fill me-2"></i>Termo digital de adoção</li>
                <li><i class="bi bi-check-circle-fill me-2"></i>Conversa direta pelo chat do site</li>
            </ul>
        </div>

        <div class="lado-form">
            <h1 class="h3 mb-1">Entrar</h1>
            <p class="text-muted mb-4">Use seu CPF/CNPJ ou e-mail e sua senha.</p>

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger py-2 small"><i class="bi bi-x-circle-fill me-1"></i> @mensagemErro</div>
            }

            <form @onsubmit="ProcessarLogin" @onsubmit:preventDefault>
                <div class="mb-3">
                    <label class="form-label" for="loginDoc">CPF, CNPJ ou e-mail</label>
                    <div class="campo-icone">
                        <i class="bi bi-person"></i>
                        <input id="loginDoc" type="text" autocomplete="username" class="form-control" @bind="identificacao" data-mascara="doc-ou-email" maxlength="80" placeholder="000.000.000-00 ou voce@email.com" />
                    </div>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label" for="loginSenha">Senha</label>
                        <a href="/esqueci-senha" class="small fw-semibold mb-1">Esqueci minha senha</a>
                    </div>
                    <div class="campo-icone position-relative">
                        <i class="bi bi-lock"></i>
                        <input id="loginSenha" type="@(mostrarSenha ? "text" : "password")" autocomplete="current-password" class="form-control pe-5" @bind="senha" placeholder="Sua senha" />
                        <button type="button" class="btn btn-ghost btn-sm olho" @onclick="() => mostrarSenha = !mostrarSenha" aria-label="@(mostrarSenha ? "Esconder senha" : "Mostrar senha")">
                            <i class="bi @(mostrarSenha ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" disabled="@entrando">
                    @if (entrando) { <span class="spinner-border spinner-border-sm me-2"></span><span>Entrando...</span> }
                    else { <span>Entrar</span> }
                </button>
            </form>

            <p class="text-center text-muted mt-4 mb-0">Ainda não tem conta? <a href="/cadastro" class="fw-bold">Crie grátis</a></p>
            <p class="text-center text-muted small mt-2 mb-0">Ao entrar, você concorda com a <a href="/privacidade">Política de Privacidade</a>.</p>
        </div>
    </div>
</div>

<style>
    .tela-auth { display: flex; max-width: 940px; margin: 0 auto; overflow: hidden; border-radius: 26px; box-shadow: var(--mp-shadow); }
    .lado-arte { flex: 1; flex-direction: column; justify-content: space-between; gap: 2rem; padding: 2.5rem; color: rgba(255,255,255,.9); background: linear-gradient(150deg, #2563eb 0%, #7c3aed 100%); }
    .lado-arte li { margin-bottom: .5rem; }
    .lado-form { flex: 1.15; padding: clamp(1.5rem, 4vw, 3rem); }
    .olho { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); }
</style>

@code {
    [CascadingParameter(Name = "IpCliente")] public string IpCliente { get; set; } = "";
    [SupplyParameterFromQuery(Name = "voltar")] public string? Voltar { get; set; }
    private string identificacao = "", senha = "", mensagemErro = "";
    private bool mostrarSenha, entrando;

    protected override void OnInitialized()
    {
        if (AuthService.EstaLogado) Nav.NavigateTo("/pets");
    }

    private async Task ProcessarLogin()
    {
        if (entrando) return;
        mensagemErro = "";
        if (string.IsNullOrWhiteSpace(identificacao) || string.IsNullOrWhiteSpace(senha))
        {
            mensagemErro = "Preencha todos os campos.";
            return;
        }

        // Proteção contra quem tenta adivinhar senhas: 5 erros por conta ou 20 por conexão em 15 minutos
        var texto = identificacao.Trim();
        var chaveConta = "login:conta:" + (texto.Contains('@') ? texto.ToLowerInvariant() : DocumentoUtil.SomenteDigitos(texto));
        var chaveIp = "login:ip:" + IpCliente;
        var janela = TimeSpan.FromMinutes(15);
        if ((Limite.Bloqueio(chaveConta, 5, janela) ?? Limite.Bloqueio(chaveIp, 20, janela)) is TimeSpan espera)
        {
            mensagemErro = $"Muitas tentativas erradas. Por segurança, aguarde {LimiteTentativasService.Tempo(espera)} ou use \"Esqueci minha senha\".";
            return;
        }

        entrando = true;
        try
        {
            var usuario = texto.Contains('@')
                ? await UsuarioRepository.GetByEmailAsync(texto)
                : await UsuarioRepository.GetByDocumentoAsync(texto);

            if (usuario == null || !SenhaService.Verificar(usuario, senha))
            {
                Limite.Registrar(chaveConta);
                Limite.Registrar(chaveIp);
                mensagemErro = "Dados de acesso inválidos. Confira e tente novamente.";
                return;
            }
            Limite.Zerar(chaveConta);

            // Conta antiga com senha em texto puro: converte para hash agora
            if (!SenhaService.EhHash(usuario.Senha))
            {
                usuario.Senha = SenhaService.GerarHash(senha);
                await UsuarioRepository.UpdateAsync(usuario);
            }

            await AuthService.LoginAsync(usuario);
            Toast.Sucesso($"Bem-vindo(a), {usuario.Nome.Split(' ')[0]}!");
            Nav.NavigateTo(!string.IsNullOrEmpty(Voltar) && Voltar.StartsWith('/') ? Voltar : "/pets");
        }
        catch (Exception)
        {
            mensagemErro = "Não foi possível conectar ao servidor. Tente novamente.";
        }
        finally
        {
            entrando = false;
        }
    }
}
