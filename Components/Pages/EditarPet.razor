@page "/pets/editar/{Id:int}"
@using crudcomdb.Data
@inject IPetRepository PetRepository
@inject AppDbContext Db
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@implements IDisposable

<PageTitle>Editar pet | Match-Pet SP</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 860px;">
    <button class="btn btn-ghost px-2 mb-3" @onclick="VoltarMeusPets"><i class="bi bi-arrow-left me-1"></i> Meus anúncios</button>
    <h1 class="h2 mb-4">Editar anúncio</h1>

    @if (petParaEditar == null)
    {
        <div class="skeleton" style="height: 480px; border-radius: 18px;"></div>
    }
    else
    {
        <div class="mp-card p-3 p-sm-4 p-md-5">
            <EditForm Model="@petParaEditar" OnValidSubmit="SalvarAlteracoes">
                <DataAnnotationsValidator />

                <div class="secao-form mt-0">Fotos</div>
                <div class="upload-area">
                    <InputFile OnChange="AdicionarNovasFotos" multiple accept="image/jpeg,image/png,image/webp" disabled="@estaCarregando" />
                    @if (estaCarregando) { <span class="spinner-border text-primary"></span> }
                    else { <i class="bi bi-images fs-2 text-primary"></i><div class="fw-bold text-dark">Adicionar fotos</div> }
                </div>
                <div class="miniaturas">
                    @foreach (var img in petParaEditar.Imagens)
                    {
                        <div class="miniatura">
                            <img src="@Url.Pet(img)" alt="" />
                            <button type="button" aria-label="Remover foto" @onclick="() => petParaEditar.Imagens.Remove(img)">&times;</button>
                            @if (img == petParaEditar.Imagens[0]) { <span class="capa">CAPA</span> }
                        </div>
                    }
                </div>

                <div class="secao-form">Dados principais</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="petParaEditar.Nome" />
                        <ValidationMessage For="@(() => petParaEditar.Nome)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Raça</label>
                        <InputText class="form-control" @bind-Value="petParaEditar.Raca" list="avesDomesticas" />
                        <datalist id="avesDomesticas">@foreach (var ave in EspeciesPermitidas.AvesDomesticas) { <option value="@ave" /> }</datalist>
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label" for="especieEditar">Espécie</label>
                        <select id="especieEditar" class="form-select" @bind="petParaEditar.Especie">
                            @foreach (var e in EspeciesPermitidas.Especies) { <option value="@e.Valor">@e.Emoji @e.Rotulo</option> }
                            @if (!EspeciesPermitidas.Especies.Any(e => e.Valor == especieOriginal)) { <option value="@especieOriginal">@especieOriginal (antigo)</option> }
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label">Sexo</label>
                        <InputSelect class="form-select" @bind-Value="petParaEditar.Sexo">
                            <option value="Macho">Macho</option>
                            <option value="Fêmea">Fêmea</option>
                        </InputSelect>
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label">Idade (anos)</label>
                        <InputNumber class="form-control" min="0" max="40" @bind-Value="petParaEditar.Idade" />
                    </div>
                    <div class="col-6 col-md-6">
                        <label class="form-label">Porte</label>
                        <InputSelect class="form-select" @bind-Value="petParaEditar.Porte">
                            <option value="Pequeno">Pequeno</option>
                            <option value="Médio">Médio</option>
                            <option value="Grande">Grande</option>
                        </InputSelect>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">Status do anúncio</label>
                        @if (statusOriginal == EspeciesPermitidas.StatusModeracao || statusOriginal == ModeracaoService.StatusRemovido)
                        {
                            <input class="form-control" value="@statusOriginal" disabled />
                            <div class="form-text">@(statusOriginal == ModeracaoService.StatusRemovido ? "Removido pela moderação: o status não pode ser alterado." : "Aguardando a moderação aprovar o anúncio.")</div>
                        }
                        else
                        {
                            <InputSelect class="form-select" @bind-Value="petParaEditar.Status">
                                <option value="Disponível">Disponível</option>
                                <option value="Em Processo">Em processo (alguém assinou o termo)</option>
                                <option value="Adotado">Adotado (Final Feliz)</option>
                            </InputSelect>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">História e personalidade</label>
                        <InputTextArea class="form-control" @bind-Value="petParaEditar.Descricao" rows="4" />
                    </div>
                </div>

                <div class="secao-form">Características</div>
                <div class="row g-2">
                    <div class="col-md-4"><label class="opcao-card @(petParaEditar.Castrado ? "marcada" : "")"><input type="checkbox" @bind="petParaEditar.Castrado" /><span class="emoji">✂️</span><span class="fw-semibold small">Já é castrado</span></label></div>
                    <div class="col-md-4"><label class="opcao-card @(petParaEditar.RecomendadoParaCriancas ? "marcada" : "")"><input type="checkbox" @bind="petParaEditar.RecomendadoParaCriancas" /><span class="emoji">🍼</span><span class="fw-semibold small">Gosta de crianças</span></label></div>
                    <div class="col-md-4"><label class="opcao-card @(petParaEditar.PrecisaDeQuintal ? "marcada" : "")"><input type="checkbox" @bind="petParaEditar.PrecisaDeQuintal" /><span class="emoji">🌳</span><span class="fw-semibold small">Precisa de quintal</span></label></div>
                </div>

                <div class="d-flex flex-column-reverse flex-sm-row gap-2 justify-content-end mt-5">
                    <button type="button" class="btn btn-light px-4" @onclick="VoltarMeusPets">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-lg px-5" disabled="@(estaCarregando || salvando)">@(salvando ? "Salvando..." : "Salvar alterações")</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Pet? petParaEditar;
    private string especieOriginal = "", racaOriginal = "", statusOriginal = "";
    private bool estaCarregando, salvando, salvo;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaLogado) { Nav.NavigateTo("/login"); return; }

        var pet = await PetRepository.GetParaEdicaoAsync(Id);
        if (pet == null || pet.UsuarioDoadorId != AuthService.UsuarioLogado!.Id)
        {
            Toast.Erro("Anúncio não encontrado.");
            Nav.NavigateTo("/meus-pets");
            return;
        }
        petParaEditar = pet;
        especieOriginal = pet.Especie;
        racaOriginal = pet.Raca;
        statusOriginal = pet.Status;
    }

    // Sai sem salvar: descarta o que foi alterado na memória para não aparecer em outras telas
    private void DescartarAlteracoes() { if (!salvo && petParaEditar != null) Db.ChangeTracker.Clear(); }

    private void VoltarMeusPets()
    {
        DescartarAlteracoes();
        Nav.NavigateTo("/meus-pets");
    }

    public void Dispose() => DescartarAlteracoes();

    private async Task AdicionarNovasFotos(InputFileChangeEventArgs e)
    {
        var vagas = 8 - petParaEditar!.Imagens.Count;
        if (vagas <= 0) { Toast.Aviso("Limite de 8 fotos por anúncio."); return; }
        estaCarregando = true;
        try
        {
            foreach (var arquivo in e.GetMultipleFiles(50).Take(vagas))
            {
                var reduzida = await arquivo.RequestImageFileAsync("image/jpeg", 1000, 1000);
                using var stream = reduzida.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                petParaEditar.Imagens.Add(new PetImagem { Base64Data = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}", PetId = petParaEditar.Id });
            }
        }
        catch { Toast.Erro("Não foi possível carregar uma das fotos (máx. 10 MB cada)."); }
        finally { estaCarregando = false; }
    }

    private async Task SalvarAlteracoes()
    {
        if (salvando) return;
        if (!petParaEditar!.Imagens.Any()) { Toast.Aviso("Deixe pelo menos uma foto no anúncio."); return; }
        // RN04: espécie trocada precisa ser doméstica; anúncio antigo pode manter a espécie original
        var mudouEspecie = petParaEditar.Especie != especieOriginal || petParaEditar.Raca != racaOriginal;
        if (mudouEspecie && EspeciesPermitidas.Validar(petParaEditar.Especie, petParaEditar.Raca) is string erroEspecie) { Toast.Aviso(erroEspecie); return; }
        // Moderação e remoção não podem ser desfeitas pelo dono do anúncio
        if (statusOriginal == EspeciesPermitidas.StatusModeracao || statusOriginal == ModeracaoService.StatusRemovido) petParaEditar.Status = statusOriginal;
        else if (mudouEspecie && EspeciesPermitidas.PrecisaModeracao(petParaEditar.Especie) && petParaEditar.Status == "Disponível")
        {
            petParaEditar.Status = EspeciesPermitidas.StatusModeracao;
            Toast.Info("Anúncios de aves passam pela moderação antes de voltar ao catálogo.");
        }
        salvando = true;
        try
        {
            petParaEditar.FotoUrl = ""; // a capa é a 1ª imagem (não duplicamos a foto no banco)
            await PetRepository.UpdateAsync(petParaEditar);
            salvo = true;
            Toast.Sucesso("Anúncio atualizado!");
            Nav.NavigateTo("/meus-pets");
        }
        catch (Exception ex) { Toast.Erro("Erro ao salvar: " + (ex.InnerException?.Message ?? ex.Message)); }
        finally { salvando = false; }
    }
}
