@page "/perfil"
@inject AuthService AuthService
@inject IUsuarioRepository UsuarioRepository
@inject DocumentoValidacaoService Validacao
@inject CofreDocumentos Cofre
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Meu perfil | Match-Pet SP</PageTitle>

@if (AuthService.UsuarioLogado is { } u)
{
    <div class="container-xl py-4 py-md-5">
        <div class="row g-4">
            @* ===== CARTÃO DO USUÁRIO ===== *@
            <div class="col-lg-4">
                <div class="mp-card p-4 text-center perfil-cartao">
                    <div class="position-relative d-inline-block mb-3">
                        <Avatar Usuario="u" Tamanho="120" />
                        <label for="uploadPerfil" title="Trocar foto" class="botao-foto">
                            <i class="bi bi-camera-fill"></i>
                            <InputFile id="uploadPerfil" OnChange="CarregarFotoPerfil" class="d-none" accept="image/jpeg,image/png,image/webp" />
                        </label>
                    </div>
                    <h2 class="h4 mb-1">@u.Nome</h2>
                    <p class="text-muted small mb-2">@u.Email</p>
                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                        <span class="tag azul">@u.Classificacao</span>
                        @if (u.EhOng) { <span class="tag verde"><i class="bi bi-building-check"></i>ONG</span> }
                    </div>
                    @if (u.FotoPerfilPendente != null || u.BioPendente != null || u.DescricaoOngPendente != null)
                    {
                        <div class="alert alert-warning small py-2 mt-3 mb-0 text-start"><i class="bi bi-hourglass-split me-1"></i>@(u.FotoPerfilPendente != null ? "Sua nova foto" : "Os textos novos do seu perfil")@(u.FotoPerfilPendente != null && (u.BioPendente != null || u.DescricaoOngPendente != null) ? " e os textos novos" : "") aguardam a aprovação da moderação.</div>
                    }

                    <div class="status-doc mt-4 @ClasseStatus(u.StatusValidacaoDocumento)">
                        <i class="bi @IconeStatus(u.StatusValidacaoDocumento)"></i>
                        <div class="text-start">
                            <b>@TituloStatus(u.StatusValidacaoDocumento)</b>
                            <small>@(u.StatusValidacaoDocumento == "Aprovado" ? "Você já pode adotar e pedir itens." : "Necessário para adotar e pedir itens.")</small>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a href="/u/@u.Id" class="btn btn-primary"><i class="bi bi-person-badge me-1"></i> Ver meu perfil público</a>
                        <a href="/meus-pets" class="btn btn-light"><i class="bi bi-collection me-1"></i> Meus anúncios</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                @* ===== VERIFICAÇÃO DO DOCUMENTO ===== *@
                <div class="mp-card p-4 p-md-5 mb-4" id="documento">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icone-bolha @(u.StatusValidacaoDocumento == "Aprovado" ? "verde" : "laranja")"><i class="bi bi-person-vcard"></i></div>
                        <div>
                            <h3 class="h5 mb-0">Verificação de identidade</h3>
                            <small class="text-muted">@(u.EhOng ? "Cartão CNPJ ou estatuto da instituição" : "RG, CNH ou outro documento oficial com foto e CPF")</small>
                        </div>
                    </div>

                    @if (analisando)
                    {
                        <div class="analise">
                            @for (var i = 0; i < Etapas.Length; i++)
                            {
                                <div class="etapa @(i < etapaAtual ? "feita" : i == etapaAtual ? "atual" : "")">
                                    @if (i < etapaAtual) { <i class="bi bi-check-circle-fill"></i> }
                                    else if (i == etapaAtual) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-circle"></i> }
                                    <span>@Etapas[i]</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(u.DocumentoObservacao) && u.StatusValidacaoDocumento != "Pendente")
                        {
                            <div class="alert @(u.StatusValidacaoDocumento switch { "Aprovado" => "alert-success", "Reprovado" => "alert-danger", _ => "alert-warning" }) small">
                                <strong>@TituloStatus(u.StatusValidacaoDocumento):</strong> @u.DocumentoObservacao
                            </div>
                        }

                        @if (u.StatusValidacaoDocumento != "Aprovado")
                        {
                            <div class="upload-area">
                                <InputFile OnChange="CarregarFotoDocumento" accept="image/jpeg,image/png,image/webp" />
                                <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>
                                <div class="fw-bold text-dark mt-1">@(u.StatusValidacaoDocumento == "Reprovado" ? "Enviar outra foto" : "Toque para enviar a foto do documento")</div>
                                <small class="text-muted">JPG ou PNG, até 10 MB</small>
                            </div>
                            <ul class="dicas small text-muted mt-3 mb-0">
                                <li>Fotografe o documento <b>inteiro</b>, sobre uma superfície lisa e com boa luz.</li>
                                <li>O <b>nome</b> e o <b>@(u.EhOng ? "CNPJ" : "CPF")</b> precisam ser iguais aos do seu cadastro.</li>
                                <li>Cada foto só pode ser usada em <b>uma conta</b>.</li>
                            </ul>
                        }
                        else
                        {
                            <p class="small text-muted mb-0"><i class="bi bi-lock-fill me-1"></i>Seu documento está guardado com segurança e não aparece para outros usuários.</p>
                        }
                    }
                </div>

                @* ===== DADOS DA CONTA ===== *@
                <div class="mp-card p-4 p-md-5">
                    <h3 class="h5 mb-4">Dados da conta</h3>
                    <EditForm Model="@u" OnValidSubmit="() => SalvarPerfil(false)">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">@(u.EhOng ? "Nome da instituição" : "Nome")</label>
                                <InputText class="form-control" @bind-Value="u.Nome" disabled="@(u.StatusValidacaoDocumento == "Aprovado")" />
                                @if (u.StatusValidacaoDocumento == "Aprovado")
                                {
                                    <div class="form-text"><i class="bi bi-lock-fill"></i> O nome fica bloqueado depois que o documento é verificado.</div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@(u.EhOng ? "CNPJ" : "CPF")</label>
                                <input class="form-control" value="@DocumentoUtil.Formatar(u.Documento)" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">WhatsApp / Telefone</label>
                                <InputText class="form-control" inputmode="tel" @bind-Value="u.Telefone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Sobre mim <span class="text-muted fw-normal">(aparece no seu perfil público)</span></label>
                                <InputTextArea class="form-control" rows="3" maxlength="600" @bind-Value="u.Bio" placeholder="Conte um pouco sobre você e seus pets..." />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Endereço</label>
                                <InputText class="form-control" @bind-Value="u.Logradouro" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cidade</label>
                                <InputText class="form-control" @bind-Value="u.Cidade" />
                            </div>

                            @if (u.EhOng)
                            {
                                <div class="col-12">
                                    <label class="form-label">Sobre a instituição</label>
                                    <InputTextArea class="form-control" rows="3" @bind-Value="u.DescricaoOng" placeholder="História, missão e como as pessoas podem ajudar..." />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Chave Pix para doações</label>
                                    <InputText class="form-control" @bind-Value="u.ChavePix" placeholder="CNPJ, e-mail, telefone ou chave aleatória" />
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary px-4" disabled="@salvando"><i class="bi bi-check2 me-1"></i> @(salvando ? "Salvando..." : "Salvar alterações")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .botao-foto { position: absolute; bottom: 2px; right: 2px; width: 38px; height: 38px; border-radius: 50%; background: var(--mp-primary); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 3px solid #fff; box-shadow: var(--mp-shadow-sm); }
    .status-doc { display: flex; align-items: center; gap: .8rem; padding: .9rem 1rem; border-radius: 16px; }
    .status-doc i { font-size: 1.6rem; }
    .status-doc b { display: block; font-size: .95rem; }
    .status-doc small { font-size: .8rem; opacity: .85; }
    .status-doc.ok { background: var(--mp-success-soft); color: #166534; }
    .status-doc.analise { background: var(--mp-warning-soft); color: #92400e; }
    .status-doc.erro { background: var(--mp-danger-soft); color: #991b1b; }
    .status-doc.pendente { background: #f1f5f9; color: var(--mp-text); }
    .analise { background: #f8fafc; border-radius: 16px; padding: 1.25rem; }
    .etapa { display: flex; align-items: center; gap: .7rem; padding: .45rem 0; color: #94a3b8; font-weight: 600; }
    .etapa.feita { color: var(--mp-success); }
    .etapa.atual { color: var(--mp-primary); }
    .dicas li { margin-bottom: .25rem; }
    @@media (min-width: 992px) { .perfil-cartao { position: sticky; top: 88px; } }
</style>

@code {
    private bool analisando, salvando;
    private int etapaAtual;

    private static readonly string[] Etapas =
    {
        "Recebendo a foto",
        "Conferindo se a foto já foi usada em outra conta",
        "Lendo nome e número do documento",
        "Comparando com os dados do cadastro"
    };

    protected override void OnInitialized()
    {
        if (!AuthService.EstaLogado) Nav.NavigateTo("/login?voltar=/perfil");
    }

    private static string ClasseStatus(string s) => s switch { "Aprovado" => "ok", "Em Análise" or "Em Analise" => "analise", "Reprovado" => "erro", _ => "pendente" };
    private static string IconeStatus(string s) => s switch { "Aprovado" => "bi-patch-check-fill", "Em Análise" or "Em Analise" => "bi-hourglass-split", "Reprovado" => "bi-x-octagon-fill", _ => "bi-shield-exclamation" };
    private static string TituloStatus(string s) => s switch { "Aprovado" => "Identidade verificada", "Em Análise" or "Em Analise" => "Documento em análise", "Reprovado" => "Documento recusado", _ => "Documento pendente" };

    // Reduz a imagem no navegador antes de enviar (evita arquivos enormes)
    private static async Task<(byte[] bytes, string tipo)> LerImagem(IBrowserFile arquivo, int tamanhoMax)
    {
        if (!arquivo.ContentType.StartsWith("image/"))
            throw new InvalidOperationException("Envie um arquivo de imagem (JPG ou PNG).");
        var tipo = arquivo.ContentType == "image/png" ? "image/png" : "image/jpeg";
        var reduzida = await arquivo.RequestImageFileAsync(tipo, tamanhoMax, tamanhoMax);
        using var stream = reduzida.OpenReadStream(10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return (ms.ToArray(), tipo);
    }

    private async Task CarregarFotoPerfil(InputFileChangeEventArgs e)
    {
        try
        {
            var (bytes, tipo) = await LerImagem(e.File, 400);
            var foto = $"data:{tipo};base64,{Convert.ToBase64String(bytes)}";
            var eu = AuthService.UsuarioLogado!;
            if (eu.ContaDemonstracao) { await SalvarPerfil(silencioso: true); return; }
            // A foto nova fica aguardando a aprovação da moderação (administradores trocam na hora)
            if (Consultas.PublicaDireto(eu)) eu.FotoPerfilBase64 = foto; else eu.FotoPerfilPendente = foto;
            await SalvarPerfil(silencioso: true);
            if (Consultas.PublicaDireto(eu)) Toast.Sucesso("Foto atualizada!");
            else Toast.Info("Foto enviada! Ela aparece no seu perfil depois que a moderação aprovar. 🛡️");
        }
        catch (Exception ex)
        {
            Toast.Erro("Não foi possível carregar a foto: " + ex.Message);
        }
    }

    private async Task CarregarFotoDocumento(InputFileChangeEventArgs e)
    {
        var usuario = AuthService.UsuarioLogado!;
        byte[] bytes;
        string tipo;
        try
        {
            (bytes, tipo) = await LerImagem(e.File, 1600);
        }
        catch (Exception ex)
        {
            Toast.Erro("Não foi possível ler o documento: " + ex.Message);
            return;
        }

        analisando = true;
        etapaAtual = 0;
        StateHasChanged();

        try
        {
            await Task.Delay(400);
            etapaAtual = 1; StateHasChanged();

            // A validação real roda enquanto as etapas avançam na tela
            var tarefa = Validacao.ValidarAsync(usuario, bytes, tipo);
            await Task.Delay(500);
            etapaAtual = 2; StateHasChanged();
            var resultado = await tarefa;
            etapaAtual = 3; StateHasChanged();
            await Task.Delay(400);

            usuario.DocumentoHash = resultado.Hash;
            usuario.StatusValidacaoDocumento = resultado.Status;
            usuario.DocumentoObservacao = resultado.Observacao;
            usuario.DataValidacaoDocumento = DateTime.UtcNow;
            // LGPD: a foto só fica guardada (criptografada) enquanto espera a conferência manual.
            // Aprovada ou recusada, a imagem é descartada e fica apenas o hash, para barrar a mesma foto em outra conta.
            usuario.FotoDocumentoBase64 = resultado.Status == "Em Análise" ? Cofre.Fechar(bytes, tipo) : null;

            await SalvarPerfil(silencioso: true);

            switch (resultado.Status)
            {
                case "Aprovado": Toast.Sucesso("Identidade verificada! Agora você pode adotar."); break;
                case "Reprovado": Toast.Erro("Documento recusado. Veja o motivo e envie outra foto."); break;
                default: Toast.Aviso("Documento recebido e em análise."); break;
            }
        }
        catch (Exception ex)
        {
            Toast.Erro("Erro ao validar o documento: " + ex.Message);
        }
        finally
        {
            analisando = false;
        }
    }

    private async Task SalvarPerfil(bool silencioso = false)
    {
        // Conta do QR Code da banca: usada por várias pessoas ao mesmo tempo, então ninguém altera os dados dela
        if (AuthService.UsuarioLogado?.ContaDemonstracao == true)
        {
            Toast.Info("Esta é a conta de demonstração da banca: as alterações do perfil não são salvas. 😉");
            return;
        }
        salvando = true;
        try
        {
            var u = AuthService.UsuarioLogado!;
            var bioDigitada = u.Bio;
            var descricaoDigitada = u.DescricaoOng;
            // O administrador pode ter aprovado o documento ou bloqueado a conta enquanto esta tela estava aberta
            if (!silencioso) await UsuarioRepository.SincronizarModeracaoAsync(u);

            // Textos públicos novos ("Sobre mim" e descrição da ONG) só aparecem depois da aprovação da moderação
            var emAprovacao = false;
            if (!silencioso)
            {
                var direto = Consultas.PublicaDireto(u);
                (string? publico, string? pendente) Moderar(string? digitado, string? publicado, string? pendenteAtual)
                {
                    var novo = string.IsNullOrWhiteSpace(digitado) ? null : digitado.Trim();
                    if (direto) return (novo, null);
                    if (novo == null) return (null, null);                               // apagar o texto não precisa de aprovação
                    if (novo == (publicado ?? "").Trim()) return (publicado, pendenteAtual); // não mudou
                    emAprovacao = true;
                    return (publicado, novo);
                }
                (u.Bio, u.BioPendente) = Moderar(bioDigitada, u.Bio, u.BioPendente);
                if (u.EhOng) (u.DescricaoOng, u.DescricaoOngPendente) = Moderar(descricaoDigitada, u.DescricaoOng, u.DescricaoOngPendente);
            }
            u.DataUltimaAlteracao = DateTime.UtcNow;
            AuthService.AtualizarClassificacao(u);
            await UsuarioRepository.UpdateAsync(u);
            AuthService.NotifyStateChanged();
            if (emAprovacao) Toast.Info("Perfil salvo! Os textos novos aparecem no seu perfil público depois que a moderação aprovar. 🛡️");
            else if (!silencioso) Toast.Sucesso("Perfil atualizado!");
        }
        catch (Exception ex)
        {
            Toast.Erro("Erro ao salvar o perfil: " + (ex.InnerException?.Message ?? ex.Message));
        }
        finally { salvando = false; }
    }
}
