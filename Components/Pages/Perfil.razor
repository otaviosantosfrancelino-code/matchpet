@page "/perfil"
@using crudcomdb.Models
@using crudcomdb.Interfaces
@using crudcomdb.Services
@inject AuthService AuthService
@inject IUsuarioRepository UsuarioRepository
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container py-5 mt-4">
    @if (AuthService.UsuarioLogado != null)
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-portal p-4 text-center border shadow-sm rounded-4 bg-white">
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(AuthService.UsuarioLogado.FotoPerfilBase64))
                        {
                            <img src="@AuthService.UsuarioLogado.FotoPerfilBase64" class="rounded-circle shadow border border-4 border-white" style="width: 150px; height: 150px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold display-4 shadow border border-4 border-white mx-auto" style="width: 150px; height: 150px;">
                                @AuthService.UsuarioLogado.Nome.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <label for="uploadPerfil" class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle p-2 shadow-sm" style="cursor: pointer; width: 40px; height: 40px;">
                            <i class="bi bi-camera-fill"></i>
                            <InputFile id="uploadPerfil" OnChange="CarregarFotoPerfil" class="d-none" accept=".jpg,.jpeg,.png" />
                        </label>
                    </div>
                    
                    <h4 class="fw-bold mb-0">@AuthService.UsuarioLogado.Nome</h4>
                    <span class="badge rounded-pill bg-warning text-dark mt-2 px-3 fw-bold">@AuthService.UsuarioLogado.Classificacao</span>
                    
                    @if (AuthService.UsuarioLogado.EhOng)
                    {
                        <span class="badge rounded-pill bg-success text-white mt-1 px-3 fw-bold"><i class="bi bi-building-check me-1"></i> Instituição Oficial</span>
                    }
                    
                    <div class="alert @(AuthService.UsuarioLogado.StatusValidacaoDocumento == "Aprovado" ? "alert-success" : "alert-danger") mt-4 border-0 small shadow-sm">
                        <i class="bi @(AuthService.UsuarioLogado.StatusValidacaoDocumento == "Aprovado" ? "bi-shield-fill-check fs-5" : "bi-shield-slash fs-5") me-2"></i>
                        <strong class="d-block mt-1">
                            @(AuthService.UsuarioLogado.StatusValidacaoDocumento == "Aprovado" ? "Identidade Verificada (IA)" : "Documento Pendente")
                        </strong>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card-portal p-4 p-md-5 border shadow-sm rounded-4 bg-white">
                    <h5 class="fw-bold mb-4 text-primary border-bottom pb-2">Gerenciar Dados da Conta</h5>
                    <EditForm Model="@AuthService.UsuarioLogado" OnValidSubmit="() => SalvarPerfil(false)">
                        <div class="row g-3">
                            <!-- NOME VISÍVEL PARA OUTROS USUÁRIOS -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Nome / Razão Social Visível no Site</label>
                                <InputText class="form-control fw-bold" @bind-Value="AuthService.UsuarioLogado.Nome" />
                                <div class="form-text small">Este é o nome que aparecerá nos animais publicados e no catálogo de ONGs.</div>
                            </div>

                            <div class="col-md-6 mt-3">
                                <label class="form-label small fw-bold text-muted">WhatsApp / Telefone</label>
                                <InputText class="form-control" @bind-Value="AuthService.UsuarioLogado.Telefone" />
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="form-label small fw-bold text-muted">Cidade</label>
                                <InputText class="form-control" @bind-Value="AuthService.UsuarioLogado.Cidade" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Endereço Residencial / Sede</label>
                                <InputText class="form-control" @bind-Value="AuthService.UsuarioLogado.Logradouro" />
                            </div>

                            <!-- PAINEL EXCLUSIVO PARA EDITAR PERFIL DE ONG -->
                            @if (AuthService.UsuarioLogado.EhOng)
                            {
                                <div class="col-12 mt-4">
                                    <div class="p-4 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25 shadow-sm">
                                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-building-fill-gear me-2"></i> Painel de Configuração da Instituição (ONG)</h6>
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold text-muted">Sobre a Instituição / Descrição Institucional</label>
                                            <InputTextArea class="form-control bg-white" @bind-Value="AuthService.UsuarioLogado.DescricaoOng" rows="3" placeholder="Fale um pouco sobre a história da ONG, missão e como os adotantes podem ajudar..." />
                                        </div>

                                        <div>
                                            <label class="form-label small fw-bold text-muted">Chave Pix Oficial para Doações</label>
                                            <InputText class="form-control bg-white" @bind-Value="AuthService.UsuarioLogado.ChavePix" placeholder="CNPJ, E-mail, Telefone ou Chave Aleatória Pix" />
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- AUDITORIA DE DOCUMENTO -->
                            <div class="col-12 mt-4">
                                <div class="p-4 rounded-4 border bg-light text-center" style="border-style: dashed !important; border-width: 2px !important;">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-file-earmark-person-fill text-primary me-2 fs-4"></i>Documento Oficial (CPF / CNH / Estatuto)</h6>
                                    <p class="small text-muted mb-3">Necessário para validação de segurança e assinatura de termos.</p>
                                    
                                    @if (AuthService.UsuarioLogado.StatusValidacaoDocumento != "Aprovado" && !analisandoDocumento)
                                    {
                                        <InputFile OnChange="CarregarFotoDocumento" class="form-control form-control-sm mx-auto" style="max-width: 350px;" accept=".jpg,.jpeg,.png" />
                                    }
                                    
                                    @if (analisandoDocumento)
                                    {
                                        <div class="mt-4 p-3 bg-white rounded-3 shadow-sm border mx-auto" style="max-width: 400px;">
                                            <div class="text-primary fw-bold mb-2">
                                                <i class="bi bi-cpu-fill me-2 fs-5"></i> @mensagemAnalise
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary w-100"></div>
                                            </div>
                                        </div>
                                    }
                                    else if (AuthService.UsuarioLogado.StatusValidacaoDocumento == "Aprovado")
                                    {
                                        <div class="mt-3 text-success p-3 bg-success bg-opacity-10 rounded-3 border border-success mx-auto" style="max-width: 400px;">
                                            <i class="bi bi-patch-check-fill fs-3 d-block mb-2"></i> 
                                            <strong class="d-block">Documento Validado com Sucesso!</strong>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold shadow" disabled="@analisandoDocumento">
                                <i class="bi bi-save me-2"></i> Salvar Alterações
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool analisandoDocumento = false;
    private string mensagemAnalise = "";

    private async Task CarregarFotoPerfil(InputFileChangeEventArgs e)
    {
        var resized = await e.File.RequestImageFileAsync(e.File.ContentType, 400, 400);
        using var stream = resized.OpenReadStream(2 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        AuthService.UsuarioLogado!.FotoPerfilBase64 = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();
    }

    private async Task CarregarFotoDocumento(InputFileChangeEventArgs e)
    {
        var buffer = new byte[e.File.Size];
        await e.File.OpenReadStream(3 * 1024 * 1024).ReadAsync(buffer);
        var base64 = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";

        analisandoDocumento = true;
        AuthService.UsuarioLogado!.StatusValidacaoDocumento = "Em Analise";
        
        mensagemAnalise = "Digitalizando documento enviado...";
        StateHasChanged();
        await Task.Delay(1500);

        mensagemAnalise = "Mapeando dados via OCR e extraindo registros...";
        StateHasChanged();
        await Task.Delay(2000);

        AuthService.UsuarioLogado!.FotoDocumentoBase64 = base64;
        AuthService.UsuarioLogado!.StatusValidacaoDocumento = "Aprovado";
        AuthService.UsuarioLogado!.DataValidacaoDocumento = DateTime.UtcNow;
        analisandoDocumento = false;
        
        await SalvarPerfil(silencioso: true);
    }

    private async Task SalvarPerfil(bool silencioso = false)
    {
        AuthService.UsuarioLogado!.DataUltimaAlteracao = DateTime.UtcNow;
        AuthService.AtualizarClassificacao(AuthService.UsuarioLogado!);
        await UsuarioRepository.UpdateAsync(AuthService.UsuarioLogado!);
        AuthService.NotifyStateChanged();
        
        if (!silencioso)
        {
            await JS.InvokeVoidAsync("alert", "Sucesso! Perfil atualizado.");
        }
    }
}