@page "/meus-pets"
@inject IPetRepository PetRepository
@inject IItemRepository ItemRepository
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ToastService Toast
@inject RankingService Ranking
@inject FavoritosService Favoritos

<PageTitle>Meus anúncios | Match-Pet SP</PageTitle>

<div class="container-xl py-4 py-md-5">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3">
            <div class="icone-bolha azul"><i class="bi bi-collection"></i></div>
            <div>
                <h1>Meus anúncios</h1>
                <p>Gerencie os pets e itens que você publicou.</p>
            </div>
        </div>
        <a href="/pets/novo" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i> Novo anúncio</a>
    </div>

    <div class="segmentos mb-4">
        <button class="@(abaAtiva == "pets" ? "ativo" : "")" @onclick='() => abaAtiva = "pets"'>🐾 Pets (@(meusPets?.Count() ?? 0))</button>
        <button class="@(abaAtiva == "itens" ? "ativo" : "")" @onclick='() => abaAtiva = "itens"'>🎁 Itens (@(meusItens?.Count ?? 0))</button>
    </div>

    @if (abaAtiva == "pets")
    {
        @if (meusPets == null)
        {
            <CardsCarregando Quantidade="3" Colunas="col-md-6 col-lg-4" />
        }
        else if (!meusPets.Any())
        {
            <div class="estado-vazio"><div class="emoji">🐶</div><h5>Você ainda não anunciou nenhum pet</h5><a href="/pets/novo" class="btn btn-primary mt-2">Anunciar um pet</a></div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var pet in meusPets)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="mp-card overflow-hidden h-100 d-flex flex-column">
                            <div class="position-relative overflow-hidden" style="aspect-ratio: 16/10;">
                                @if (pet.Imagens.Any()) { <img src="@Url.Pet(pet.Imagens.First())" class="img-cover" alt="Foto de @pet.Nome" loading="lazy" /> }
                                else { <div class="foto-vazia"><i class="bi bi-camera fs-2"></i></div> }
                                <span class="badge position-absolute top-0 start-0 m-2 @CorStatus(pet.Status)">@pet.Status</span>
                            </div>
                            <div class="p-3 d-flex flex-column gap-2 flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <h3 class="h5 mb-0 text-truncate">@pet.Nome</h3>
                                        <small class="text-muted">@pet.Especie · @pet.Porte</small>
                                    </div>
                                    <div class="d-flex gap-1 flex-shrink-0">
                                        <a href="/pets/detalhes/@pet.Id" class="btn btn-light btn-icon" title="Ver anúncio" aria-label="Ver anúncio de @pet.Nome"><i class="bi bi-eye"></i></a>
                                        <a href="/pets/editar/@pet.Id" class="btn btn-light btn-icon" title="Editar" aria-label="Editar @pet.Nome"><i class="bi bi-pencil"></i></a>
                                        <button class="btn btn-light btn-icon text-danger" title="Excluir" aria-label="Excluir @pet.Nome" @onclick="() => confirmacao = new(pet.Id, pet.Nome, true, false)"><i class="bi bi-trash"></i></button>
                                    </div>
                                </div>
                                @if (pet.Status == "Em Processo")
                                {
                                    <div class="small text-primary fw-semibold"><i class="bi bi-hourglass-split me-1"></i>Alguém assinou o termo. Combine a visita!</div>
                                }
                                @if (pet.Status == EspeciesPermitidas.StatusModeracao)
                                {
                                    <div class="small text-info fw-semibold"><i class="bi bi-feather me-1"></i>Aguardando a moderação conferir a espécie da ave.</div>
                                }
                                else if (pet.Status == ModeracaoService.StatusRemovido)
                                {
                                    <div class="small text-danger fw-semibold"><i class="bi bi-shield-exclamation me-1"></i>Removido pela moderação por violar os Termos de Uso.</div>
                                }
                                @if (favoritosPorPet.GetValueOrDefault(pet.Id) is int fav && fav > 0)
                                {
                                    <div class="small text-muted"><i class="bi bi-heart-fill text-danger me-1"></i>@fav @(fav == 1 ? "pessoa favoritou" : "pessoas favoritaram")</div>
                                }
                                @if (pet.Status is "Disponível" or "Em Processo")
                                {
                                    <div class="d-flex gap-2 mt-auto">
                                        <button class="btn btn-accent btn-sm flex-grow-1" @onclick="() => confirmacao = new(pet.Id, pet.Nome, true, true)"><i class="bi bi-heart-fill me-1"></i> Foi adotado!</button>
                                        @if (pet.Status == "Em Processo")
                                        {
                                            <button class="btn btn-light btn-sm" title="Voltar a ficar disponível" @onclick='() => MudarStatusPet(pet, "Disponível")'>Reabrir</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (meusItens == null)
        {
            <CardsCarregando Quantidade="3" Colunas="col-md-6 col-lg-4" />
        }
        else if (!meusItens.Any())
        {
            <div class="estado-vazio"><div class="emoji">🎁</div><h5>Você ainda não doou itens</h5><a href="/pets/novo?tipo=item" class="btn btn-accent mt-2">Doar um item</a></div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var item in meusItens)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="mp-card overflow-hidden h-100 d-flex">
                            <div class="flex-shrink-0" style="width: 120px; min-height: 140px;">
                                @if (item.Imagens.Any()) { <img src="@Url.Item(item.Imagens.First())" class="img-cover" alt="Foto de @item.Nome" loading="lazy" /> }
                                else { <div class="foto-vazia"><i class="bi bi-box"></i></div> }
                            </div>
                            <div class="p-3 d-flex flex-column gap-2 flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between gap-2">
                                    <h3 class="h6 mb-0 text-truncate" title="@item.Nome">@item.Nome</h3>
                                    <span class="badge flex-shrink-0 @(item.Status == "Disponível" ? "bg-success" : "bg-secondary")">@item.Status</span>
                                </div>
                                <small class="text-muted">@item.Categoria · Para: @item.EspecieDestino</small>
                                <div class="d-flex gap-1 mt-auto">
                                    @if (item.Status == "Disponível")
                                    {
                                        <button class="btn btn-success btn-sm flex-grow-1" @onclick="() => MarcarItemDoado(item)"><i class="bi bi-check2 me-1"></i>Doado</button>
                                    }
                                    <a href="/itens/editar/@item.Id" class="btn btn-light btn-icon" title="Editar" aria-label="Editar @item.Nome"><i class="bi bi-pencil"></i></a>
                                    <button class="btn btn-light btn-icon text-danger" title="Excluir" aria-label="Excluir @item.Nome" @onclick="() => confirmacao = new(item.Id, item.Nome, false, false)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* Janela de confirmação (substitui o "confirm" do navegador) *@
@if (confirmacao is { } c)
{
    <div class="modal fade show d-block modal-blazor" tabindex="-1" role="dialog" aria-modal="true" @onclick="() => confirmacao = null">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content p-4 text-center">
                <div class="display-5 mb-2">@(c.Adocao ? "💛" : "🗑️")</div>
                <h5>@(c.Adocao ? $"{c.Nome} encontrou um lar?" : $"Excluir \"{c.Nome}\"?")</h5>
                <p class="text-muted small">@(c.Adocao ? "O anúncio sai do catálogo e vai para a galeria Final Feliz." : "Esta ação não pode ser desfeita.")</p>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-light flex-fill" @onclick="() => confirmacao = null">Cancelar</button>
                    <button class="btn flex-fill @(c.Adocao ? "btn-accent" : "btn-danger")" @onclick="Confirmar" disabled="@processando">
                        @(c.Adocao ? "Sim, foi adotado!" : "Excluir")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaQuery { get; set; }

    private string abaAtiva = "pets";
    private IEnumerable<Pet>? meusPets;
    private List<ItemDoacao>? meusItens;
    private bool processando;

    private record Confirmacao(int Id, string Nome, bool EhPet, bool Adocao);
    private Confirmacao? confirmacao;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaLogado) { Nav.NavigateTo("/login?voltar=/meus-pets"); return; }
        if (AbaQuery == "itens") abaAtiva = "itens";
        await CarregarDados();
    }

    private Dictionary<int, int> favoritosPorPet = new();

    private async Task CarregarDados()
    {
        var id = AuthService.UsuarioLogado!.Id;
        meusPets = await PetRepository.GetByUserIdAsync(id);
        try { favoritosPorPet = await Favoritos.ContarPorPetAsync(meusPets.Select(p => p.Id)); } catch { }
        meusItens = await ItemRepository.GetByUserIdAsync(id);
    }

    // Doações contam pontos no ranking (em segundo plano)
    private void VerificarRanking()
    {
        var id = AuthService.UsuarioLogado!.Id;
        _ = Task.Run(async () => { try { await Ranking.VerificarAsync(id); } catch { } });
    }

    private static string CorStatus(string s) => s switch { "Disponível" => "bg-success", "Em Processo" => "bg-primary", "Em Moderação" => "bg-info text-dark", "Removido" => "bg-danger", _ => "bg-warning" };

    private async Task MudarStatusPet(Pet pet, string status)
    {
        await PetRepository.AtualizarStatusAsync(pet.Id, status);
        Toast.Sucesso(status == "Disponível" ? $"{pet.Nome} voltou para o catálogo." : $"Que notícia boa! {pet.Nome} está na galeria Final Feliz. 💛");
        await CarregarDados();
    }

    private async Task MarcarItemDoado(ItemDoacao item)
    {
        await ItemRepository.AtualizarStatusAsync(item.Id, "Doado");
        Toast.Sucesso("Obrigado por ajudar! Item marcado como doado.");
        VerificarRanking();
        await CarregarDados();
    }

    private async Task Confirmar()
    {
        if (confirmacao is not { } c || processando) return;
        processando = true;
        try
        {
            if (c.Adocao)
            {
                await PetRepository.AtualizarStatusAsync(c.Id, "Adotado");
                Toast.Sucesso($"Que notícia boa! {c.Nome} está na galeria Final Feliz. 💛");
                VerificarRanking();
            }
            else if (c.EhPet)
            {
                await PetRepository.DeleteAsync(c.Id);
                Toast.Info($"Anúncio de {c.Nome} excluído.");
            }
            else
            {
                await ItemRepository.DeleteAsync(c.Id);
                Toast.Info($"Item \"{c.Nome}\" excluído.");
            }
            confirmacao = null;
            await CarregarDados();
        }
        catch (Exception ex) { Toast.Erro("Não foi possível concluir: " + (ex.InnerException?.Message ?? ex.Message)); }
        finally { processando = false; }
    }
}
