@page "/meus-pets"
@using crudcomdb.Interfaces
@using crudcomdb.Models
@using crudcomdb.Services
@using crudcomdb.Data
@using Microsoft.EntityFrameworkCore
@inject IPetRepository PetRepository
@inject AppDbContext Db
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container py-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-dark m-0">Meus Anúncios e Doações</h2>
            <p class="text-muted m-0">Gerencie os pets e suprimentos que você publicou em Franca.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="IrParaNovoAnuncio">
            <i class="bi bi-plus-lg me-2"></i>Novo Anúncio
        </button>
    </div>

    <!-- ABAS DE NAVEGAÇÃO INTERNA (PETS VS ITENS) -->
    <div class="d-flex gap-2 mb-4 border-bottom pb-3">
        <button class="btn rounded-pill px-4 fw-bold @(abaAtiva == "pets" ? "btn-primary shadow-sm" : "btn-light text-muted")" @onclick="MudarParaPets">
            <i class="bi bi-heart-fill me-2"></i> Meus Animais (@(meusPets?.Count() ?? 0))
        </button>
        <button class="btn rounded-pill px-4 fw-bold @(abaAtiva == "itens" ? "btn-warning text-dark shadow-sm" : "btn-light text-muted")" @onclick="MudarParaItens">
            <i class="bi bi-box-seam-fill me-2"></i> Meus Itens/Rações (@(meusItens?.Count() ?? 0))
        </button>
    </div>

    @if (abaAtiva == "pets")
    {
        @if (meusPets == null)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (!meusPets.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm p-4">
                <i class="bi bi-patch-question fs-1 text-muted"></i>
                <h5 class="mt-3">Nenhum animal sob sua responsabilidade.</h5>
                <button class="btn btn-link fw-bold" @onclick="IrParaNovoAnuncio">Cadastrar pet agora</button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var pet in meusPets)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-portal border h-100 d-flex flex-row overflow-hidden shadow-sm rounded-4 bg-white">
                            <div style="width: 130px; min-height: 140px;">
                                @if (pet.Imagens != null && pet.Imagens.Any())
                                {
                                    <img src="@pet.Imagens.First().Base64Data" class="w-100 h-100" style="object-fit: cover;">
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted"><i class="bi bi-camera"></i></div>
                                }
                            </div>
                            <div class="p-3 flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="fw-bold mb-1 text-dark">@pet.Nome</h5>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary px-2" title="Editar" @onclick="() => EditarPet(pet.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger px-2" title="Excluir" @onclick="() => ExcluirPet(pet)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <span class="badge @(pet.Status == "Disponível" ? "bg-success" : "bg-warning text-dark") mb-2">@pet.Status</span>
                                    <p class="small text-muted mb-2">@pet.Especie • @pet.Porte</p>
                                </div>
                                
                                @if (pet.Status == "Disponível")
                                {
                                    <button class="btn btn-sm btn-warning w-100 fw-bold rounded-pill text-dark" @onclick="() => MarcarAdotado(pet)">
                                        <i class="bi bi-heart-fill me-1"></i> Finalizar Adoção
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (meusItens == null)
        {
            <div class="text-center py-5"><div class="spinner-border text-warning"></div></div>
        }
        else if (!meusItens.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm p-4">
                <i class="bi bi-box2 fs-1 text-muted"></i>
                <h5 class="mt-3">Você ainda não cadastrou itens ou rações para doação.</h5>
                <button class="btn btn-link fw-bold text-warning" @onclick="IrParaNovoAnuncio">Cadastrar item agora</button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in meusItens)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card-portal border h-100 d-flex flex-row overflow-hidden shadow-sm rounded-4 bg-white">
                            <div style="width: 130px; min-height: 140px;">
                                @if (item.Imagens != null && item.Imagens.Any())
                                {
                                    <img src="@item.Imagens.First().Base64Data" class="w-100 h-100" style="object-fit: cover;">
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted"><i class="bi bi-box"></i></div>
                                }
                            </div>
                            <div class="p-3 flex-grow-1 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="fw-bold mb-1 text-dark text-truncate" style="max-width: 140px;" title="@item.Nome">@item.Nome</h6>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-warning px-2 text-dark" title="Editar Item" @onclick="() => EditarItem(item.Id)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger px-2" title="Excluir Item" @onclick="() => ExcluirItem(item)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <span class="badge @(item.Status == "Disponível" ? "bg-info text-dark" : "bg-secondary") mb-1">@item.Status</span>
                                    <p class="small text-muted mb-2">@item.Categoria • Para: @item.EspecieDestino</p>
                                </div>
                                
                                <div class="d-flex gap-2">
                                    @if (item.Status == "Disponível")
                                    {
                                        <button class="btn btn-sm btn-outline-success w-100 fw-bold rounded-pill py-1" @onclick="() => MarcarItemDoado(item)">
                                            <i class="bi bi-check2-circle me-1"></i> Doado
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private string abaAtiva = "pets";
    private IEnumerable<Pet>? meusPets;
    private List<ItemDoacao>? meusItens;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaLogado || AuthService.UsuarioLogado == null) 
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        if (AuthService.UsuarioLogado == null) return;
        
        var usuarioId = AuthService.UsuarioLogado.Id;
        meusPets = await PetRepository.GetByUserIdAsync(usuarioId);
        meusItens = await Db.ItensDoacao
            .Include(i => i.Imagens)
            .Where(i => i.UsuarioDoadorId == usuarioId)
            .ToListAsync();
    }

    private void IrParaNovoAnuncio() => Nav.NavigateTo("/pets/novo");
    private void MudarParaPets() => abaAtiva = "pets";
    private void MudarParaItens() => abaAtiva = "itens";
    
    private void EditarPet(int id) => Nav.NavigateTo($"/pets/editar/{id}");
    private void EditarItem(int id) => Nav.NavigateTo($"/itens/editar/{id}");

    private async Task MarcarAdotado(Pet pet)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"Confirmar que {pet.Nome} encontrou um novo lar?");
        if (confirmar)
        {
            pet.Status = "Adotado";
            await PetRepository.UpdateAsync(pet);
            await CarregarDados();
        }
    }

    private async Task ExcluirPet(Pet pet)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"Tem certeza que deseja excluir permanentemente o anúncio de {pet.Nome}?");
        if (confirmar) 
        { 
            await PetRepository.DeleteAsync(pet.Id); 
            await CarregarDados(); 
        }
    }

    private async Task MarcarItemDoado(ItemDoacao item)
    {
        item.Status = "Doado";
        Db.ItensDoacao.Update(item);
        await Db.SaveChangesAsync();
        await CarregarDados();
    }

    private async Task ExcluirItem(ItemDoacao item)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"Tem certeza que deseja excluir o item '{item.Nome}'?");
        if (confirmar)
        {
            Db.ItensDoacao.Remove(item);
            await Db.SaveChangesAsync();
            await CarregarDados();
        }
    }
}