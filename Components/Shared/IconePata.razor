@* Ícone de patinha (usado no lugar do coração para "curtir") *@
<svg class="icone-pata @(Cheia ? "cheia" : "")" viewBox="0 0 24 24" width="@Tamanho" height="@Tamanho" aria-hidden="true">
    @if (Cheia)
    {
        <g fill="currentColor">
            <ellipse cx="6" cy="10" rx="2.2" ry="2.8" />
            <ellipse cx="10" cy="6.2" rx="2.2" ry="2.9" />
            <ellipse cx="14.2" cy="6.2" rx="2.2" ry="2.9" />
            <ellipse cx="18.2" cy="10" rx="2.2" ry="2.8" />
            <path d="M12.1 11.2c-3 0-6.3 3.6-6.3 6.3 0 1.9 1.4 2.9 3.1 2.9 1.3 0 2.1-.6 3.2-.6s1.9.6 3.2.6c1.7 0 3.1-1 3.1-2.9 0-2.7-3.3-6.3-6.3-6.3z" />
        </g>
    }
    else
    {
        <g fill="none" stroke="currentColor" stroke-width="1.6">
            <ellipse cx="6" cy="10" rx="2.1" ry="2.7" />
            <ellipse cx="10" cy="6.2" rx="2.1" ry="2.8" />
            <ellipse cx="14.2" cy="6.2" rx="2.1" ry="2.8" />
            <ellipse cx="18.2" cy="10" rx="2.1" ry="2.7" />
            <path d="M12.1 11.4c-2.9 0-6 3.5-6 6.1 0 1.8 1.3 2.7 2.9 2.7 1.3 0 2-.6 3.1-.6s1.8.6 3.1.6c1.6 0 2.9-.9 2.9-2.7 0-2.6-3.1-6.1-6-6.1z" stroke-linejoin="round" />
        </g>
    }
</svg>

@code {
    [Parameter] public bool Cheia { get; set; }
    [Parameter] public int Tamanho { get; set; } = 20;
}
