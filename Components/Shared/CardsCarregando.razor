@* "Esqueleto" dos cards enquanto os dados carregam (mais agradável que um spinner) *@
<div class="row g-3 g-md-4" aria-busy="true" aria-label="Carregando">
    @for (var i = 0; i < Quantidade; i++)
    {
        <div class="@Colunas">
            <div class="mp-card overflow-hidden">
                <div class="skeleton" style="aspect-ratio: 4/3; border-radius: 0;"></div>
                <div class="p-3">
                    <div class="skeleton mb-2" style="height: 20px; width: 60%;"></div>
                    <div class="skeleton mb-3" style="height: 14px; width: 80%;"></div>
                    <div class="skeleton" style="height: 34px;"></div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Quantidade { get; set; } = 8;
    [Parameter] public string Colunas { get; set; } = "col-12 col-sm-6 col-md-4 col-lg-3";
}
